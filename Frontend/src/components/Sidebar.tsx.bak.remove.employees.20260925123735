// src/components/Sidebar.tsx
// IEM Virunga sidebar (Admin / Teacher / Student)
// NOTE: inline styles only, no Tailwind, so it renders even if CSS pipeline breaks.

import { useMemo, useState } from 'react';
import { NavLink, useNavigate, Outlet } from 'react-router';
import { useAuth } from '@/context/AuthContext';
import {
  LayoutDashboard, Users, FileText, LogOut, Building2, Briefcase,
  GraduationCap, BookOpen, NotebookPen, PenSquare, Megaphone,
  CreditCard, FileBarChart, Settings, ChevronLeft, ChevronRight,
  Library, Layers, Home, CalendarCheck, BarChart3,
  Plus, Send, CheckCircle2,
} from 'lucide-react';

// THEME
const T = {
  bg:          '#0B1B3A',
  bgGradient:  'linear-gradient(180deg, #0F2547 0%, #0A1730 100%)',
  activeBg:    '#FFFFFF',
  activeText:  '#0B1B3A',
  idleText:    'rgba(255,255,255,0.72)',
  hoverBg:     'rgba(255,255,255,0.07)',
  sectionText: 'rgba(255,255,255,0.38)',
  divider:     'rgba(255,255,255,0.08)',
};

const COLLAPSED_KEY = 'abc_sidebar_collapsed';

type NavItem = {
  path: string;
  icon: React.ComponentType<{ size?: number; strokeWidth?: number; style?: React.CSSProperties }>;
  label: string;
};

type NavSection = { title?: string; items: NavItem[] };

// NAV CONFIG PER ROLE
const adminNavSections: NavSection[] = [
  {
    title: 'Pilotage',
    items: [
      { path: '/dashboard',    icon: LayoutDashboard, label: 'Tableau de bord' },
      { path: '/performances', icon: BarChart3,       label: 'Performances'    },
      { path: '/reports',      icon: FileBarChart,    label: 'Rapports'        },
    ],
  },
  {
    title: 'Vie scolaire',
    items: [
      { path: '/eleves',      icon: Users,         label: 'Eleves'            },
      { path: '/enseignants', icon: GraduationCap, label: 'Enseignants'       },
      { path: '/cours',       icon: BookOpen,      label: 'Cours'             },
      { path: '/presences',   icon: CalendarCheck, label: 'Presences'         },
      { path: '/notes',       icon: NotebookPen,   label: 'Notes & bulletins' },
      { path: '/examens',     icon: PenSquare,     label: 'Examens'           },
      { path: '/resultats',   icon: BarChart3,     label: 'Resultats'         },
    ],
  },
  {
    title: 'Administration',
    items: [
      { path: '/employees',     icon: Users,      label: 'Employes'    },
      { path: '/branches',      icon: Building2,  label: 'Branches'    },
      { path: '/recruitment',   icon: Briefcase,  label: 'Recrutement' },
      { path: '/certificates',  icon: FileText,   label: 'Certificats' },
      { path: '/paiements',     icon: CreditCard, label: 'Paiements'   },
      { path: '/announcements', icon: Megaphone,  label: 'Annonces'    },
      { path: '/library',       icon: Library,    label: 'Bibliotheque' },
    ],
  },
  {
    title: 'Compte',
    items: [{ path: '/settings', icon: Settings, label: 'Parametres' }],
  },
];

const teacherNavSections: NavSection[] = [
  {
    title: 'Pilotage',
    items: [{ path: '/teacher', icon: Home, label: 'Tableau de bord' }],
  },
  {
    title: 'Enseignement',
    items: [
      { path: '/teacher/classes',    icon: Layers,        label: 'Mes classes' },
      { path: '/teacher/students',   icon: Users,         label: 'Eleves'      },
      { path: '/teacher/attendance', icon: CalendarCheck, label: 'Presences'   },
      { path: '/teacher/courses',    icon: BookOpen,      label: 'Cours'       },
      { path: '/teacher/grades',     icon: NotebookPen,   label: 'Notes'       },
      { path: '/teacher/reports',  icon: FileText,    label: 'Rapports'    },
    ],
  },
  {
    title: 'Examens',
    items: [
      { path: '/teacher/exams',           icon: FileText,     label: 'Mes examens'     },
      { path: '/teacher/exams/create',    icon: Plus,         label: 'Creer un examen' },
      { path: '/teacher/exams/submitted', icon: Send,         label: 'Soumis'          },
      { path: '/teacher/exams/published', icon: CheckCircle2, label: 'Publies'         },
      { path: '/teacher/exams/marks',     icon: BarChart3,    label: "Notes d'examen" },
    ],
  },
  {
    title: 'Compte',
    items: [{ path: '/teacher/profile', icon: Settings, label: 'Mon profil' }],
  },
];

const studentNavSections: NavSection[] = [
  { title: 'Pilotage', items: [{ path: '/eleve', icon: Home, label: 'Tableau de bord' }] },
  {
    title: 'Scolarite',
    items: [
      { path: '/eleve/courses',    icon: BookOpen,      label: 'Mes cours'     },
      { path: '/eleve/grades',     icon: NotebookPen,   label: 'Mes notes'     },
      { path: '/eleve/attendance', icon: CalendarCheck, label: 'Mes pr\u00E9sences' },
      { path: '/eleve/exams',      icon: PenSquare,     label: 'Examens'       },
    ],
  },
  {
    title: 'Ressources',
    items: [
      { path: '/eleve/announcements', icon: Megaphone,    label: 'Annonces'      },
      { path: '/eleve/library',       icon: Library,      label: 'Biblioth\u00E8que'  },
      { path: '/eleve/reports',       icon: FileBarChart, label: 'Mes bulletins' },
    ],
  },
  {
    title: 'Compte',
    items: [{ path: '/eleve/profile', icon: Settings, label: 'Mon profil' }],
  },
];

type Role = 'admin' | 'enseignant' | 'eleve';

function getNavForRole(role: Role) {
  switch (role) {
    case 'admin':
      return { sections: adminNavSections, subtitle: 'Espace Administration', rootPath: '/dashboard' };
    case 'enseignant':
      return { sections: teacherNavSections, subtitle: 'Espace Enseignant', rootPath: '/teacher' };
    default:
      return { sections: studentNavSections, subtitle: 'Espace aaaaaaaaaaaaaaaaaaaaaaaaaaalaaaaaaaaaaaaaaaaaaaaave', rootPath: '/eleve' };
  }
}

const SIDEBAR_CSS = `
.iemv-sidebar * { box-sizing: border-box; }
.iemv-nav {
  overflow-y: auto;
  overflow-x: hidden;
  scrollbar-width: none;
  -ms-overflow-style: none;
}
.iemv-nav::-webkit-scrollbar { width: 0; height: 0; display: none; }
.iemv-link {
  display: flex;
  align-items: center;
  text-decoration: none;
  border-radius: 10px;
  font-size: 14px;
  font-weight: 500;
  transition: background-color .15s ease, color .15s ease;
  white-space: nowrap;
  overflow: hidden;
}
.iemv-link:hover:not(.is-active) { background-color: ${T.hoverBg}; color: #fff !important; }
.iemv-footbtn {
  display: flex; align-items: center; width: 100%;
  background: transparent; border: 0; cursor: pointer;
  border-radius: 10px; font-size: 14px; font-weight: 500;
  color: ${T.idleText}; font-family: inherit;
  transition: background-color .15s ease, color .15s ease;
}
.iemv-footbtn:hover { background-color: ${T.hoverBg}; color: #fff; }
`;

const Sidebar = () => {
  const { user, logout } = useAuth();
  const navigate = useNavigate();

  const role: Role = useMemo(() => {
    if (user?.role === 'admin') return 'admin';
    if (user?.role === 'enseignant' || user?.role === 'teacher') return 'enseignant';
    return 'eleve';
  }, [user?.role]);

  const { sections, subtitle, rootPath } = useMemo(() => getNavForRole(role), [role]);

  const [collapsed, setCollapsed] = useState(() => {
    try { return localStorage.getItem(COLLAPSED_KEY) === 'true'; }
    catch { return false; }
  });

  const toggleCollapsed = () => {
    setCollapsed(prev => {
      const next = !prev;
      try { localStorage.setItem(COLLAPSED_KEY, String(next)); } catch {}
      return next;
    });
  };

  const handleLogout = () => { logout(); navigate('/login'); };

  return (
    <>
      <style>{SIDEBAR_CSS}</style>

      <div
        style={{
          display: 'flex',
          height: '100vh',
          width: '100%',
          overflow: 'hidden',
          fontFamily: 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
        }}
      >
        <aside
          className="iemv-sidebar"
          aria-label="Navigation principale"
          style={{
            display: 'flex',
            flexDirection: 'column',
            height: '100vh',
            width: collapsed ? 76 : 264,
            flexShrink: 0,
            background: T.bgGradient,
            transition: 'width .25s ease',
            fontFamily: 'system-ui, -apple-system, "Segoe UI", Roboto, sans-serif',
          }}
        >
          {/* Header */}
          <div
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 12,
              padding: collapsed ? '20px 0' : '20px 16px',
              justifyContent: collapsed ? 'center' : 'flex-start',
              flexShrink: 0,
            }}
          >
            <div
              style={{
                width: 42, height: 42, borderRadius: 12,
                background: '#FFFFFF',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                flexShrink: 0,
              }}
            >
              <GraduationCap size={22} strokeWidth={2} style={{ color: T.bg }} />
            </div>
            {!collapsed && (
              <div style={{ minWidth: 0, flex: 1 }}>
                <div
                  style={{
                    fontSize: 15, fontWeight: 700, color: '#fff',
                    lineHeight: 1.25, whiteSpace: 'nowrap',
                    overflow: 'hidden', textOverflow: 'ellipsis',
                  }}
                >
                  IEM Virunga
                </div>
                <div
                  style={{
                    fontSize: 12, color: 'rgba(255,255,255,0.55)',
                    marginTop: 2, whiteSpace: 'nowrap',
                    overflow: 'hidden', textOverflow: 'ellipsis',
                  }}
                >
                  {subtitle}
                </div>
              </div>
            )}
          </div>

          {/* Navigation */}
          <nav className="iemv-nav" style={{ flex: 1, padding: '4px 12px' }}>
            {sections.map((section, i) => (
              <div key={i} style={{ marginBottom: 18 }}>
                {section.title && !collapsed && (
                  <div
                    style={{
                      padding: '0 12px',
                      marginBottom: 8,
                      fontSize: 11,
                      fontWeight: 700,
                      letterSpacing: '0.08em',
                      textTransform: 'uppercase',
                      color: T.sectionText,
                    }}
                  >
                    {section.title}
                  </div>
                )}
                {section.title && collapsed && i > 0 && (
                  <div style={{ height: 1, background: T.divider, margin: '0 8px 12px' }} />
                )}

                <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
                  {section.items.map(item => (
                    <NavLink
                      key={item.path}
                      to={item.path}
                      end={item.path === rootPath}
                      title={collapsed ? item.label : undefined}
                      className={({ isActive }) => `iemv-link${isActive ? ' is-active' : ''}`}
                      style={({ isActive }) => ({
                        gap: collapsed ? 0 : 12,
                        justifyContent: collapsed ? 'center' : 'flex-start',
                        padding: collapsed ? '11px 0' : '10px 12px',
                        backgroundColor: isActive ? T.activeBg : 'transparent',
                        color: isActive ? T.activeText : T.idleText,
                        fontWeight: isActive ? 600 : 500,
                        boxShadow: isActive ? '0 2px 8px rgba(0,0,0,0.18)' : 'none',
                      })}
                    >
                      {({ isActive }) => (
                        <>
                          <item.icon
                            size={18}
                            strokeWidth={isActive ? 2.2 : 1.9}
                            style={{ flexShrink: 0 }}
                          />
                          {!collapsed && (
                            <span style={{ overflow: 'hidden', textOverflow: 'ellipsis' }}>
                              {item.label}
                            </span>
                          )}
                        </>
                      )}
                    </NavLink>
                  ))}
                </div>
              </div>
            ))}
          </nav>

          {/* Footer */}
          <div
            style={{
              flexShrink: 0,
              padding: 12,
              borderTop: `1px solid ${T.divider}`,
              display: 'flex',
              flexDirection: 'column',
              gap: 4,
            }}
          >
            <button
              className="iemv-footbtn"
              onClick={handleLogout}
              title="Changer d'espace"
              style={{
                gap: collapsed ? 0 : 12,
                justifyContent: collapsed ? 'center' : 'flex-start',
                padding: collapsed ? '11px 0' : '10px 12px',
              }}
            >
              <LogOut size={18} strokeWidth={1.9} style={{ flexShrink: 0 }} />
              {!collapsed && <span>Changer d'espace</span>}
            </button>

            <button
              className="iemv-footbtn"
              onClick={toggleCollapsed}
              title={collapsed ? 'Daaaaaaaaaaaaaaaaaaaaaplier le menu' : 'Replier le menu'}
              style={{
                gap: collapsed ? 0 : 12,
                justifyContent: collapsed ? 'center' : 'flex-start',
                padding: collapsed ? '11px 0' : '10px 12px',
                fontSize: 13,
                color: 'rgba(255,255,255,0.45)',
              }}
            >
              {collapsed
                ? <ChevronRight size={18} strokeWidth={1.9} />
                : <ChevronLeft size={18} strokeWidth={1.9} />}
              {!collapsed && <span>Replier le menu</span>}
            </button>
          </div>
        </aside>

        {/* Routed page content */}
        <main
          style={{
            flex: 1,
            minWidth: 0,
            height: '100vh',
            overflowY: 'auto',
            background: '#F7F7F5',
          }}
        >
          <Outlet />
        </main>
      </div>
    </>
  );
};

export default Sidebar;
