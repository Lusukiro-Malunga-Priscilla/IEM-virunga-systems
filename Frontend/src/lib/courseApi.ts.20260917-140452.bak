/**
 * IEM Virunga — courseApi
 * Client HTTP pour le catalogue des cours / attributions.
 *
 * Vite: variables d'env exposées uniquement si préfixées VITE_.
 */

export const API_BASE_URL = import.meta.env.VITE_API_BASE_URL ?? "/api";

/** Build absolute API URLs without duplicate slashes. */
export function apiUrl(path: string) {
  return `${API_BASE_URL.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;
}

// ─────────────────────────────────────────────────────────────
// Error class (exported so api.ts can reuse it)
// ─────────────────────────────────────────────────────────────

export class ApiError extends Error {
  status: number;
  constructor(message: string, status: number) {
    super(message);
    this.name = "ApiError";
    this.status = status;
  }
}

// ─────────────────────────────────────────────────────────────
// Auth
// ─────────────────────────────────────────────────────────────

const TOKEN_KEYS = ["token", "access_token", "accessToken", "jwt"] as const;

function getToken(): string | null {
  try {
    for (const k of TOKEN_KEYS) {
      const v = localStorage.getItem(k) ?? sessionStorage.getItem(k);
      if (v) return v;
    }
  } catch {}
  return null;
}

function authHeaders(extra: Record<string, string> = {}): Record<string, string> {
  const token = getToken();
  return {
    Accept: "application/json",
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
    ...extra,
  };
}

// ─────────────────────────────────────────────────────────────
// Fetch wrapper
// ─────────────────────────────────────────────────────────────

async function handle(res: Response) {
  if (!res.ok) {
    let message = `Erreur ${res.status}`;
    try {
      const body = await res.json();
      message = body?.message || body?.error || message;
    } catch {}
    throw new ApiError(message, res.status);
  }
  if (res.status === 204) return null;
  return res.json();
}

async function request<T = unknown>(path: string, init: RequestInit = {}): Promise<T> {
  const url = path.startsWith("http") ? path : apiUrl(path);
  const res = await fetch(url, {
    credentials: "include",
    ...init,
    headers: {
      ...authHeaders(),
      ...((init.headers as Record<string, string>) || {}),
    },
  });
  return handle(res) as Promise<T>;
}

// ─────────────────────────────────────────────────────────────
// Types
// ─────────────────────────────────────────────────────────────

export interface Section {
  id: number | string;
  name?: string;
  nom?: string;
  code?: string;
}

export interface Course {
  id: number;
  code: string;
  name: string;
  description?: string;
  section?: string;
  classe?: string;
  teacherId?: number;
  enseignant?: string;
  jour?: string;
  heureDebut?: string;
  heureFin?: string;
  volumeHoraire?: number;
  coefficient?: number;
}

export interface CoursePayload {
  code: string;
  name: string;
  description?: string;
  section?: string;
  classe?: string;
  teacherId?: number;
  enseignant?: string;
  jour?: string;
  heureDebut?: string;
  heureFin?: string;
  volumeHoraire?: number;
  coefficient?: number;
}

// ─────────────────────────────────────────────────────────────
// Sections (enum Java → lecture seule)
// ─────────────────────────────────────────────────────────────

export const sectionApi = {
  list(): Promise<Section[]> {
    return request<Section[]>("/sections");
  },
  get(id: number | string): Promise<Section> {
    return request<Section>(`/sections/${id}`);
  },
};

// ─────────────────────────────────────────────────────────────
// Courses
// ─────────────────────────────────────────────────────────────

export const courseApi = {
  list({ section, classe }: { section?: string; classe?: string } = {}): Promise<Course[]> {
    const params = new URLSearchParams();
    if (section) params.set("section", section);
    if (classe) params.set("classe", classe);
    const qs = params.toString();
    return request<Course[]>(`/courses${qs ? `?${qs}` : ""}`);
  },
  listBySection(section: string) { return this.list({ section }); },
  listByClasse(classe: string) { return this.list({ classe }); },
  get(id: number | string): Promise<Course> {
    return request<Course>(`/courses/${id}`);
  },
  create(payload: CoursePayload): Promise<Course> {
    return request<Course>("/courses", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
  },
  update(id: number | string, payload: Partial<CoursePayload>): Promise<Course> {
    return request<Course>(`/courses/${id}`, {
      method: "PUT",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });
  },
  remove(id: number | string): Promise<null> {
    return request<null>(`/courses/${id}`, { method: "DELETE" });
  },
};