import { useEffect, useState } from "react";
import { useAuth } from "@/context/AuthContext";
import { paymentApi, Payment, PaymentSummary } from "@/lib/paymentApi";

export default function StudentPayments() {
  const { user } = useAuth();
  const studentId = Number((user as any)?.studentId ?? 0);

  const [summary, setSummary] = useState<PaymentSummary | null>(null);
  const [rows, setRows] = useState<Payment[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    let cancelled = false;
    setLoading(true);
    setError(null);

    const loadAll = async () => {
      try {
        // 1. Get my history (needs studentId)
        let history: Payment[] = [];
        if (studentId) {
          history = await paymentApi.historyFor(studentId).catch(() => []);
        }

        // 2. Get my summary row (matches by email/username in the summary list)
        let mine: PaymentSummary | null = null;
        try {
          const allSummaries = await paymentApi.summary();
          mine = allSummaries.find(s =>
            (user?.email && s.registrationNumber === user.email) ||
            (user?.email && s.fullName?.toLowerCase() === user.name?.toLowerCase())
          ) ?? allSummaries.find(s =>
            user?.name && s.fullName?.toLowerCase().includes(user.name.toLowerCase().split(" ")[0])
          ) ?? null;
        } catch { /* ignore */ }

        if (!cancelled) {
          setRows(history);
          setSummary(mine);
        }
      } catch (e: any) {
        if (!cancelled) setError(e?.message ?? "Erreur de chargement");
      } finally {
        if (!cancelled) setLoading(false);
      }
    };

    loadAll();
    return () => { cancelled = true; };
  }, [studentId, user?.email, user?.name]);

  const fmt = (n: number | undefined) =>
    (n ?? 0).toLocaleString("fr-FR") + " RWF";

  // Totals: prefer the summary row; fall back to history
  const total = summary?.totalAmount ?? rows.reduce((s, r) => s + (r.totalAmount ?? 0), 0);
  const paid  = summary?.paidAmount  ?? rows.reduce((s, r) => s + (r.paidAmount  ?? 0), 0);
  const due   = summary?.remainingAmount ?? Math.max(0, total - paid);
  const pct   = total ? Math.round((paid / total) * 100) : 0;

  return (
    <div style={pageWrap}>
      <h1 style={h1Style}>Mes paiements</h1>
      <p style={subStyle}>Suivi de vos paiements scolaires (mis a jour par l'administration).</p>

      {loading && <p style={{ color:"#6E7580" }}>Chargement...</p>}
      {error && (
        <div style={{ background:"#FDECEC", color:"#7A2626", padding:"10px 14px",
                      borderRadius:8, marginBottom:16 }}>{error}</div>
      )}

      {!loading && !error && (
        <>
          {/* Summary table */}
          <div style={{ ...card, marginBottom: 20 }}>
            <table style={{ width:"100%", borderCollapse:"collapse" }}>
              <thead><tr>
                <th style={th}>Total frais</th>
                <th style={th}>Montant paye</th>
                <th style={th}>Reste a payer</th>
                <th style={th}>Progression</th>
                <th style={th}>Statut</th>
              </tr></thead>
              <tbody><tr>
                <td style={{ ...td, fontWeight:700 }}>{fmt(total)}</td>
                <td style={{ ...td, fontWeight:700, color:"#166534" }}>{fmt(paid)}</td>
                <td style={{ ...td, fontWeight:700, color: due > 0 ? "#B91C1C" : "#166534" }}>{fmt(due)}</td>
                <td style={td}>
                  <div style={{ display:"flex", alignItems:"center", gap:10 }}>
                    <div style={{ flex:1, height:8, background:"#E7EAF0", borderRadius:999, overflow:"hidden" }}>
                      <div style={{ width:`${pct}%`, height:"100%",
                                    background: pct >= 100 ? "#166534" : "#2F6FED" }} />
                    </div>
                    <span style={{ fontWeight:700, fontSize:13, minWidth:40 }}>{pct}%</span>
                  </div>
                </td>
                <td style={td}>
                  <span style={{
                    display:"inline-block", padding:"2px 10px", borderRadius:999, fontSize:12, fontWeight:600,
                    background: pct >= 100 ? "#DCFCE7" : pct > 0 ? "#FEF3C7" : "#FDECEC",
                    color:      pct >= 100 ? "#166534" : pct > 0 ? "#8A5A00" : "#7A2626",
                  }}>{summary?.status ?? (pct >= 100 ? "Solde" : pct > 0 ? "En cours" : "Non commence")}</span>
                </td>
              </tr></tbody>
            </table>
          </div>

          {/* History table */}
          <div style={card}>
            <div style={{ padding:"14px 20px", background:"#F4F6FA", fontWeight:700,
                          fontSize:13, color:"#0A1B33", textTransform:"uppercase",
                          letterSpacing:0.4, borderBottom:"1px solid #E7EAF0" }}>
              Historique des paiements
            </div>
            {rows.length === 0 ? (
              <div style={{ padding:40, textAlign:"center", color:"#6E7580" }}>
                Aucun paiement enregistre pour le moment.
              </div>
            ) : (
              <table style={{ width:"100%", borderCollapse:"collapse" }}>
                <thead><tr>
                  <th style={th}>Date</th>
                  <th style={th}>Montant total</th>
                  <th style={th}>Montant paye</th>
                  <th style={th}>Reste</th>
                  <th style={th}>Statut</th>
                </tr></thead>
                <tbody>
                  {rows.map((r, i) => (
                    <tr key={r.id ?? i}>
                      <td style={td}>{r.paymentDate}</td>
                      <td style={td}>{fmt(r.totalAmount)}</td>
                      <td style={{ ...td, fontWeight:600, color:"#166534" }}>{fmt(r.paidAmount)}</td>
                      <td style={{ ...td, color: (r.remainingAmount ?? 0) > 0 ? "#B91C1C" : "#166534" }}>
                        {fmt(r.remainingAmount)}
                      </td>
                      <td style={td}>{r.status}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}
          </div>
        </>
      )}
    </div>
  );
}

const th: React.CSSProperties = { padding:"12px 16px", fontSize:12, fontWeight:700, color:"#475569", textTransform:"uppercase", letterSpacing:0.4, textAlign:"left", background:"#F4F6FA", borderBottom:"1px solid #E7EAF0" };
const td: React.CSSProperties = { padding:"12px 16px", fontSize:13.5, color:"#12141B", borderBottom:"1px solid #E7EAF0" };
const pageWrap: React.CSSProperties = { padding:"32px 36px 64px", maxWidth:1200 };
const h1Style: React.CSSProperties = { fontSize:24, fontWeight:800, color:"#0A1B33", margin:0 };
const subStyle: React.CSSProperties = { color:"#6E7580", marginTop:6, marginBottom:24, fontSize:14 };
const card: React.CSSProperties = { background:"#fff", border:"1px solid #E7EAF0", borderRadius:8, overflow:"hidden" };
