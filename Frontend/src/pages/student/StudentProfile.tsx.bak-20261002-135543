// src/pages/student/StudentProfile.tsx
import { useAuth } from "@/context/AuthContext";

export default function StudentProfile() {
  const { user } = useAuth();

  const Row = ({ label, value }: { label: string; value: string }) => (
    <div style={{
      display: "flex", justifyContent: "space-between",
      padding: "14px 20px",
      borderBottom: "1px solid #E7EAF0",
    }}>
      <span style={{ color: "#6B7280", fontSize: 13.5 }}>{label}</span>
      <span style={{ color: "#12141B", fontSize: 13.5, fontWeight: 600 }}>{value || "--"}</span>
    </div>
  );

  const initials =
    ((user?.firstName?.[0] ?? "") + (user?.lastName?.[0] ?? "")).toUpperCase() || "?";

  return (
    <div style={{ padding: "32px 40px", maxWidth: 900 }}>
      <h1 style={{ fontSize: 26, fontWeight: 800, color: "#0B1B3A", margin: 0 }}>
        Mon profil
      </h1>
      <p style={{ color: "#6B7280", marginTop: 6, marginBottom: 24 }}>
        Informations de votre compte.
      </p>

      <div style={{
        background: "#fff", border: "1px solid #E7EAF0",
        borderRadius: 12, overflow: "hidden",
        boxShadow: "0 1px 2px rgba(0,0,0,0.03)",
      }}>
        <div style={{
          padding: "24px 20px",
          display: "flex", alignItems: "center", gap: 18,
          borderBottom: "1px solid #E7EAF0",
        }}>
          <div style={{
            width: 64, height: 64, borderRadius: "50%",
            background: "#0B1B3A", color: "#fff",
            display: "flex", alignItems: "center", justifyContent: "center",
            fontSize: 22, fontWeight: 700,
          }}>
            {initials}
          </div>
          <div>
            <div style={{ fontSize: 18, fontWeight: 700, color: "#0B1B3A" }}>
              {user?.firstName} {user?.lastName}
            </div>
            <div style={{ fontSize: 13, color: "#6B7280" }}>{user?.email}</div>
          </div>
        </div>

        <Row label="Identifiant" value={String(user?.id ?? "")} />
        <Row label="Role" value={user?.role ?? ""} />
        <Row label="Email" value={user?.email ?? ""} />
        <Row label="Prenom" value={user?.firstName ?? ""} />
        <Row label="Nom" value={user?.lastName ?? ""} />
      </div>
    </div>
  );
}
