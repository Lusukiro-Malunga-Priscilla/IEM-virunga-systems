// src/pages/teacher/TeacherExamsPage.tsx
import React, { useEffect, useMemo, useRef, useState } from "react";
import {
  Plus, Search, Loader2, Save, Trash2, Pencil, X,
  FileText, CheckCircle2, AlertCircle, Clock, Users,
  Upload, Paperclip, Download,
} from "lucide-react";
import { examApi, Exam, parseCsv, csvToExams, fileToDataUrl } from "@/lib/examApi";
import { courseApi, Course } from "@/lib/courseApi";

const EXAM_TYPES = ["QUIZ", "EXAM", "TP", "INTERRO"];
const STATUSES = ["DRAFT", "PUBLISHED", "CLOSED"];
const STATUS_LABEL: Record<string, string> = {
  DRAFT: "Brouillon", PUBLISHED: "Publie", CLOSED: "Ferme",
};
const MAX_FILE_BYTES = 5 * 1024 * 1024;
const ACCEPT = ".csv,.pdf,.jpg,.jpeg,.png,.webp,.gif,.doc,.docx,.txt,.ppt,.pptx,.xls,.xlsx";

interface CourseOption { id: number; name: string; }
interface StudentRow { id: number; studentClass?: string; }

interface Props { filter?: string; }

const emptyExam = (): Exam => ({
  title: "", subject: "", studentClass: "",
  examDate: new Date().toISOString().slice(0, 10),
  examType: "EXAM", maxScore: 20, duration: null,
  description: "", status: "DRAFT",
});

const JWT_RE = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/;
function authHeaders(): Record<string, string> {
  for (const s of [localStorage, sessionStorage]) {
    for (let i = 0; i < s.length; i++) {
      const v = s.getItem(s.key(i) || "");
      if (v && JWT_RE.test(v)) return { Authorization: `Bearer ${v}` };
    }
  }
  return {};
}

export default function TeacherExamsPage({ filter }: Props) {
  const [rows, setRows] = useState<Exam[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [banner, setBanner] = useState<{ type: "success" | "error"; text: string } | null>(null);

  const [showForm, setShowForm] = useState(false);
  const [editingId, setEditingId] = useState<number | null>(null);
  const [form, setForm] = useState<Exam>(emptyExam());
  const [saving, setSaving] = useState(false);

  const [courses, setCourses] = useState<CourseOption[]>([]);


  const [classes, setClasses] = useState<string[]>([]);


  const [q, setQ] = useState("");
  const [typeFilter, setTypeFilter] = useState("");

  const csvRef = useRef<HTMLInputElement>(null);
  const attachRef = useRef<HTMLInputElement>(null);

  useEffect(() => { load(); loadOptions(); }, []);
  useEffect(() => {
    if (!banner) return;
    const t = setTimeout(() => setBanner(null), 6000);
    return () => clearTimeout(t);
  }, [banner]);

  const loadOptions = async () => {
    try {
      const token = (function() {
        for (const s of [localStorage, sessionStorage]) {
          for (let i = 0; i < s.length; i++) {
            const v = s.getItem(s.key(i) || "");
            if (v && /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/.test(v)) return v;
          }
        }
        return "";
      })();
      const [cRes, sRes] = await Promise.all([
        fetch("/api/courses",  { headers: { Authorization: `Bearer ${token}` } }).then(r => r.ok ? r.json() : []),
        fetch("/api/students", { headers: { Authorization: `Bearer ${token}` } }).then(r => r.ok ? r.json() : []),
      ]);
      const seen = new Set<string>();
      const cls: string[] = [];
      (sRes || []).forEach((s: any) => {
        const v = s.studentClass || s.student_class;
        if (v && !seen.has(v)) { seen.add(v); cls.push(v); }
      });
      setCourses((cRes || []).map((x: any) => ({
        id: x.id,
        name: x.name || x.title || ("Cours #" + x.id),
      })));
      setClasses(cls.sort());
    } catch { /* silent */ }
  };

  const load = async () => {
    setLoading(true); setError(null);
    try {
      setRows(await examApi.listMine() || []);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Erreur de chargement.");
    } finally { setLoading(false); }
  };

  const stats = useMemo(() => {
    const draft = rows.filter(r => (r.status || "").toUpperCase() === "DRAFT").length;
    const published = rows.filter(r => (r.status || "").toUpperCase() === "PUBLISHED").length;
    const closed = rows.filter(r => (r.status || "").toUpperCase() === "CLOSED").length;
    return { total: rows.length, draft, published, closed };
  }, [rows]);

  const filtered = useMemo(() => {
    const needle = q.trim().toLowerCase();
    return rows.filter(r => {
      if (typeFilter && (r.examType || "").toUpperCase() !== typeFilter) return false;
      if (filter) {
        const want = filter.toUpperCase();
        const have = (r.status || "").toUpperCase();
        if (want === "SUBMITTED" && have !== "DRAFT") return false;
        if (want !== "SUBMITTED" && have !== want) return false;
      }
      if (!needle) return true;
      return `${r.title} ${r.subject} ${r.studentClass}`.toLowerCase().includes(needle);
    });
  }, [rows, q, typeFilter, filter]);

  const startCreate = () => { setForm(emptyExam()); setEditingId(null); setShowForm(true); };
  const startEdit   = (r: Exam) => { setForm({ ...emptyExam(), ...r }); setEditingId(r.id ?? null); setShowForm(true); };
  const cancelForm  = () => { setShowForm(false); setEditingId(null); setForm(emptyExam()); };

  const submit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!form.title.trim()) { setBanner({ type: "error", text: "Le titre est obligatoire." }); return; }
    setSaving(true);
    try {
      if (editingId) await examApi.update(editingId, form);
      else           await examApi.create(form);
      setBanner({ type: "success", text: editingId ? "Examen mis a jour." : "Examen cree." });
      cancelForm(); await load();
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    } finally { setSaving(false); }
  };

  const remove = async (r: Exam) => {
    if (r.id == null) return;
    if (!confirm(`Supprimer l examen "${r.title}" ?`)) return;
    try {
      await examApi.remove(r.id);
      setBanner({ type: "success", text: "Examen supprime." });
      await load();
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    }
  };

  // ---- CSV bulk import ----
  const handleCsvPick = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    e.target.value = "";
    if (!file) return;
    if (file.size > MAX_FILE_BYTES) {
      setBanner({ type: "error", text: "Fichier trop volumineux (5 Mo max)." });
      return;
    }
    try {
      const text = await file.text();
      const rowsParsed = parseCsv(text);
      const { exams, errors } = csvToExams(rowsParsed);
      if (exams.length === 0) {
        setBanner({ type: "error", text: "Aucun examen valide dans le fichier. " + (errors[0] || "") });
        return;
      }
      if (!confirm(`Importer ${exams.length} examen(s) ?\n${errors.length ? errors.length + " ligne(s) ignoree(s)." : ""}`)) return;
      const res = await examApi.bulkImport(exams);
      setBanner({
        type: "success",
        text: `${res.imported} examen(s) importe(s).${res.errors?.length ? " " + res.errors.length + " erreur(s)." : ""}`,
      });
      await load();
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur d import." });
    }
  };

  // ---- attachment ----
  const handleAttachPick = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    e.target.value = "";
    if (!file) return;
    if (file.size > MAX_FILE_BYTES) {
      setBanner({ type: "error", text: "Fichier trop volumineux (5 Mo max)." });
      return;
    }
    try {
      const dataUrl = await fileToDataUrl(file);
      setForm(prev => ({
        ...prev,
        attachmentUrl: dataUrl,
        attachmentName: file.name,
        attachmentMime: file.type || "application/octet-stream",
      }));
    } catch {
      setBanner({ type: "error", text: "Impossible de lire le fichier." });
    }
  };
  const clearAttachment = () => {
    setForm(prev => ({ ...prev, attachmentUrl: null, attachmentName: null, attachmentMime: null }));
  };

  return (
    <div className="ex-wrap">
      <style>{`
        .ex-wrap { font-family:'IBM Plex Sans',system-ui,sans-serif; color:#221F1B; }
        .ex-head { display:flex; justify-content:space-between; align-items:flex-start; gap:16px; margin-bottom:18px; flex-wrap:wrap; }
        .ex-title { font-size:22px; font-weight:700; color:#0B1B3A; margin:0 0 4px; }
        .ex-sub { color:#64748B; font-size:13.5px; margin:0; }
        .ex-btns { display:flex; gap:8px; flex-wrap:wrap; }
        .ex-stats { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; margin-bottom:18px; }
        .ex-stat { background:#fff; border:1px solid #E4E8EF; border-radius:10px; padding:14px 16px; display:flex; gap:12px; align-items:center; }
        .ex-stat .ico { width:36px; height:36px; border-radius:9px; display:inline-flex; align-items:center; justify-content:center; }
        .ex-stat .k { font-size:11.5px; font-weight:600; letter-spacing:.04em; text-transform:uppercase; color:#64748B; }
        .ex-stat .v { font-size:20px; font-weight:700; color:#0B1B3A; margin-top:2px; }
        .ex-banner { padding:12px 16px; border-radius:6px; font-size:13.5px; margin-bottom:16px; }
        .ex-banner.success { background:#E6F4EA; color:#14532D; border:1px solid #BFE3CA; }
        .ex-banner.error { background:#FDECEC; color:#7A2626; border:1px solid #F3C6C6; }
        .ex-btn { display:inline-flex; align-items:center; gap:8px; padding:9px 14px; font-size:13.5px; font-weight:600; font-family:inherit; border-radius:6px; cursor:pointer; border:1px solid #0B1B3A; background:#0B1B3A; color:#F3EFE3; }
        .ex-btn:hover:not(:disabled) { background:#15302A; }
        .ex-btn:disabled { opacity:.6; cursor:not-allowed; }
        .ex-btn.ghost { background:#fff; color:#0B1B3A; }
        .ex-btn.ghost:hover { background:#F1F5F9; }
        .ex-card { background:#fff; border:1px solid #E4E8EF; border-radius:10px; overflow:hidden; margin-bottom:16px; }
        .ex-filters { display:flex; gap:12px; align-items:center; padding:14px 18px; background:#FAFAF8; border-bottom:1px solid #E4E8EF; flex-wrap:wrap; }
        .ex-search { position:relative; flex:1; min-width:220px; }
        .ex-search input { width:100%; padding:8px 12px 8px 34px; border:1px solid #E4E8EF; border-radius:6px; font-size:13px; font-family:inherit; }
        .ex-search svg { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94A3B8; }
        .ex-select { padding:8px 10px; border:1px solid #E4E8EF; border-radius:6px; font-size:13px; font-family:inherit; }
        .ex-form { padding:20px 24px; display:grid; grid-template-columns:1fr 1fr; gap:14px; }
        .ex-form .full { grid-column: 1 / -1; }
        .ex-field { display:flex; flex-direction:column; gap:6px; }
        .ex-field label { font-size:11.5px; font-weight:600; letter-spacing:.03em; text-transform:uppercase; color:#64748B; }
        .ex-field input, .ex-field select, .ex-field textarea { padding:9px 12px; font-size:13.5px; border:1px solid #E4E8EF; border-radius:6px; font-family:inherit; outline:none; }
        .ex-field textarea { min-height:70px; resize:vertical; }
        .ex-file-row { display:flex; align-items:center; gap:8px; }
        .ex-file-chip { display:inline-flex; align-items:center; gap:6px; padding:5px 10px; border-radius:999px; background:#EEF2F7; color:#0B1B3A; font-size:12.5px; font-weight:600; }
        .ex-file-chip button { border:none; background:transparent; cursor:pointer; color:#64748B; }
        table.ex-table { width:100%; border-collapse:collapse; font-size:13.5px; }
        .ex-table thead th { background:#F1F5F9; text-align:left; padding:11px 14px; font-size:11.5px; font-weight:600; letter-spacing:.04em; color:#64748B; text-transform:uppercase; white-space:nowrap; }
        .ex-table tbody td { padding:11px 14px; border-top:1px solid #E4E8EF; }
        .ex-table tbody tr:hover { background:#FAFAF8; }
        .ex-badge { display:inline-block; padding:3px 9px; border-radius:999px; font-size:11px; font-weight:600; }
        .ex-badge.draft { background:#F1F5F9; color:#475569; }
        .ex-badge.published { background:#E6F4EA; color:#14532D; }
        .ex-badge.closed { background:#FDECEC; color:#9B2C2C; }
        .ex-badge.type { background:#EEF2F7; color:#0B1B3A; }
        .ex-actions { display:flex; gap:6px; align-items:center; }
        .ex-icon-btn { display:inline-flex; align-items:center; justify-content:center; width:30px; height:30px; border-radius:6px; border:1px solid #E4E8EF; background:#fff; cursor:pointer; color:#334155; }
        .ex-icon-btn:hover { background:#F1F5F9; }
        .ex-icon-btn.danger { color:#9B2C2C; border-color:#F3C6C6; }
        .ex-clip { color:#C8933E; }
        .ex-empty { padding:48px 24px; text-align:center; color:#94A3B8; font-size:13.5px; }
        .spin { animation: ex-spin .9s linear infinite; }
        @keyframes ex-spin { to { transform: rotate(360deg); } }
        @media (max-width: 800px) { .ex-stats { grid-template-columns:repeat(2,1fr); } .ex-form { grid-template-columns:1fr; } }
      `}</style>

      <div className="ex-head">
        <div>
          <h1 className="ex-title">Mes examens</h1>
          <p className="ex-sub">
            {filter ? `Filtre: ${filter}` : "Creez, importez, modifiez et publiez vos examens."}
          </p>
        </div>
        {!showForm && (
          <div className="ex-btns">
            <button className="ex-btn ghost" onClick={() => csvRef.current?.click()}>
              <Upload size={15} /> Importer
            </button>
            <button className="ex-btn" onClick={startCreate}>
              <Plus size={15} /> Nouvel examen
            </button>
          </div>
        )}
        <input ref={csvRef} type="file" accept=".csv" style={{ display:"none" }} onChange={handleCsvPick} />
      </div>

      {banner && <div className={`ex-banner ${banner.type}`}>{banner.text}</div>}

      <div className="ex-stats">
        <div className="ex-stat"><div className="ico" style={{ background:"#EEF2F7", color:"#0B1B3A" }}><FileText size={18} /></div>
          <div><div className="k">Total</div><div className="v">{stats.total}</div></div></div>
        <div className="ex-stat"><div className="ico" style={{ background:"#F1F5F9", color:"#475569" }}><Clock size={18} /></div>
          <div><div className="k">Brouillons</div><div className="v">{stats.draft}</div></div></div>
        <div className="ex-stat"><div className="ico" style={{ background:"#E6F4EA", color:"#14532D" }}><CheckCircle2 size={18} /></div>
          <div><div className="k">Publies</div><div className="v">{stats.published}</div></div></div>
        <div className="ex-stat"><div className="ico" style={{ background:"#FDECEC", color:"#9B2C2C" }}><AlertCircle size={18} /></div>
          <div><div className="k">Fermes</div><div className="v">{stats.closed}</div></div></div>
      </div>

      {showForm && (
        <form className="ex-card ex-form" onSubmit={submit}>
          <div className="ex-field full">
            <label>Titre *</label>
            <input type="text" value={form.title} required
              onChange={(e) => setForm({ ...form, title: e.target.value })}
              placeholder="Ex. Controle continu 1" />
          </div>
          <div className="ex-field"><label>Matiere</label>
            <select value={form.subject} onChange={(e) => setForm({ ...form, subject: e.target.value })}>
              <option value="">-- Choisir un cours --</option>
              {courses.map(c => <option key={c.id} value={c.name}>{c.name}</option>)}
              {form.subject && !courses.some(c => c.name === form.subject) && (
                <option value={form.subject}>{form.subject} (ancien)</option>
              )}
            </select>
          </div>
            <select value={form.subject} onChange={(e) => setForm({ ...form, subject: e.target.value })}>
              <option value="">-- Choisir un cours --</option>
              {courses.map(c => <option key={c.id} value={c.name}>{c.name}</option>)}
              {form.subject && !courses.some(c => c.name === form.subject) && (
                <option value={form.subject}>{form.subject} (ancien)</option>
              )}
            </select>
          </div>
          <div className="ex-field"><label>Classe</label>
            <select value={form.studentClass} onChange={(e) => setForm({ ...form, studentClass: e.target.value })}>
              <option value="">-- Choisir une classe --</option>
              {classes.map(c => <option key={c} value={c}>{c}</option>)}
              {form.studentClass && !classes.includes(form.studentClass) && (
                <option value={form.studentClass}>{form.studentClass} (ancienne)</option>
              )}
            </select>
          </div>
            <select value={form.studentClass} onChange={(e) => setForm({ ...form, studentClass: e.target.value })}>
              <option value="">-- Choisir une classe --</option>
              {classes.map(c => <option key={c} value={c}>{c}</option>)}
              {form.studentClass && !classes.includes(form.studentClass) && (
                <option value={form.studentClass}>{form.studentClass} (ancienne)</option>
              )}
            </select>
          </div>
          <div className="ex-field"><label>Date</label>
            <input type="date" value={form.examDate}
              onChange={(e) => setForm({ ...form, examDate: e.target.value })} /></div>
          <div className="ex-field"><label>Type</label>
            <select value={form.examType}
              onChange={(e) => setForm({ ...form, examType: e.target.value })}>
              {EXAM_TYPES.map(t => <option key={t} value={t}>{t}</option>)}
            </select></div>
          <div className="ex-field"><label>Note maximale</label>
            <input type="number" min={1} max={1000} value={form.maxScore}
              onChange={(e) => setForm({ ...form, maxScore: Number(e.target.value) || 20 })} /></div>
          <div className="ex-field"><label>Duree (minutes)</label>
            <input type="number" min={0} value={form.duration ?? ""}
              onChange={(e) => setForm({ ...form, duration: e.target.value === "" ? null : Number(e.target.value) })} /></div>
          <div className="ex-field"><label>Statut</label>
            <select value={form.status}
              onChange={(e) => setForm({ ...form, status: e.target.value })}>
              {STATUSES.map(s => <option key={s} value={s}>{STATUS_LABEL[s]}</option>)}
            </select></div>
          <div className="ex-field full"><label>Description (optionnel)</label>
            <textarea value={form.description ?? ""}
              onChange={(e) => setForm({ ...form, description: e.target.value })} /></div>

          <div className="ex-field full">
            <label>Fichier joint (PDF, image, Word, Excel, CSV ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â 5 Mo max)</label>
            <div className="ex-file-row">
              <button type="button" className="ex-btn ghost" onClick={() => attachRef.current?.click()}>
                <Paperclip size={15} /> {form.attachmentUrl ? "Changer" : "Joindre un fichier"}
              </button>
              {form.attachmentName && (
                <span className="ex-file-chip">
                  <Paperclip size={12} /> {form.attachmentName}
                  <button type="button" onClick={clearAttachment}><X size={12} /></button>
                </span>
              )}
            </div>
            <input ref={attachRef} type="file" accept={ACCEPT} style={{ display:"none" }} onChange={handleAttachPick} />
          </div>

          <div className="full" style={{ display:"flex", gap:8, justifyContent:"flex-end" }}>
            <button type="button" className="ex-btn ghost" onClick={cancelForm} disabled={saving}>
              <X size={15} /> Annuler
            </button>
            <button type="submit" className="ex-btn" disabled={saving}>
              {saving ? <Loader2 size={15} className="spin" /> : <Save size={15} />}
              {saving ? "Enregistrement..." : editingId ? "Mettre a jour" : "Creer"}
            </button>
          </div>
        </form>
      )}

      <div className="ex-card">
        <div className="ex-filters">
          <div className="ex-search">
            <Search size={15} />
            <input type="text" placeholder="Rechercher..."
              value={q} onChange={(e) => setQ(e.target.value)} />
          </div>
          <select className="ex-select" value={typeFilter} onChange={(e) => setTypeFilter(e.target.value)}>
            <option value="">Tous les types</option>
            {EXAM_TYPES.map(t => <option key={t} value={t}>{t}</option>)}
          </select>
        </div>

        {loading ? (
          <div className="ex-empty"><Loader2 size={16} className="spin" /> Chargement...</div>
        ) : error ? (
          <div className="ex-empty" style={{ color:"#9B2C2C" }}>{error}</div>
        ) : filtered.length === 0 ? (
          <div className="ex-empty">Aucun examen. Cliquez sur "Nouvel examen" ou "Importer".</div>
        ) : (
          <div style={{ overflowX:"auto" }}>
            <table className="ex-table">
              <thead>
                <tr>
                  <th>Date</th><th>Titre</th><th>Matiere</th><th>Classe</th>
                  <th>Type</th><th>Max</th><th>Statut</th><th></th>
                </tr>
              </thead>
              <tbody>
                {filtered.map(r => {
                  const st = (r.status || "DRAFT").toUpperCase();
                  const cls = st === "PUBLISHED" ? "published" : st === "CLOSED" ? "closed" : "draft";
                  return (
                    <tr key={r.id}>
                      <td>{r.examDate}</td>
                      <td style={{ fontWeight:600, color:"#0B1B3A" }}>{r.title}</td>
                      <td>{r.subject || "-"}</td>
                      <td>{r.studentClass || "-"}</td>
                      <td><span className="ex-badge type">{r.examType}</span></td>
                      <td>{r.maxScore}</td>
                      <td><span className={`ex-badge ${cls}`}>{STATUS_LABEL[st] || st}</span></td>
                      <td>
                        <div className="ex-actions">
                          {r.attachmentUrl && (
                            <a className="ex-icon-btn ex-clip" title={r.attachmentName || "Fichier joint"}
                               href={r.attachmentUrl} download={r.attachmentName || "exam"}>
                              <Download size={14} />
                            </a>
                          )}
                          <button className="ex-icon-btn" title="Modifier" onClick={() => startEdit(r)}>
                            <Pencil size={14} />
                          </button>
                          <button className="ex-icon-btn" title="Saisir les notes">
                            <Users size={14} />
                          </button>
                          <button className="ex-icon-btn danger" title="Supprimer" onClick={() => remove(r)}>
                            <Trash2 size={14} />
                          </button>
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </div>
  );
}
