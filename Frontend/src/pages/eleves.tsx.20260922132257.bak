import React, { useEffect, useMemo, useRef, useState } from "react";
import { Search, Upload, Download, Plus, X, Loader2, Power, Trash2 } from "lucide-react";
import { useAuth } from "@/context/AuthContext";

/* ------------------------------------------------------------------ */
/*  Institut d'Enseignement MÃ‰dical Virunga â€”Â Liste des Ã‰lÃ¨ves          */
/*  Connects to: GET/POST /api/students, GET /api/students/sections,    */
/*  PUT/DELETE /api/students/{id}, GET /api/students/export,            */
/*  POST /api/students/import                                           */
/* ------------------------------------------------------------------ */

// Relative paths, same convention as AuthContext.tsx ("/api/auth/login"),
// so requests go through your dev server's proxy / same origin in prod.
const API_BASE = "";

// A JWT is three base64url segments separated by dots â€”Â distinctive enough
// to find in storage without knowing the exact key your app uses.
const JWT_PATTERN = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/;

function isJwtLike(value: unknown): value is string {
  return typeof value === "string" && JWT_PATTERN.test(value);
}

function findTokenInStorage(storage: Storage): string | null {
  for (let i = 0; i < storage.length; i++) {
    const key = storage.key(i);
    if (!key) continue;
    const raw = storage.getItem(key);
    if (!raw) continue;
    if (isJwtLike(raw)) return raw;
    try {
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        for (const v of Object.values(parsed)) {
          if (isJwtLike(v)) return v as string;
        }
      }
    } catch {
      // not JSON, ignore
    }
  }
  return null;
}

interface SectionOption {
  value: string;
  displayName: string;
}

interface Student {
  id: number;
  registrationNumber: string;
  fullName: string;
  email: string;
  phone?: string;
  phoneNumber?: string;
  address?: string;
  studentClass?: string;
  gender?: string;
  dateOfBirth?: string;
  parentName?: string;
  parentPhoneNumber?: string;
  parentEmail?: string;
  section?: string;
  option?: string;
  enrollmentStatus?: string;
  academicYear?: string;
  active: boolean;
}

interface StudentFormState {
  fullName: string;
  dateOfBirth: string;
  gender: string;
  studentClass: string;
  section: string;
  option: string;
  academicYear: string;
  email: string;
  phoneNumber: string;
  address: string;
  parentName: string;
  parentPhoneNumber: string;
  parentEmail: string;
  registrationNumber: string;
}

const currentAcademicYearLabel = () => {
  const now = new Date();
  const y = now.getFullYear();
  return now.getMonth() >= 8 ? `${y} â€”Â ${y + 1}` : `${y - 1} â€”Â ${y}`;
};

const currentAcademicYearValue = () => currentAcademicYearLabel().replace(" â€”Â ", "-");

const FALLBACK_SECTIONS: SectionOption[] = [
  { value: "INFIRMIERE", displayName: "Section InfirmiÃ¨re de la RÃ‰FORME" },
  { value: "ACCOUCHEUSE", displayName: "Section Accoucheuse de la RÃ‰FORME" },
  { value: "ASSISTANT_PHARMACIE", displayName: "Section Assistant en pharmacie de la RÃ‰FORME" },
  { value: "SANTE_MENTALE", displayName: "Section SantÃ‰ Mentale de la RÃ‰FORME" },
  { value: "TECHNIQUE_LABORATOIRE", displayName: "Section Technique de Laboratoire de la RÃ‰FORME" },
];

const emptyForm = (): StudentFormState => ({
  fullName: "",
  dateOfBirth: "",
  gender: "FÃ©minin",
  studentClass: "",
  section: "",
  option: "",
  academicYear: currentAcademicYearValue(),
  email: "",
  phoneNumber: "",
  address: "",
  parentName: "",
  parentPhoneNumber: "",
  parentEmail: "",
  registrationNumber: "",
});

export default function Eleves() {
  // useAuth() is the source of truth for the token; storage scanning below
  // is only a fallback in case the token lives solely in context/memory
  // under a field name we can't predict from here.
  const authCtx = useAuth() as any;

  const [students, setStudents] = useState<Student[]>([]);
  const [sections, setSections] = useState<SectionOption[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [sectionFilter, setSectionFilter] = useState("");
  const [showModal, setShowModal] = useState(false);
  const [saving, setSaving] = useState(false);
  const [form, setForm] = useState<StudentFormState>(emptyForm());
  const [formError, setFormError] = useState<string | null>(null);
  const [banner, setBanner] = useState<{ type: "success" | "error"; text: string } | null>(null);
  const [importing, setImporting] = useState(false);
  const fileInputRef = useRef<HTMLInputElement>(null);

  const authToken = useMemo(() => {
    const fromContext =
      authCtx?.token || authCtx?.user?.token || authCtx?.accessToken || authCtx?.session?.token;
    if (isJwtLike(fromContext)) return fromContext;
    return findTokenInStorage(localStorage) || findTokenInStorage(sessionStorage);
  }, [authCtx]);

  const authHeaders = (): Record<string, string> =>
    authToken ? { Authorization: `Bearer ${authToken}` } : {};

  useEffect(() => {
    loadStudents();
    loadSections();
  }, []);

  useEffect(() => {
    if (!banner) return;
    const t = setTimeout(() => setBanner(null), 6000);
    return () => clearTimeout(t);
  }, [banner]);

  const loadStudents = async () => {
    setLoading(true);
    try {
      const res = await fetch(`${API_BASE}/api/students`, { headers: authHeaders() });
      if (!res.ok) throw new Error("Impossible de charger la liste des Ã©lÃ¨ves.");
      const data = await res.json();
      setStudents(data);
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur de chargement." });
    } finally {
      setLoading(false);
    }
  };

  const loadSections = async () => {
    try {
      const res = await fetch(`${API_BASE}/api/students/sections`, { headers: authHeaders() });
      if (!res.ok) throw new Error();
      const data = await res.json();
      setSections(data.sections?.length ? data.sections : FALLBACK_SECTIONS);
    } catch {
      setSections(FALLBACK_SECTIONS);
    }
  };

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    return students.filter((s) => {
      const matchesSearch =
        !q ||
        s.fullName?.toLowerCase().includes(q) ||
        s.registrationNumber?.toLowerCase().includes(q) ||
        s.email?.toLowerCase().includes(q);
      const matchesSection = !sectionFilter || s.section === sectionFilter;
      return matchesSearch && matchesSection;
    });
  }, [students, search, sectionFilter]);

  const sectionLabel = (value?: string) =>
    sections.find((s) => s.value === value)?.displayName || value || "â€”Â";

  const openAddModal = () => {
    setForm(emptyForm());
    setFormError(null);
    setShowModal(true);
  };

  const closeModal = () => {
    if (saving) return;
    setShowModal(false);
  };

  const handleFormChange = (field: keyof StudentFormState, value: string) => {
    setForm((prev) => ({ ...prev, [field]: value }));
  };

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormError(null);

    if (!form.fullName || !form.dateOfBirth || !form.section || !form.studentClass || !form.email) {
      setFormError(
        "Veuillez remplir les champs obligatoires : nom complet, date de naissance, classe, section et e-mail."
      );
      return;
    }

    setSaving(true);
    try {
      const payload = {
        registrationNumber: form.registrationNumber || undefined,
        fullName: form.fullName,
        dateOfBirth: form.dateOfBirth,
        gender: form.gender,
        studentClass: form.studentClass,
        section: form.section,
        option: form.option || null,
        academicYear: form.academicYear,
        email: form.email,
        phoneNumber: form.phoneNumber || null,
        address: form.address || null,
        parentName: form.parentName || null,
        parentPhoneNumber: form.parentPhoneNumber || null,
        parentEmail: form.parentEmail || null,
      };

      const res = await fetch(`${API_BASE}/api/students`, {
        method: "POST",
        headers: { "Content-Type": "application/json", ...authHeaders() },
        body: JSON.stringify(payload),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.error || "Ã‰chec de l'ajout de l'Ã‰lÃ¨ve.");
      }

      setBanner({
        type: "success",
        text: `${data.fullName} a Ã‰tÃ‰ inscrit(e) avec le matricule ${data.registrationNumber}. Connexion possible avec son e-mail (mot de passe initial : son matricule).`,
      });
      setShowModal(false);
      loadStudents();
    } catch (e) {
      setFormError(e instanceof Error ? e.message : "Erreur inattendue.");
    } finally {
      setSaving(false);
    }
  };

  const toggleActive = async (student: Student) => {
    try {
      const res = await fetch(`${API_BASE}/api/students/${student.id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", ...authHeaders() },
        body: JSON.stringify({ active: !student.active }),
      });
      if (!res.ok) throw new Error("Ã‰chec de la mise Ã  jour du statut.");
      setStudents((prev) => prev.map((s) => (s.id === student.id ? { ...s, active: !s.active } : s)));
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    }
  };

  const deleteStudent = async (student: Student) => {
    if (!window.confirm(`Supprimer ${student.fullName} ? Cette action est irrÃ‰versible.`)) return;
    try {
      const res = await fetch(`${API_BASE}/api/students/${student.id}`, {
        method: "DELETE",
        headers: authHeaders(),
      });
      if (!res.ok && res.status !== 204) throw new Error("Ã‰chec de la suppression.");
      setStudents((prev) => prev.filter((s) => s.id !== student.id));
      setBanner({ type: "success", text: `${student.fullName} a Ã‰tÃ‰ supprimÃ‰(e).` });
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    }
  };

  const handleExport = async () => {
    try {
      const res = await fetch(`${API_BASE}/api/students/export`, { headers: authHeaders() });
      if (!res.ok) throw new Error("Ã‰chec de l'export.");
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "eleves.csv";
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.URL.revokeObjectURL(url);
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur d'export." });
    }
  };

  const handleImportClick = () => fileInputRef.current?.click();

  const handleImportFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setImporting(true);
    try {
      const formData = new FormData();
      formData.append("file", file);
      const res = await fetch(`${API_BASE}/api/students/import`, {
        method: "POST",
        headers: authHeaders(),
        body: formData,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "Ã‰chec de l'import.");
      const errorCount = data.errors?.length || 0;
      setBanner({
        type: errorCount ? "error" : "success",
        text:
          `${data.imported} Ã‰lÃ¨ve(s) importÃ‰(s).` +
          (errorCount ? ` ${errorCount} ligne(s) en erreur : ${data.errors.slice(0, 3).join(" Â· ")}` : ""),
      });
      loadStudents();
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur d'import." });
    } finally {
      setImporting(false);
      if (fileInputRef.current) fileInputRef.current.value = "";
    }
  };

  return (
    <div className="iemv-eleves">
      <style>{`
        .iemv-eleves {
          --color-panel: #15302A;
          --color-panel-alt: #1D3F35;
          --color-bg: #F6F2E8;
          --color-text: #221F1B;
          --color-text-muted: #6B6357;
          --color-accent: #C8933E;
          --color-border: #E4E8EF;
          --color-error: #B3432B;

          font-family: 'IBM Plex Sans', system-ui, sans-serif;
          color: var(--color-text);
          padding: 28px 32px 48px;
          background: var(--color-bg);
          min-height: 100%;
        }

        .iemv-banner {
          margin-bottom: 18px;
          padding: 12px 16px;
          border-radius: 6px;
          font-size: 13.5px;
          line-height: 1.5;
        }
        .iemv-banner.success { background: #E6F4EA; color: #14532D; border: 1px solid #BFE3CA; }
        .iemv-banner.error { background: #FDECEC; color: #7A2626; border: 1px solid #F3C6C6; }

        .iemv-card {
          background: #fff;
          border: 1px solid var(--color-border);
          border-radius: 10px;
          overflow: hidden;
        }

        .iemv-card-head {
          padding: 22px 24px 18px;
          border-bottom: 1px solid var(--color-border);
        }
        .iemv-card-head h1 {
          font-size: 19px;
          font-weight: 700;
          margin: 0 0 4px;
        }
        .iemv-card-head p {
          font-size: 13px;
          color: var(--color-text-muted);
          margin: 0;
        }

        .iemv-toolbar {
          display: flex;
          flex-wrap: wrap;
          gap: 12px;
          align-items: center;
          justify-content: space-between;
          padding: 16px 24px;
          border-bottom: 1px solid var(--color-border);
        }

        .iemv-search {
          position: relative;
          flex: 1;
          min-width: 220px;
          max-width: 340px;
        }
        .iemv-search svg {
          position: absolute;
          left: 11px;
          top: 50%;
          transform: translateY(-50%);
          color: var(--color-text-muted);
        }
        .iemv-search input {
          width: 100%;
          box-sizing: border-box;
          padding: 9px 12px 9px 34px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          outline: none;
          font-family: inherit;
        }
        .iemv-search input:focus-visible {
          border-color: var(--color-accent);
        }

        .iemv-select {
          padding: 9px 12px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          background: #fff;
          font-family: inherit;
          color: var(--color-text);
          min-width: 220px;
        }

        .iemv-toolbar-actions {
          display: flex;
          gap: 10px;
          margin-left: auto;
        }

        .iemv-btn {
          display: inline-flex;
          align-items: center;
          gap: 7px;
          padding: 9px 14px;
          font-size: 13.5px;
          font-weight: 600;
          font-family: inherit;
          border-radius: 6px;
          cursor: pointer;
          border: 1px solid var(--color-border);
          background: #fff;
          color: var(--color-text);
          transition: background 0.15s ease, border-color 0.15s ease;
        }
        .iemv-btn:hover:not(:disabled) { border-color: var(--color-panel); }
        .iemv-btn:disabled { opacity: 0.6; cursor: not-allowed; }

        .iemv-btn-primary {
          background: var(--color-panel);
          border-color: var(--color-panel);
          color: #F3EFE3;
        }
        .iemv-btn-primary:hover:not(:disabled) { background: var(--color-panel-alt); }

        table.iemv-table {
          width: 100%;
          border-collapse: collapse;
          font-size: 13.5px;
        }
        .iemv-table thead th {
          background: #F1F5F9;
          text-align: left;
          padding: 12px 16px;
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.04em;
          color: #64748B;
          text-transform: uppercase;
          white-space: nowrap;
        }
        .iemv-table tbody td {
          padding: 13px 16px;
          border-top: 1px solid var(--color-border);
          vertical-align: middle;
        }
        .iemv-table tbody tr:hover { background: #FAFAF8; }

        .iemv-matricule {
          color: var(--color-text-muted);
          font-size: 12.5px;
        }
        .iemv-name { font-weight: 600; }
        .iemv-section-cell { color: var(--color-text-muted); font-size: 12.5px; max-width: 220px; }

        .iemv-badge {
          display: inline-block;
          padding: 4px 11px;
          border-radius: 999px;
          font-size: 12.5px;
          font-weight: 600;
        }
        .iemv-badge.active { background: #E6F4EA; color: #14532D; }
        .iemv-badge.suspended { background: #FDECEC; color: #9B2C2C; }

        .iemv-row-actions {
          display: flex;
          gap: 6px;
          justify-content: flex-end;
        }
        .iemv-icon-btn {
          background: none;
          border: none;
          cursor: pointer;
          color: var(--color-text-muted);
          padding: 6px;
          border-radius: 5px;
          display: inline-flex;
        }
        .iemv-icon-btn:hover { background: #F1F5F9; color: var(--color-text); }
        .iemv-icon-btn.danger:hover { background: #FDECEC; color: #9B2C2C; }

        .iemv-empty {
          padding: 48px 24px;
          text-align: center;
          color: var(--color-text-muted);
          font-size: 13.5px;
        }

        .iemv-modal-overlay {
          position: fixed;
          inset: 0;
          background: rgba(21, 20, 17, 0.5);
          display: flex;
          align-items: center;
          justify-content: center;
          z-index: 50;
          padding: 20px;
        }
        .iemv-modal {
          background: #fff;
          border-radius: 10px;
          width: 100%;
          max-width: 620px;
          max-height: 90vh;
          overflow-y: auto;
        }
        .iemv-modal-head {
          display: flex;
          align-items: center;
          justify-content: space-between;
          padding: 20px 24px;
          border-bottom: 1px solid var(--color-border);
        }
        .iemv-modal-head h2 {
          font-size: 17px;
          font-weight: 700;
          margin: 0;
        }
        .iemv-modal-close {
          background: none;
          border: none;
          cursor: pointer;
          color: var(--color-text-muted);
          padding: 4px;
        }
        .iemv-modal-body { padding: 22px 24px; }
        .iemv-form-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 14px 16px;
        }
        .iemv-form-grid .span-2 { grid-column: 1 / -1; }

        .iemv-field { display: flex; flex-direction: column; gap: 6px; }
        .iemv-field label {
          font-size: 12.5px;
          font-weight: 600;
          color: var(--color-text);
        }
        .iemv-field .optional { font-weight: 400; color: var(--color-text-muted); }
        .iemv-field input, .iemv-field select {
          padding: 9px 11px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          font-family: inherit;
          outline: none;
        }
        .iemv-field input:focus-visible, .iemv-field select:focus-visible {
          border-color: var(--color-accent);
        }

        .iemv-form-error {
          margin-bottom: 14px;
          padding: 10px 14px;
          background: #FDECEC;
          color: #7A2626;
          border-radius: 6px;
          font-size: 13px;
        }

        .iemv-modal-foot {
          display: flex;
          justify-content: flex-end;
          gap: 10px;
          padding: 16px 24px;
          border-top: 1px solid var(--color-border);
        }

        .spin { animation: iemv-spin 0.9s linear infinite; }
        @keyframes iemv-spin { to { transform: rotate(360deg); } }

        @media (max-width: 720px) {
          .iemv-eleves { padding: 18px; }
          .iemv-toolbar { flex-direction: column; align-items: stretch; }
          .iemv-toolbar-actions { margin-left: 0; flex-wrap: wrap; }
          .iemv-search { max-width: none; }
          .iemv-form-grid { grid-template-columns: 1fr; }
        }
      `}</style>

      {banner && <div className={`iemv-banner ${banner.type}`}>{banner.text}</div>}

      <div className="iemv-card">
        <div className="iemv-card-head">
          <h1>Liste des Ã©lÃ¨ves</h1>
          <p>Annee scolaire {currentAcademicYearLabel()}</p>
        </div>

        <div className="iemv-toolbar">
          <div className="iemv-search">
            <Search size={15} />
            <input
              type="text"
              placeholder="Rechercher par nom, matricule ou e-mailâ€¦"
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />
          </div>

          <select
            className="iemv-select"
            value={sectionFilter}
            onChange={(e) => setSectionFilter(e.target.value)}
          >
            <option value="">Toutes les sections</option>
            {sections.map((s) => (
              <option key={s.value} value={s.value}>
                {s.displayName}
              </option>
            ))}
          </select>

          <div className="iemv-toolbar-actions">
            <input
              ref={fileInputRef}
              type="file"
              accept=".csv"
              style={{ display: "none" }}
              onChange={handleImportFile}
            />
            <button className="iemv-btn" onClick={handleImportClick} disabled={importing}>
              {importing ? <Loader2 size={15} className="spin" /> : <Upload size={15} />}
              Importer
            </button>
            <button className="iemv-btn" onClick={handleExport}>
              <Download size={15} />
              Exporter
            </button>
            <button className="iemv-btn iemv-btn-primary" onClick={openAddModal}>
              <Plus size={15} />
              Ajouter un Ã©lÃ¨ve
            </button>
          </div>
        </div>

        {loading ? (
          <div className="iemv-empty">Chargementâ€¦</div>
        ) : filtered.length === 0 ? (
          <div className="iemv-empty">Aucun Ã‰lÃ¨ve ne correspond Ã  votre recherche.</div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table className="iemv-table">
              <thead>
                <tr>
                  <th>Matricule</th>
                  <th>Nom complet</th>
                  <th>Classe</th>
                  <th>Section</th>
                  <th>Sexe</th>
                  <th>Tuteur</th>
                  <th>TÃ©lÃ©phone</th>
                  <th>Statut</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((s) => (
                  <tr key={s.id}>
                    <td className="iemv-matricule">{s.registrationNumber}</td>
                    <td className="iemv-name">{s.fullName}</td>
                    <td>{s.studentClass || "â€”Â"}</td>
                    <td className="iemv-section-cell">{sectionLabel(s.section)}</td>
                    <td>{s.gender || "â€”Â"}</td>
                    <td>{s.parentName || "â€”Â"}</td>
                    <td>{s.phoneNumber || s.phone || "â€”Â"}</td>
                    <td>
                      <span className={`iemv-badge ${s.active ? "active" : "suspended"}`}>
                        {s.active ? "Actif" : "Suspendu"}
                      </span>
                    </td>
                    <td>
                      <div className="iemv-row-actions">
                        <button
                          className="iemv-icon-btn"
                          title={s.active ? "Suspendre" : "RÃ‰activer"}
                          onClick={() => toggleActive(s)}
                        >
                          <Power size={15} />
                        </button>
                        <button
                          className="iemv-icon-btn danger"
                          title="Supprimer"
                          onClick={() => deleteStudent(s)}
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {showModal && (
        <div className="iemv-modal-overlay" onClick={closeModal}>
          <div className="iemv-modal" onClick={(e) => e.stopPropagation()}>
            <div className="iemv-modal-head">
              <h2>Ajouter un Ã©lÃ¨ve</h2>
              <button className="iemv-modal-close" onClick={closeModal}>
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleSubmit}>
              <div className="iemv-modal-body">
                {formError && <div className="iemv-form-error">{formError}</div>}

                <div className="iemv-form-grid">
                  <div className="iemv-field">
                    <label>Nom complet</label>
                    <input
                      type="text"
                      value={form.fullName}
                      onChange={(e) => handleFormChange("fullName", e.target.value)}
                      placeholder="Ex. AÃ¯cha Mbayo"
                      required
                    />
                  </div>
                  <div className="iemv-field">
                    <label>Date de naissance</label>
                    <input
                      type="date"
                      value={form.dateOfBirth}
                      onChange={(e) => handleFormChange("dateOfBirth", e.target.value)}
                      required
                    />
                  </div>

                  <div className="iemv-field">
                    <label>Sexe</label>
                    <select value={form.gender} onChange={(e) => handleFormChange("gender", e.target.value)}>
                      <option value="FÃ©minin">FÃ©minin</option>
                      <option value="Masculin">Masculin</option>
                    </select>
                  </div>
                  <div className="iemv-field">
                    <label>Classe</label>
                    <select
                      value={form.studentClass}
                      onChange={(e) => handleFormChange("studentClass", e.target.value)}
                      required
                    >
                      <option value="">SÃ©lectionner une classeâ€¦</option>
                      <option value="1Ã¨re">1Ã¨re annÃ‰e</option>
                      <option value="2Ã¨me">2Ã¨me annÃ‰e</option>
                      <option value="3Ã¨me">3Ã¨me annÃ‰e</option>
                      <option value="4Ã¨me">4Ã¨me annÃ‰e</option>
                    </select>
                  </div>

                  <div className="iemv-field span-2">
                    <label>Section</label>
                    <select
                      value={form.section}
                      onChange={(e) => handleFormChange("section", e.target.value)}
                      required
                    >
                      <option value="">SÃ©lectionner une sectionâ€¦</option>
                      {sections.map((s) => (
                        <option key={s.value} value={s.value}>
                          {s.displayName}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div className="iemv-field">
                    <label>
                      Option <span className="optional">(facultatif)</span>
                    </label>
                    <input
                      type="text"
                      value={form.option}
                      onChange={(e) => handleFormChange("option", e.target.value)}
                      placeholder="Ex. Jour, Soir, Promotion 2"
                    />
                  </div>
                  <div className="iemv-field">
                    <label>AnnÃ©e acadÃ‰mique</label>
                    <input
                      type="text"
                      value={form.academicYear}
                      onChange={(e) => handleFormChange("academicYear", e.target.value)}
                    />
                  </div>

                  <div className="iemv-field">
                    <label>E-mail de l'Ã‰lÃ¨ve</label>
                    <input
                      type="email"
                      value={form.email}
                      onChange={(e) => handleFormChange("email", e.target.value)}
                      placeholder="eleve@iemv.edu.cd"
                      required
                    />
                  </div>
                  <div className="iemv-field">
                    <label>TÃ©lÃ©phone</label>
                    <input
                      type="text"
                      value={form.phoneNumber}
                      onChange={(e) => handleFormChange("phoneNumber", e.target.value)}
                      placeholder="+243â€¦"
                    />
                  </div>

                  <div className="iemv-field span-2">
                    <label>
                      Adresse <span className="optional">(facultatif)</span>
                    </label>
                    <input
                      type="text"
                      value={form.address}
                      onChange={(e) => handleFormChange("address", e.target.value)}
                    />
                  </div>

                  <div className="iemv-field">
                    <label>Nom du tuteur</label>
                    <input
                      type="text"
                      value={form.parentName}
                      onChange={(e) => handleFormChange("parentName", e.target.value)}
                    />
                  </div>
                  <div className="iemv-field">
                    <label>TÃ©lÃ©phone du tuteur</label>
                    <input
                      type="text"
                      value={form.parentPhoneNumber}
                      onChange={(e) => handleFormChange("parentPhoneNumber", e.target.value)}
                    />
                  </div>

                  <div className="iemv-field">
                    <label>
                      E-mail du tuteur <span className="optional">(facultatif)</span>
                    </label>
                    <input
                      type="email"
                      value={form.parentEmail}
                      onChange={(e) => handleFormChange("parentEmail", e.target.value)}
                    />
                  </div>
                  <div className="iemv-field">
                    <label>
                      Matricule <span className="optional">(auto si vide)</span>
                    </label>
                    <input
                      type="text"
                      value={form.registrationNumber}
                      onChange={(e) => handleFormChange("registrationNumber", e.target.value)}
                      placeholder="Ex. ELV-2401"
                    />
                  </div>
                </div>
              </div>

              <div className="iemv-modal-foot">
                <button type="button" className="iemv-btn" onClick={closeModal} disabled={saving}>
                  Annuler
                </button>
                <button type="submit" className="iemv-btn iemv-btn-primary" disabled={saving}>
                  {saving ? <Loader2 size={15} className="spin" /> : <Plus size={15} />}
                  {saving ? "Enregistrementâ€¦" : "Enregistrer l'Ã‰lÃ¨ve"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}