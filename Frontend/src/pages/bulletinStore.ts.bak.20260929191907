// src/pages/bulletinStore.ts
// Data layer for TeacherCourses + AdminBulletin.
// Talks to the real backend at /api/marks, /api/courses, /api/students.

export type Course = {
  id: string;
  name: string;
  teacherId: string;
  periodMax: number;
  examMax: number;
};

export type Student = { id: string; name: string; classe: string };

export type Marks = {
  p1: number | null; p2: number | null; ex1: number | null;
  p3: number | null; p4: number | null; ex2: number | null;
};

export const EMPTY: Marks = { p1: null, p2: null, ex1: null, p3: null, p4: null, ex2: null };

// ---- token helpers ----
const JWT_RE = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/;
function token(): string {
  for (const s of [localStorage, sessionStorage]) {
    for (let i = 0; i < s.length; i++) {
      const v = s.getItem(s.key(i) || "");
      if (v && JWT_RE.test(v)) return v;
      try {
        const p = JSON.parse(v || "");
        for (const iv of Object.values(p))
          if (typeof iv === "string" && JWT_RE.test(iv)) return iv as string;
      } catch {}
    }
  }
  return "";
}
function authHeaders(): Record<string, string> {
  const t = token();
  return t ? { Authorization: `Bearer ${t}` } : {};
}

// ---- Courses (from backend) ----
export async function loadCourses(): Promise<Course[]> {
  const res = await fetch("/api/courses", { headers: authHeaders() });
  if (!res.ok) return [];
  const data = await res.json();
  return (data || []).map((c: any) => ({
    id: String(c.id),
    name: c.name || c.code || ("Cours #" + c.id),
    teacherId: "", // assign later if you add teacher_id to Course
    periodMax: c.periodMax ?? 10,
    examMax: c.examMax ?? 20,
  }));
}

// ---- Students (from backend) ----
export async function loadStudents(): Promise<Student[]> {
  const res = await fetch("/api/students", { headers: authHeaders() });
  if (!res.ok) return [];
  const data = await res.json();
  return (data || []).map((s: any) => ({
    id: String(s.id),
    name: s.fullName || s.full_name || s.registrationNumber || ("Eleve #" + s.id),
    classe: s.studentClass || s.student_class || "",
  }));
}

// ---- Register (marks per course) ----
type Register = Record<string, Marks>;

export async function getRegister(courseId: string): Promise<Register> {
  const res = await fetch(`/api/marks/register/${courseId}`, { headers: authHeaders() });
  if (!res.ok) return {};
  const raw = await res.json();
  const out: Register = {};
  for (const [sid, row] of Object.entries<any>(raw)) {
    out[sid] = {
      p1: row.p1 ?? null, p2: row.p2 ?? null, ex1: row.ex1 ?? null,
      p3: row.p3 ?? null, p4: row.p4 ?? null, ex2: row.ex2 ?? null,
    };
  }
  return out;
}

export async function saveRegister(courseId: string, data: Register): Promise<void> {
  const res = await fetch(`/api/marks/register/${courseId}`, {
    method: "POST",
    headers: { "Content-Type": "application/json", ...authHeaders() },
    body: JSON.stringify(data),
  });
  if (!res.ok) throw new Error(`HTTP ${res.status}`);
}

// ---- Student marks (for bulletin) ----
export async function getStudentMarks(studentId: string): Promise<Map<string, Marks>> {
  const res = await fetch(`/api/marks/student/${studentId}`, { headers: authHeaders() });
  if (!res.ok) return new Map();
  const list = await res.json();
  const map = new Map<string, Marks>();
  for (const m of list || []) {
    const courseId = String(m.course?.id ?? "");
    if (!courseId) continue;
    map.set(courseId, {
      p1: m.p1 ?? null, p2: m.p2 ?? null, ex1: m.ex1 ?? null,
      p3: m.p3 ?? null, p4: m.p4 ?? null, ex2: m.ex2 ?? null,
    });
  }
  return map;
}

// ---- Helpers ----
const n = (v: number | null | undefined) => (typeof v === "number" ? v : 0);

export const sem1 = (m: Marks) => n(m.p1) + n(m.p2) + n(m.ex1);
export const sem2 = (m: Marks) => n(m.p3) + n(m.p4) + n(m.ex2);
export const total = (m: Marks) => sem1(m) + sem2(m);
export const courseMax = (c: Course) => 4 * c.periodMax + 2 * c.examMax;