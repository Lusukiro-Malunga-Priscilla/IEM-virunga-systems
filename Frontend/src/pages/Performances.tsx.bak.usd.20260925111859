// src/pages/Performances.tsx
import React, { useEffect, useMemo, useState } from "react";
import { Loader2, Users, GraduationCap, BookOpen, CalendarCheck, FileText, CreditCard } from "lucide-react";
import {
  loadGlobalStats, groupAttendanceByDay, topTeachersByReports, GlobalStats,
} from "@/lib/statsApi";
import PageStats from "@/components/PageStats";

const JWT = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/;
function getToken(): string | null {
  for (const s of [localStorage, sessionStorage]) {
    for (let i = 0; i < s.length; i++) {
      const v = s.getItem(s.key(i) || "");
      if (v && JWT.test(v)) return v;
      try { const p = JSON.parse(v || ""); for (const iv of Object.values(p)) if (typeof iv === "string" && JWT.test(iv)) return iv; } catch {}
    }
  }
  return null;
}
function authHeaders(): Record<string, string> {
  const t = getToken();
  return t ? { Authorization: `Bearer ${t}` } : {};
}

// ---------- small helper: smooth SVG path from points ----------
function smoothPath(points: { x: number; y: number }[]): string {
  if (points.length < 2) return "";
  let d = `M ${points[0].x},${points[0].y}`;
  for (let i = 0; i < points.length - 1; i++) {
    const p0 = points[i === 0 ? 0 : i - 1];
    const p1 = points[i];
    const p2 = points[i + 1];
    const p3 = points[i + 2 < points.length ? i + 2 : i + 1];
    const cp1x = p1.x + (p2.x - p0.x) / 6;
    const cp1y = p1.y + (p2.y - p0.y) / 6;
    const cp2x = p2.x - (p3.x - p1.x) / 6;
    const cp2y = p2.y - (p3.y - p1.y) / 6;
    d += ` C ${cp1x},${cp1y} ${cp2x},${cp2y} ${p2.x},${p2.y}`;
  }
  return d;
}

export default function Performances() {
  const [stats, setStats] = useState<GlobalStats | null>(null);
  const [attendance, setAttendance] = useState<any[]>([]);
  const [reports, setReports] = useState<any[]>([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);
  const [hoverIdx, setHoverIdx] = useState<number | null>(null);

  useEffect(() => { load(); }, []);

  const load = async () => {
    setLoading(true); setError(null);
    try {
      const [s, a, r] = await Promise.all([
        loadGlobalStats(),
        fetch("/api/attendance", { headers: authHeaders() }).then(x => x.ok ? x.json() : []),
        fetch("/api/reports", { headers: authHeaders() }).then(x => x.ok ? x.json() : []),
      ]);
      setStats(s);
      setAttendance(a || []);
      setReports(r || []);
    } catch (e) {
      setError(e instanceof Error ? e.message : "Erreur de chargement.");
    } finally {
      setLoading(false);
    }
  };

  const attendanceByDay = useMemo(
    () => groupAttendanceByDay(attendance, 30),
    [attendance]
  );

  const topTeachers = useMemo(
    () => topTeachersByReports(reports, 5),
    [reports]
  );

  const maxPresent = useMemo(
    () => Math.max(1, ...attendanceByDay.map(d => d.present)),
    [attendanceByDay]
  );
  const maxTeacherCount = useMemo(
    () => Math.max(1, ...topTeachers.map(t => t.count)),
    [topTeachers]
  );

  // ---- chart geometry (attendance) ----
  const CHART_W = 640;
  const CHART_H = 160;
  const PAD_L = 8;
  const PAD_R = 8;

  const points = useMemo(() => {
    const n = attendanceByDay.length;
    if (n === 0) return [];
    return attendanceByDay.map((d, i) => {
      const x = n === 1 ? CHART_W / 2 : PAD_L + (i * (CHART_W - PAD_L - PAD_R)) / (n - 1);
      const y = CHART_H - (d.present / maxPresent) * (CHART_H - 12) - 4;
      return { x, y, ...d };
    });
  }, [attendanceByDay, maxPresent]);

  const linePath = useMemo(() => smoothPath(points), [points]);
  const areaPath = useMemo(() => {
    if (points.length < 2) return "";
    return `${linePath} L ${points[points.length - 1].x},${CHART_H} L ${points[0].x},${CHART_H} Z`;
  }, [linePath, points]);

  if (loading) {
    return (
      <div style={{ padding: 24, display: "flex", gap: 10, alignItems: "center", color: "#5B6472", fontFamily: "'IBM Plex Sans', system-ui, sans-serif", fontSize: 14 }}>
        <Loader2 size={18} className="spin" style={{ color: "#0B1B3A" }} /> Chargement des performances…
        <style>{`.spin{animation:sp .9s linear infinite}@keyframes sp{to{transform:rotate(360deg)}}`}</style>
      </div>
    );
  }
  if (error) {
    return (
      <div style={{ padding: 24, color: "#111", fontFamily: "'IBM Plex Sans', system-ui, sans-serif" }}>
        <div style={{ display: "inline-flex", alignItems: "center", gap: 10, padding: "12px 16px", border: "1px solid #111", borderRadius: 8 }}>
          {error}
        </div>
      </div>
    );
  }
  if (!stats) return null;

  return (
    <div className="pf-wrap">
      <style>{`
        :root {
          --navy: #0B1B3A;
          --navy-2: #16294F;
          --navy-soft: #EEF1F8;
          --black: #0A0A0A;
          --white: #FFFFFF;
          --line: #E3E6EC;
          --muted: #6B7280;
          --muted-2: #9AA3B2;
        }
        .pf-wrap { font-family:'IBM Plex Sans', system-ui, sans-serif; color: var(--black); }

        .pf-head { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; margin-bottom: 24px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
        .pf-title { font-size: 24px; font-weight: 700; color: var(--navy); margin: 0 0 4px; letter-spacing: -0.01em; }
        .pf-sub { color: var(--muted); font-size: 13.5px; margin: 0; }

        .pf-charts { display: grid; grid-template-columns: 1.7fr 1fr; gap: 16px; margin-bottom: 16px; }
        @media (max-width: 900px) { .pf-charts { grid-template-columns: 1fr; } }

        .pf-card { background: var(--white); border:1px solid var(--line); border-radius:12px; padding:20px 22px 18px; position: relative; }
        .pf-card-head { display:flex; align-items:baseline; justify-content:space-between; margin-bottom: 16px; }
        .pf-card h3 { font-size:13px; font-weight:600; color: var(--navy); margin:0; }
        .pf-card .pf-meta { font-size: 11.5px; color: var(--muted-2); }

        /* attendance chart */
        .pf-svg-wrap { position: relative; width: 100%; }
        .pf-svg-wrap svg { width: 100%; height: 160px; display: block; overflow: visible; }
        .pf-grid-line { stroke: var(--line); stroke-width: 1; }
        .pf-area { fill: url(#pfAreaGrad); }
        .pf-line { fill: none; stroke: var(--navy); stroke-width: 2; }
        .pf-dot { fill: var(--white); stroke: var(--navy); stroke-width: 2; }
        .pf-dot-hit { fill: transparent; cursor: pointer; }
        .pf-hover-line { stroke: var(--navy); stroke-width: 1; stroke-dasharray: 3 3; opacity: 0.5; }
        .pf-axis-row { display:flex; justify-content: space-between; font-size: 10.5px; color: var(--muted-2); margin-top: 8px; padding: 0 2px; }
        .pf-tooltip { position:absolute; transform: translate(-50%, -100%); background: var(--navy); color: var(--white); font-size: 11.5px; padding: 6px 10px; border-radius: 6px; white-space: nowrap; pointer-events:none; z-index: 2; }
        .pf-tooltip:after { content:""; position:absolute; left:50%; top:100%; transform: translateX(-50%); border: 5px solid transparent; border-top-color: var(--navy); }

        /* teachers chart */
        .pf-bars-list { display: flex; flex-direction: column; gap: 14px; }
        .pf-bar-row .lbl { display: flex; justify-content: space-between; align-items:baseline; font-size: 13px; color: var(--black); margin-bottom: 6px; }
        .pf-bar-row .lbl strong { color: var(--navy); font-weight: 700; font-size: 13px; }
        .pf-bar-track { height: 7px; background: var(--navy-soft); border-radius: 999px; overflow: hidden; }
        .pf-bar-fill { height: 100%; background: linear-gradient(90deg, var(--navy-2), var(--navy)); border-radius: 999px; transition: width .5s cubic-bezier(.4,0,.2,1); }
        .pf-rank { display:inline-flex; align-items:center; justify-content:center; width:18px; height:18px; border-radius:5px; background: var(--navy); color:var(--white); font-size: 10px; font-weight:700; margin-right: 8px; }

        .pf-empty { padding: 40px 0; text-align: center; color: var(--muted-2); font-size: 13px; }

        /* summary row */
        .pf-summary-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px,1fr)); gap: 2px; background: var(--line); border: 1px solid var(--line); border-radius: 12px; overflow: hidden; }
        .pf-summary-item { background: var(--white); display:flex; align-items:center; gap: 12px; padding: 16px 18px; }
        .pf-summary-icon { width: 34px; height: 34px; border-radius: 8px; background: var(--navy-soft); display:flex; align-items:center; justify-content:center; flex-shrink: 0; }
        .pf-summary-val { font-size: 16px; font-weight: 700; color: var(--black); line-height: 1.15; }
        .pf-summary-lbl { font-size: 11.5px; color: var(--muted); }
      `}</style>

      <div className="pf-head">
        <div>
          <h1 className="pf-title">Performances</h1>
          <p className="pf-sub">Vue globale des indicateurs clés du système.</p>
        </div>
      </div>

      {/* KPI row */}
      <div style={{ marginBottom: 20 }}>
        <PageStats
          items={[
            { label: "Élèves actifs",      value: `${stats.studentsActive} / ${stats.studentsTotal}`, tone: "success" },
            { label: "Enseignants",         value: stats.teachersTotal },
            { label: "Cours",               value: stats.coursesTotal },
            { label: "Présences aujourd'hui", value: stats.attendanceToday, tone: stats.attendanceToday > 0 ? "success" : "warning" },
            { label: "Rapports cette semaine", value: stats.reportsThisWeek, tone: stats.reportsThisWeek > 0 ? "success" : "warning" },
            { label: "Paiements ce mois",    value: `${stats.paymentsThisMonth.toLocaleString("fr-FR")} FC` },
          ]}
        />
      </div>

      <div className="pf-charts">
        {/* Attendance chart */}
        <div className="pf-card">
          <div className="pf-card-head">
            <h3>Présences — 30 derniers jours</h3>
            <span className="pf-meta">max {maxPresent} / jour</span>
          </div>

          {attendanceByDay.every(d => d.present === 0) ? (
            <div className="pf-empty">Aucune présence enregistrée sur la période.</div>
          ) : (
            <>
              <div className="pf-svg-wrap">
                <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} preserveAspectRatio="none">
                  <defs>
                    <linearGradient id="pfAreaGrad" x1="0" y1="0" x2="0" y2="1">
                      <stop offset="0%" stopColor="#0B1B3A" stopOpacity="0.22" />
                      <stop offset="100%" stopColor="#0B1B3A" stopOpacity="0" />
                    </linearGradient>
                  </defs>

                  {[0, 0.5, 1].map((t) => (
                    <line
                      key={t}
                      className="pf-grid-line"
                      x1={0} x2={CHART_W}
                      y1={CHART_H - t * (CHART_H - 12) - 4}
                      y2={CHART_H - t * (CHART_H - 12) - 4}
                    />
                  ))}

                  <path className="pf-area" d={areaPath} />
                  <path className="pf-line" d={linePath} />

                  {hoverIdx !== null && points[hoverIdx] && (
                    <line
                      className="pf-hover-line"
                      x1={points[hoverIdx].x} x2={points[hoverIdx].x}
                      y1={0} y2={CHART_H}
                    />
                  )}

                  {points.map((p, i) => (
                    <g key={p.date}>
                      {hoverIdx === i && <circle className="pf-dot" cx={p.x} cy={p.y} r={4} />}
                      <circle
                        className="pf-dot-hit"
                        cx={p.x} cy={p.y} r={10}
                        onMouseEnter={() => setHoverIdx(i)}
                        onMouseLeave={() => setHoverIdx(null)}
                      />
                    </g>
                  ))}
                </svg>

                {hoverIdx !== null && points[hoverIdx] && (
                  <div
                    className="pf-tooltip"
                    style={{
                      left: `${(points[hoverIdx].x / CHART_W) * 100}%`,
                      top: `${(points[hoverIdx].y / CHART_H) * 100}%`,
                    }}
                  >
                    {points[hoverIdx].date} · {points[hoverIdx].present} / {points[hoverIdx].total}
                  </div>
                )}
              </div>

              <div className="pf-axis-row">
                <span>{attendanceByDay[0]?.date}</span>
                <span>{attendanceByDay[attendanceByDay.length - 1]?.date}</span>
              </div>
            </>
          )}
        </div>

        {/* Top teachers chart */}
        <div className="pf-card">
          <div className="pf-card-head">
            <h3>Top enseignants</h3>
            <span className="pf-meta">rapports soumis</span>
          </div>

          {topTeachers.length === 0 ? (
            <div className="pf-empty">Aucun rapport soumis.</div>
          ) : (
            <div className="pf-bars-list">
              {topTeachers.map((t, i) => (
                <div key={t.teacherId} className="pf-bar-row">
                  <div className="lbl">
                    <span><span className="pf-rank">{i + 1}</span>{t.name}</span>
                    <strong>{t.count}</strong>
                  </div>
                  <div className="pf-bar-track">
                    <div
                      className="pf-bar-fill"
                      style={{ width: `${(t.count / maxTeacherCount) * 100}%` }}
                    />
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
      </div>

      {/* Summary row */}
      <div className="pf-summary-grid">
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><Users size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.studentsTotal}</div>
            <div className="pf-summary-lbl">élèves au total</div>
          </div>
        </div>
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><GraduationCap size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.teachersTotal}</div>
            <div className="pf-summary-lbl">enseignants</div>
          </div>
        </div>
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><BookOpen size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.coursesTotal}</div>
            <div className="pf-summary-lbl">cours</div>
          </div>
        </div>
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><CalendarCheck size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.attendanceToday}</div>
            <div className="pf-summary-lbl">présences aujourd'hui</div>
          </div>
        </div>
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><FileText size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.reportsTotal}</div>
            <div className="pf-summary-lbl">rapports au total</div>
          </div>
        </div>
        <div className="pf-summary-item">
          <div className="pf-summary-icon"><CreditCard size={16} color="#0B1B3A" /></div>
          <div>
            <div className="pf-summary-val">{stats.paymentsThisMonth.toLocaleString("fr-FR")} FC</div>
            <div className="pf-summary-lbl">ce mois</div>
          </div>
        </div>
      </div>
    </div>
  );
}