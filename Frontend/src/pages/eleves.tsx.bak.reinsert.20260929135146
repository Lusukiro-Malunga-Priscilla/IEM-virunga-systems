// src/pages/eleves.tsx
import React, { useEffect, useMemo, useRef, useState } from "react";
import {
  Search,
  Upload,
  Download,
  Plus,
  X,
  Loader2,
  Power,
  Trash2,
  Pencil,
  Camera,
  ImagePlus,
  UserRound,
} from "lucide-react";
import { useAuth } from "@/context/AuthContext";

/* ------------------------------------------------------------------ */
/*  Institut d'Enseignement Medical Virunga - Liste des eleves        */
/*  Connects to: GET/POST /api/students, GET /api/students/sections,   */
/*  PUT/DELETE /api/students/{id}, GET /api/students/export,           */
/*  POST /api/students/import                                          */
/*                                                                      */
/*  Student objects now also carry:                                    */
/*    - nationality: string                                            */
/*    - photo: string (base64 data URL, e.g. "data:image/jpeg;base64,")*/
/* ------------------------------------------------------------------ */

const API_BASE = "";

const JWT_PATTERN = /^[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+$/;
const MAX_PHOTO_BYTES = 10 * 1024 * 1024; // 3 MB safety cap on the raw file

function isJwtLike(value: unknown): value is string {
  return typeof value === "string" && JWT_PATTERN.test(value);
}

function findTokenInStorage(storage: Storage): string | null {
  for (let i = 0; i < storage.length; i++) {
    const key = storage.key(i);
    if (!key) continue;
    const raw = storage.getItem(key);
    if (!raw) continue;
    if (isJwtLike(raw)) return raw;
    try {
      const parsed = JSON.parse(raw);
      if (parsed && typeof parsed === "object") {
        for (const v of Object.values(parsed)) {
          if (isJwtLike(v)) return v as string;
        }
      }
    } catch {
      // not JSON, ignore
    }
  }
  return null;
}

function fileToDataUrl(file: File): Promise<string> {
  return new Promise((resolve, reject) => {
    const reader = new FileReader();
    reader.onload = () => resolve(reader.result as string);
    reader.onerror = () => reject(reader.error || new Error("Lecture du fichier impossible."));
    reader.readAsDataURL(file);
  });
}

function initialsOf(name?: string) {
  if (!name) return "";
  const parts = name.trim().split(/\s+/).filter(Boolean);
  if (parts.length === 0) return "";
  if (parts.length === 1) return parts[0].slice(0, 2).toUpperCase();
  return (parts[0][0] + parts[parts.length - 1][0]).toUpperCase();
}

interface SectionOption {
  value: string;
  displayName: string;
}

interface Student {
  id: number;
  registrationNumber: string;
  fullName: string;
  email: string;
  phone?: string;
  phoneNumber?: string;
  address?: string;
  studentClass?: string;
  gender?: string;
  dateOfBirth?: string;
  section?: string;
  option?: string;
  nationality?: string;
  photo?: string;
  enrollmentStatus?: string;
  academicYear?: string;
  active: boolean;
}

interface StudentFormState {
  fullName: string;
  dateOfBirth: string;
  gender: string;
  studentClass: string;
  section: string;
  option: string;
  nationality: string;
  academicYear: string;
  email: string;
  phoneNumber: string;
  address: string;
  registrationNumber: string;
  photo: string; // base64 data URL, "" when none
}

const currentAcademicYearLabel = () => {
  const now = new Date();
  const y = now.getFullYear();
  return now.getMonth() >= 8 ? `${y} - ${y + 1}` : `${y - 1} - ${y}`;
};

const currentAcademicYearValue = () => currentAcademicYearLabel().replace(" - ", "-");

const FALLBACK_SECTIONS: SectionOption[] = [
  { value: "INFIRMIERE",            displayName: "Section Infirmi\u00E8re de la R\u00C9FORME" },
  { value: "ACCOUCHEUSE",           displayName: "Section Accoucheuse de la R\u00C9FORME" },
  { value: "ASSISTANT_PHARMACIE",   displayName: "Section Assistant en pharmacie de la R\u00C9FORME" },
  { value: "SANTE_MENTALE",         displayName: "Section Sant\u00E9 Mentale de la R\u00C9FORME" },
  { value: "TECHNIQUE_LABORATOIRE", displayName: "Section Technique de Laboratoire de la R\u00C9FORME" },
];

const emptyForm = (): StudentFormState => ({
  fullName: "",
  dateOfBirth: "",
  gender: "F\u00E9minin",
  studentClass: "",
  section: "",
  option: "",
  nationality: "Congolaise (RDC)",
  academicYear: currentAcademicYearValue(),
  email: "",
  phoneNumber: "",
  address: "",
  registrationNumber: "",
  photo: "",
});

export default function Eleves() {
  const authCtx = useAuth() as any;

  const [students, setStudents] = useState<Student[]>([]);
  const [sections, setSections] = useState<SectionOption[]>([]);
  const [loading, setLoading] = useState(true);
  const [search, setSearch] = useState("");
  const [sectionFilter, setSectionFilter] = useState("");
  const [showModal, setShowModal] = useState(false);
  const [saving, setSaving] = useState(false);
  const [form, setForm] = useState<StudentFormState>(emptyForm());
  const [formError, setFormError] = useState<string | null>(null);
  const [banner, setBanner] = useState<{ type: "success" | "error"; text: string } | null>(null);
  const [importing, setImporting] = useState(false);
  const [editingStudent, setEditingStudent] = useState<Student | null>(null);
  const fileInputRef = useRef<HTMLInputElement>(null);
  const cameraInputRef = useRef<HTMLInputElement>(null);
  const importPhotoInputRef = useRef<HTMLInputElement>(null);

  const authToken = useMemo(() => {
    const fromContext =
      authCtx?.token || authCtx?.user?.token || authCtx?.accessToken || authCtx?.session?.token;
    if (isJwtLike(fromContext)) return fromContext;
    return findTokenInStorage(localStorage) || findTokenInStorage(sessionStorage);
  }, [authCtx]);

  const authHeaders = (): Record<string, string> =>
    authToken ? { Authorization: `Bearer ${authToken}` } : {};

  useEffect(() => {
    loadStudents();
    loadSections();
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  useEffect(() => {
    if (!banner) return;
    const t = setTimeout(() => setBanner(null), 6000);
    return () => clearTimeout(t);
  }, [banner]);

  const loadStudents = async () => {
    setLoading(true);
    try {
      const res = await fetch(`${API_BASE}/api/students`, { headers: authHeaders() });
      if (!res.ok) throw new Error("Impossible de charger la liste des \u00E9l\u00E8ves.");
      const data = await res.json();
      setStudents(data);
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur de chargement." });
    } finally {
      setLoading(false);
    }
  };

  const loadSections = async () => {
    try {
      const res = await fetch(`${API_BASE}/api/students/sections`, { headers: authHeaders() });
      if (!res.ok) throw new Error();
      const data = await res.json();
      setSections(data.sections?.length ? data.sections : FALLBACK_SECTIONS);
    } catch {
      setSections(FALLBACK_SECTIONS);
    }
  };

  const filtered = useMemo(() => {
    const q = search.trim().toLowerCase();
    return students.filter((s) => {
      const matchesSearch =
        !q ||
        s.fullName?.toLowerCase().includes(q) ||
        s.registrationNumber?.toLowerCase().includes(q) ||
        s.email?.toLowerCase().includes(q);
      const matchesSection = !sectionFilter || s.section === sectionFilter;
      return matchesSearch && matchesSection;
    });
  }, [students, search, sectionFilter]);

  const sectionLabel = (value?: string) =>
    sections.find((s) => s.value === value)?.displayName || value || "\u2014";

  const openAddModal = () => {
    setEditingStudent(null);
    setForm(emptyForm());
    setFormError(null);
    setShowModal(true);
  };

  const openEditModal = (student: Student) => {
    setEditingStudent(student);
    setForm({
      fullName: student.fullName || "",
      dateOfBirth: student.dateOfBirth || "",
      gender: student.gender || "F\u00E9minin",
      studentClass: student.studentClass || "",
      section: student.section || "",
      option: student.option || "",
      nationality: student.nationality || "",
      academicYear: student.academicYear || currentAcademicYearValue(),
      email: student.email || "",
      phoneNumber: student.phoneNumber || student.phone || "",
      address: student.address || "",
      registrationNumber: student.registrationNumber || "",
      photo: student.photo || "",
    });
    setFormError(null);
    setShowModal(true);
  };

  const closeModal = () => {
    if (saving) return;
    setShowModal(false);
    setEditingStudent(null);
  };

  const handleFormChange = (field: keyof StudentFormState, value: string) => {
    setForm((prev) => ({ ...prev, [field]: value }));
  };

  const handlePhotoFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    e.target.value = ""; // allow re-selecting the same file later
    if (!file) return;
    if (!file.type.startsWith("image/")) {
      setFormError("Veuillez choisir un fichier image (JPEG, PNG...).");
      return;
    }
    if (file.size > MAX_PHOTO_BYTES) {
      setFormError("La photo est trop volumineuse (3 Mo maximum).");
      return;
    }
    try {
      const dataUrl = await compressImage(file);
      setForm((prev) => ({ ...prev, photo: dataUrl }));
      setFormError(null);
    } catch {
      setFormError("Impossible de lire cette image. R\u00E9essayez.");
    }
  };

  const removePhoto = () => setForm((prev) => ({ ...prev, photo: "" }));

  const handleSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    setFormError(null);

    if (!form.fullName || !form.dateOfBirth || !form.section || !form.studentClass || !form.email) {
      setFormError(
        "Veuillez remplir les champs obligatoires : nom complet, date de naissance, classe, section et e-mail."
      );
      return;
    }

    setSaving(true);
    try {
      const payload = {
        registrationNumber: form.registrationNumber || undefined,
        fullName: form.fullName,
        dateOfBirth: form.dateOfBirth,
        gender: form.gender,
        studentClass: form.studentClass,
        section: form.section,
        option: form.option || null,
        nationality: form.nationality || null,
        academicYear: form.academicYear,
        email: form.email,
        phoneNumber: form.phoneNumber || null,
        address: form.address || null,
        photo: form.photo || null,
      };

      const isEdit = !!editingStudent;
      const url = isEdit ? `${API_BASE}/api/students/${editingStudent!.id}` : `${API_BASE}/api/students`;
      const method = isEdit ? "PUT" : "POST";

      const res = await fetch(url, {
        method,
        headers: { "Content-Type": "application/json", ...authHeaders() },
        body: JSON.stringify(isEdit ? { ...payload, active: editingStudent!.active } : payload),
      });

      const data = await res.json();

      if (!res.ok) {
        throw new Error(data?.error || (isEdit ? "\u00C9chec de la mise \u00E0 jour de l'\u00E9l\u00E8ve." : "\u00C9chec de l'ajout de l'\u00E9l\u00E8ve."));
      }

      setBanner(
        isEdit
          ? { type: "success", text: `${data.fullName} a \u00E9t\u00E9 mis(e) \u00E0 jour.` }
          : {
              type: "success",
              text: `${data.fullName} a \u00E9t\u00E9 inscrit(e) avec le matricule ${data.registrationNumber}. Connexion possible avec son e-mail (mot de passe initial : son matricule).`,
            }
      );
      setShowModal(false);
      setEditingStudent(null);
      loadStudents();
    } catch (e) {
      const msg = e instanceof Error ? e.message : "Erreur inattendue.";
      const lower = msg.toLowerCase();
      if (lower.includes("already exists")) {
        if (lower.includes("email")) {
          const m = msg.match(/'([^']+)'/);
          const email = m ? m[1] : "";
          setFormError(
            `L'email ${email ? `"${email}" ` : ""}est d\u00E9j\u00E0 utilis\u00E9 par un autre compte. Veuillez saisir une adresse email diff\u00E9rente.`
          );
        } else if (lower.includes("registration")) {
          setFormError("Ce matricule est d\u00E9j\u00E0 utilis\u00E9. Veuillez saisir un autre matricule.");
        } else {
          setFormError(msg);
        }
      } else {
        setFormError(msg);
      }
    } finally {
      setSaving(false);
    }
  };

  const toggleActive = async (student: Student) => {
    try {
      const res = await fetch(`${API_BASE}/api/students/${student.id}`, {
        method: "PUT",
        headers: { "Content-Type": "application/json", ...authHeaders() },
        body: JSON.stringify({ active: !student.active }),
      });
      if (!res.ok) throw new Error("\u00C9chec de la mise \u00E0 jour du statut.");
      setStudents((prev) => prev.map((s) => (s.id === student.id ? { ...s, active: !s.active } : s)));
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    }
  };

  const deleteStudent = async (student: Student) => {
    if (!window.confirm(`Supprimer ${student.fullName} ? Cette action est irr\u00E9versible.`)) return;
    try {
      const res = await fetch(`${API_BASE}/api/students/${student.id}`, {
        method: "DELETE",
        headers: authHeaders(),
      });
      if (!res.ok && res.status !== 204) throw new Error("\u00C9chec de la suppression.");
      setStudents((prev) => prev.filter((s) => s.id !== student.id));
      setBanner({ type: "success", text: `${student.fullName} a \u00E9t\u00E9 supprim\u00E9(e).` });
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur." });
    }
  };

  const handleExport = async () => {
    try {
      const res = await fetch(`${API_BASE}/api/students/export`, { headers: authHeaders() });
      if (!res.ok) throw new Error("\u00C9chec de l'export.");
      const blob = await res.blob();
      const url = window.URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url;
      a.download = "eleves.csv";
      document.body.appendChild(a);
      a.click();
      a.remove();
      window.URL.revokeObjectURL(url);
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur d'export." });
    }
  };

  const handleImportClick = () => fileInputRef.current?.click();

  const handleImportFile = async (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (!file) return;
    setImporting(true);
    try {
      const formData = new FormData();
      formData.append("file", file);
      const res = await fetch(`${API_BASE}/api/students/import`, {
        method: "POST",
        headers: authHeaders(),
        body: formData,
      });
      const data = await res.json();
      if (!res.ok) throw new Error(data?.error || "\u00C9chec de l'import.");
      const errorCount = data.errors?.length || 0;
      setBanner({
        type: errorCount ? "error" : "success",
        text:
          `${data.imported} \u00E9l\u00E8ve(s) import\u00E9(s).` +
          (errorCount ? ` ${errorCount} ligne(s) en erreur : ${data.errors.slice(0, 3).join(" \u00B7 ")}` : ""),
      });
      loadStudents();
    } catch (e) {
      setBanner({ type: "error", text: e instanceof Error ? e.message : "Erreur d'import." });
    } finally {
      setImporting(false);
      if (fileInputRef.current) fileInputRef.current.value = "";
    }
  };

  return (
    <div className="iemv-eleves">
      <style>{`
        .iemv-eleves {
          --color-panel: #15302A;
          --color-panel-alt: #1D3F35;
          --color-bg: #F6F2E8;
          --color-text: #221F1B;
          --color-text-muted: #6B6357;
          --color-accent: #C8933E;
          --color-border: #E4E8EF;

          font-family: 'IBM Plex Sans', system-ui, sans-serif;
          color: var(--color-text);
          padding: 28px 32px 48px;
          background: var(--color-bg);
          min-height: 100%;
        }

        .iemv-banner {
          margin-bottom: 18px;
          padding: 12px 16px;
          border-radius: 6px;
          font-size: 13.5px;
          line-height: 1.5;
        }
        .iemv-banner.success { background: #E6F4EA; color: #14532D; border: 1px solid #BFE3CA; }
        .iemv-banner.error   { background: #FDECEC; color: #7A2626; border: 1px solid #F3C6C6; }

        .iemv-card {
          background: #fff;
          border: 1px solid var(--color-border);
          border-radius: 10px;
          overflow: hidden;
        }

        .iemv-card-head {
          padding: 22px 24px 18px;
          border-bottom: 1px solid var(--color-border);
        }
        .iemv-card-head h1 { font-size: 19px; font-weight: 700; margin: 0 0 4px; }
        .iemv-card-head p  { font-size: 13px; color: var(--color-text-muted); margin: 0; }

        .iemv-toolbar {
          display: flex;
          flex-wrap: wrap;
          gap: 12px;
          align-items: center;
          justify-content: space-between;
          padding: 16px 24px;
          border-bottom: 1px solid var(--color-border);
        }

        .iemv-search {
          position: relative;
          flex: 1;
          min-width: 220px;
          max-width: 340px;
        }
        .iemv-search svg {
          position: absolute;
          left: 11px; top: 50%;
          transform: translateY(-50%);
          color: var(--color-text-muted);
        }
        .iemv-search input {
          width: 100%; box-sizing: border-box;
          padding: 9px 12px 9px 34px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          outline: none;
          font-family: inherit;
        }
        .iemv-search input:focus-visible { border-color: var(--color-accent); }

        .iemv-select {
          padding: 9px 12px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          background: #fff;
          font-family: inherit;
          color: var(--color-text);
          min-width: 220px;
        }

        .iemv-toolbar-actions { display: flex; gap: 10px; margin-left: auto; }

        .iemv-btn {
          display: inline-flex; align-items: center; gap: 7px;
          padding: 9px 14px;
          font-size: 13.5px;
          font-weight: 600;
          font-family: inherit;
          border-radius: 6px;
          cursor: pointer;
          border: 1px solid var(--color-border);
          background: #fff;
          color: var(--color-text);
          transition: background 0.15s ease, border-color 0.15s ease;
        }
        .iemv-btn:hover:not(:disabled) { border-color: var(--color-panel); }
        .iemv-btn:disabled { opacity: 0.6; cursor: not-allowed; }

        .iemv-btn-primary {
          background: var(--color-panel);
          border-color: var(--color-panel);
          color: #F3EFE3;
        }
        .iemv-btn-primary:hover:not(:disabled) { background: var(--color-panel-alt); }

        table.iemv-table { width: 100%; border-collapse: collapse; font-size: 13.5px; }
        .iemv-table thead th {
          background: #F1F5F9;
          text-align: left;
          padding: 12px 16px;
          font-size: 11.5px;
          font-weight: 600;
          letter-spacing: 0.04em;
          color: #64748B;
          text-transform: uppercase;
          white-space: nowrap;
        }
        .iemv-table tbody td {
          padding: 13px 16px;
          border-top: 1px solid var(--color-border);
          vertical-align: middle;
        }
        .iemv-table tbody tr:hover { background: #FAFAF8; }

        .iemv-matricule { color: var(--color-text-muted); font-size: 12.5px; }
        .iemv-name { font-weight: 600; }
        .iemv-section-cell { color: var(--color-text-muted); font-size: 12.5px; max-width: 220px; }

        .iemv-badge {
          display: inline-block;
          padding: 4px 11px;
          border-radius: 999px;
          font-size: 12.5px;
          font-weight: 600;
        }
        .iemv-badge.active    { background: #E6F4EA; color: #14532D; }
        .iemv-badge.suspended { background: #FDECEC; color: #9B2C2C; }

        .iemv-row-actions { display: flex; gap: 6px; justify-content: flex-end; }
        .iemv-icon-btn {
          background: none; border: none; cursor: pointer;
          color: var(--color-text-muted);
          padding: 6px; border-radius: 5px; display: inline-flex;
        }
        .iemv-icon-btn:hover { background: #F1F5F9; color: var(--color-text); }
        .iemv-icon-btn.danger:hover { background: #FDECEC; color: #9B2C2C; }

        .iemv-avatar {
          width: 36px; height: 36px;
          border-radius: 50%;
          overflow: hidden;
          background: var(--color-panel);
          color: #F3EFE3;
          display: flex; align-items: center; justify-content: center;
          font-size: 12px; font-weight: 700;
          flex-shrink: 0;
        }
        .iemv-avatar img { width: 100%; height: 100%; object-fit: cover; display: block; }

        .iemv-empty {
          padding: 48px 24px;
          text-align: center;
          color: var(--color-text-muted);
          font-size: 13.5px;
        }

        .iemv-modal-overlay {
          position: fixed;
          inset: 0;
          background: rgba(21, 20, 17, 0.5);
          display: flex; align-items: center; justify-content: center;
          z-index: 50; padding: 20px;
        }
        .iemv-modal {
          background: #fff;
          border-radius: 10px;
          width: 100%;
          max-width: 620px;
          max-height: 90vh;
          overflow-y: auto;
        }
        .iemv-modal-head {
          display: flex; align-items: center; justify-content: space-between;
          padding: 20px 24px;
          border-bottom: 1px solid var(--color-border);
        }
        .iemv-modal-head h2 { font-size: 17px; font-weight: 700; margin: 0; }
        .iemv-modal-close {
          background: none; border: none; cursor: pointer;
          color: var(--color-text-muted); padding: 4px;
        }
        .iemv-modal-body { padding: 22px 24px; }

        .iemv-photo-row {
          display: flex;
          align-items: center;
          gap: 16px;
          margin-bottom: 18px;
          padding-bottom: 18px;
          border-bottom: 1px dashed var(--color-border);
        }
        .iemv-photo-preview {
          width: 76px; height: 76px;
          border-radius: 50%;
          overflow: hidden;
          background: #F1F5F9;
          border: 1px solid var(--color-border);
          display: flex; align-items: center; justify-content: center;
          color: var(--color-text-muted);
          flex-shrink: 0;
        }
        .iemv-photo-preview img { width: 100%; height: 100%; object-fit: cover; display: block; }
        .iemv-photo-actions { display: flex; flex-wrap: wrap; gap: 8px; }
        .iemv-photo-actions .iemv-btn { padding: 7px 12px; font-size: 12.5px; }

        .iemv-form-grid {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 14px 16px;
        }
        .iemv-form-grid .span-2 { grid-column: 1 / -1; }

        .iemv-field { display: flex; flex-direction: column; gap: 6px; }
        .iemv-field label { font-size: 12.5px; font-weight: 600; color: var(--color-text); }
        .iemv-field .optional { font-weight: 400; color: var(--color-text-muted); }
        .iemv-field input, .iemv-field select {
          padding: 9px 11px;
          font-size: 13.5px;
          border: 1px solid var(--color-border);
          border-radius: 6px;
          font-family: inherit;
          outline: none;
        }
        .iemv-field input:focus-visible, .iemv-field select:focus-visible {
          border-color: var(--color-accent);
        }

        .iemv-form-error {
          margin-bottom: 14px;
          padding: 12px 16px;
          background: #FDECEC;
          color: #7A2626;
          border: 1px solid #F3C6C6;
          border-left: 4px solid #B91C1C;
          border-radius: 6px;
          font-size: 13.5px;
          line-height: 1.5;
          font-weight: 500;
        }

        .iemv-modal-foot {
          display: flex; justify-content: flex-end; gap: 10px;
          padding: 16px 24px;
          border-top: 1px solid var(--color-border);
        }

        .spin { animation: iemv-spin 0.9s linear infinite; }
        @keyframes iemv-spin { to { transform: rotate(360deg); } }

        @media (max-width: 720px) {
          .iemv-eleves { padding: 18px; }
          .iemv-toolbar { flex-direction: column; align-items: stretch; }
          .iemv-toolbar-actions { margin-left: 0; flex-wrap: wrap; }
          .iemv-search { max-width: none; }
          .iemv-form-grid { grid-template-columns: 1fr; }
        }
      `}</style>

      {banner && <div className={`iemv-banner ${banner.type}`}>{banner.text}</div>}

      <div className="iemv-card">
        <div className="iemv-card-head">
          <h1>{"Liste des \u00E9l\u00E8ves"}</h1>
          <p>{"Ann\u00E9e"} scolaire {currentAcademicYearLabel()}</p>
        </div>

        <div className="iemv-toolbar">
          <div className="iemv-search">
            <Search size={15} />
            <input
              type="text"
              placeholder={"Rechercher par nom, matricule ou e-mail\u2026"}
              value={search}
              onChange={(e) => setSearch(e.target.value)}
            />
          </div>

          <select
            className="iemv-select"
            value={sectionFilter}
            onChange={(e) => setSectionFilter(e.target.value)}
          >
            <option value="">Toutes les sections</option>
            {sections.map((s) => (
              <option key={s.value} value={s.value}>
                {s.displayName}
              </option>
            ))}
          </select>

          <div className="iemv-toolbar-actions">
            <input
              ref={fileInputRef}
              type="file"
              accept=".csv"
              style={{ display: "none" }}
              onChange={handleImportFile}
            />
            <button className="iemv-btn" onClick={handleImportClick} disabled={importing}>
              {importing ? <Loader2 size={15} className="spin" /> : <Upload size={15} />}
              Importer
            </button>
            <button className="iemv-btn" onClick={handleExport}>
              <Download size={15} />
              Exporter
            </button>
            <button className="iemv-btn iemv-btn-primary" onClick={openAddModal}>
              <Plus size={15} />
              {"Ajouter un \u00E9l\u00E8ve"}
            </button>
          </div>
        </div>

        {loading ? (
          <div className="iemv-empty">{"Chargement\u2026"}</div>
        ) : filtered.length === 0 ? (
          <div className="iemv-empty">
            {"Aucun \u00E9l\u00E8ve ne correspond \u00E0 votre recherche."}
          </div>
        ) : (
          <div style={{ overflowX: "auto" }}>
            <table className="iemv-table">
              <thead>
                <tr>
                  <th></th>
                  <th>Matricule</th>
                  <th>Nom complet</th>
                  <th>Classe</th>
                  <th>Section</th>
                  <th>{"Nationalit\u00E9"}</th>
                  <th>Sexe</th>
                  <th>{"T\u00E9l\u00E9phone"}</th>
                  <th>Statut</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((s) => (
                  <tr key={s.id}>
                    <td>
                      <div className="iemv-avatar">
                        {s.photo ? <img src={s.photo} alt={s.fullName} /> : initialsOf(s.fullName)}
                      </div>
                    </td>
                    <td className="iemv-matricule">{s.registrationNumber}</td>
                    <td className="iemv-name">{s.fullName}</td>
                    <td>{s.studentClass || "\u2014"}</td>
                    <td className="iemv-section-cell">{sectionLabel(s.section)}</td>
                    <td>{s.nationality || "\u2014"}</td>
                    <td>{s.gender || "\u2014"}</td>
                    <td>{s.phoneNumber || s.phone || "\u2014"}</td>
                    <td>
                      <span className={`iemv-badge ${s.active ? "active" : "suspended"}`}>
                        {s.active ? "Actif" : "Suspendu"}
                      </span>
                    </td>
                    <td>
                      <div className="iemv-row-actions">
                        <button
                          className="iemv-icon-btn"
                          title="Modifier"
                          onClick={() => openEditModal(s)}
                        >
                          <Pencil size={15} />
                        </button>
                        <button
                          className="iemv-icon-btn"
                          title={s.active ? "Suspendre" : "R\u00E9activer"}
                          onClick={() => toggleActive(s)}
                        >
                          <Power size={15} />
                        </button>
                        <button
                          className="iemv-icon-btn danger"
                          title="Supprimer"
                          onClick={() => deleteStudent(s)}
                        >
                          <Trash2 size={15} />
                        </button>
                      </div>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {showModal && (
        <div className="iemv-modal-overlay" onClick={closeModal}>
          <div className="iemv-modal" onClick={(e) => e.stopPropagation()}>
            <div className="iemv-modal-head">
              <h2>{editingStudent ? "Modifier l'\u00E9l\u00E8ve" : "Ajouter un \u00E9l\u00E8ve"}</h2>
              <button className="iemv-modal-close" onClick={closeModal}>
                <X size={18} />
              </button>
            </div>

            <form onSubmit={handleSubmit}>
              <div className="iemv-modal-body">
                {formError && <div className="iemv-form-error">{formError}</div>}

                {/* Photo capture / import */}
                <div className="iemv-photo-row">
                  <div className="iemv-photo-preview">
                    {form.photo ? (
                      <img src={form.photo} alt="Photo de l'\u00E9l\u00E8ve" />
                    ) : (
                      <UserRound size={30} />
                    )}
                  </div>
                  <div className="iemv-photo-actions">
                    <input
                      ref={cameraInputRef}
                      type="file"
                      accept="image/*"
                      capture="user"
                      style={{ display: "none" }}
                      onChange={handlePhotoFile}
                    />
                    <input
                      ref={importPhotoInputRef}
                      type="file"
                      accept="image/*"
                      style={{ display: "none" }}
                      onChange={handlePhotoFile}
                    />
                    <button
                      type="button"
                      className="iemv-btn"
                      onClick={() => cameraInputRef.current?.click()}
                    >
                      <Camera size={14} /> Prendre une photo
                    </button>
                    <button
                      type="button"
                      className="iemv-btn"
                      onClick={() => importPhotoInputRef.current?.click()}
                    >
                      <ImagePlus size={14} /> Importer
                    </button>
                    {form.photo && (
                      <button type="button" className="iemv-btn" onClick={removePhoto}>
                        <X size={14} /> Retirer
                      </button>
                    )}
                  </div>
                </div>

                <div className="iemv-form-grid">
                  <div className="iemv-field">
                    <label>Nom complet</label>
                    <input
                      type="text"
                      value={form.fullName}
                      onChange={(e) => handleFormChange("fullName", e.target.value)}
                      placeholder={"Ex. A\u00EFcha Mbayo"}
                      required
                    />
                  </div>
                  <div className="iemv-field">
                    <label>Date de naissance</label>
                    <input
                      type="date"
                      value={form.dateOfBirth}
                      onChange={(e) => handleFormChange("dateOfBirth", e.target.value)}
                      required
                    />
                  </div>

                  <div className="iemv-field">
                    <label>Sexe</label>
                    <select
                      value={form.gender}
                      onChange={(e) => handleFormChange("gender", e.target.value)}
                    >
                      <option value={"F\u00E9minin"}>{"F\u00E9minin"}</option>
                      <option value="Masculin">Masculin</option>
                    </select>
                  </div>
                  <div className="iemv-field">
                    <label>Classe</label>
                    <select
                      value={form.studentClass}
                      onChange={(e) => handleFormChange("studentClass", e.target.value)}
                      required
                    >
                      <option value="">{"S\u00E9lectionner une classe\u2026"}</option>
                      <option value={"1\u00E8re"}>{"1\u00E8re ann\u00E9e"}</option>
                      <option value={"2\u00E8me"}>{"2\u00E8me ann\u00E9e"}</option>
                      <option value={"3\u00E8me"}>{"3\u00E8me ann\u00E9e"}</option>
                      <option value={"4\u00E8me"}>{"4\u00E8me ann\u00E9e"}</option>
                    </select>
                  </div>

                  <div className="iemv-field span-2">
                    <label>Section</label>
                    <select
                      value={form.section}
                      onChange={(e) => handleFormChange("section", e.target.value)}
                      required
                    >
                      <option value="">{"S\u00E9lectionner une section\u2026"}</option>
                      {sections.map((s) => (
                        <option key={s.value} value={s.value}>
                          {s.displayName}
                        </option>
                      ))}
                    </select>
                  </div>

                  <div className="iemv-field">
                    <label>
                      Option <span className="optional">(facultatif)</span>
                    </label>
                    <input
                      type="text"
                      value={form.option}
                      onChange={(e) => handleFormChange("option", e.target.value)}
                      placeholder="Ex. Jour, Soir, Promotion 2"
                    />
                  </div>
                  <div className="iemv-field">
                    <label>{"Nationalit\u00E9"}</label>
                    <input
                      type="text"
                      value={form.nationality}
                      onChange={(e) => handleFormChange("nationality", e.target.value)}
                      placeholder="Ex. Congolaise (RDC)"
                    />
                  </div>

                  <div className="iemv-field">
                    <label>{"Ann\u00E9e acad\u00E9mique"}</label>
                    <input
                      type="text"
                      value={form.academicYear}
                      onChange={(e) => handleFormChange("academicYear", e.target.value)}
                    />
                  </div>
                  <div className="iemv-field">
                    <label>{"E-mail de l'\u00E9l\u00E8ve"}</label>
                    <input
                      type="email"
                      value={form.email}
                      onChange={(e) => handleFormChange("email", e.target.value)}
                      placeholder="eleve@iemv.edu.cd"
                      required
                    />
                  </div>

                  <div className="iemv-field">
                    <label>{"T\u00E9l\u00E9phone"}</label>
                    <input
                      type="text"
                      value={form.phoneNumber}
                      onChange={(e) => handleFormChange("phoneNumber", e.target.value)}
                      placeholder={"+243\u2026"}
                    />
                  </div>
                  <div className="iemv-field">
                    <label>
                      Matricule <span className="optional">(auto si vide)</span>
                    </label>
                    <input
                      type="text"
                      value={form.registrationNumber}
                      onChange={(e) => handleFormChange("registrationNumber", e.target.value)}
                      placeholder="Ex. ELV-2401"
                      disabled={!!editingStudent}
                    />
                  </div>

                  <div className="iemv-field span-2">
                    <label>
                      Adresse <span className="optional">(facultatif)</span>
                    </label>
                    <input
                      type="text"
                      value={form.address}
                      onChange={(e) => handleFormChange("address", e.target.value)}
                    />
                  </div>
                </div>
              </div>

              <div className="iemv-modal-foot">
                <button
                  type="button"
                  className="iemv-btn"
                  onClick={closeModal}
                  disabled={saving}
                >
                  Annuler
                </button>
                <button
                  type="submit"
                  className="iemv-btn iemv-btn-primary"
                  disabled={saving}
                >
                  {saving ? <Loader2 size={15} className="spin" /> : <Plus size={15} />}
                  {saving
                    ? "Enregistrement\u2026"
                    : editingStudent
                    ? "Mettre \u00E0 jour"
                    : "Enregistrer l'\u00E9l\u00E8ve"}
                </button>
              </div>
            </form>
          </div>
        </div>
      )}
    </div>
  );
}