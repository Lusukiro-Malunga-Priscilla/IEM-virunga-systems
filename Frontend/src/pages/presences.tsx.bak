import React from 'react';

export default function Presences() {
  const rows = [
    { id: 1, student: 'Jean Dupont', date: '2026-09-01', status: 'Présent' },
    { id: 2, student: 'Marie Curie', date: '2026-09-01', status: 'Absent' },
  ];

  return (
    <div>
      <h1 style={{ fontSize: 20, marginBottom: 6 }}>Présences</h1>
      <p style={{ color: '#64748b', marginBottom: 12 }}>Journal de présence — filtrez par date ou classe.</p>

      <div style={{ overflowX: 'auto' }}>
        <table style={{ width: '100%', borderCollapse: 'collapse' }}>
          <thead style={{ background: '#f1f5f9' }}>
            <tr>
              <th style={{ padding: 12 }}>#</th>
              <th style={{ padding: 12 }}>Élève</th>
              <th style={{ padding: 12 }}>Date</th>
              <th style={{ padding: 12 }}>Statut</th>
            </tr>
          </thead>
          <tbody>
            {rows.map(r => (
              <tr key={r.id} style={{ borderBottom: '1px solid #eef2f7' }}>
                <td style={{ padding: 12 }}>{r.id}</td>
                <td style={{ padding: 12 }}>{r.student}</td>
                <td style={{ padding: 12 }}>{r.date}</td>
                <td style={{ padding: 12 }}>{r.status}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  );
}
