package com.iem.backend.service;

import com.iem.backend.model.Role;
import com.iem.backend.model.Section;
import com.iem.backend.model.Student;
import com.iem.backend.model.UserAccount;
import com.iem.backend.repository.StudentRepository;
import com.iem.backend.repository.UserAccountRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.security.crypto.password.PasswordEncoder;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import org.springframework.web.multipart.MultipartFile;

import java.io.BufferedReader;
import java.io.IOException;
import java.io.InputStreamReader;
import java.nio.charset.StandardCharsets;
import java.time.LocalDate;
import java.time.Year;
import java.util.ArrayList;
import java.util.List;
import java.util.Optional;

/**
 * NOTE: This file only changes the update() method compared to the previous
 * version, to also persist the new `nationality` and `photo` fields.
 * Everything else (save/create, matricule generation, CSV import/export,
 * deactivate) is unchanged.
 *
 * Prerequisite: add `nationality` (String) and `photo` (String, e.g. a
 * TEXT/LONGTEXT column since it stores a base64 data URL) to Student.java,
 * with getters/setters getNationality()/setNationality() and
 * getPhoto()/setPhoto(). See STUDENT_TEACHER_MODEL_CHANGES.md.
 */
@Service
public class StudentService {

    private static final Logger logger = LoggerFactory.getLogger(StudentService.class);

    private final StudentRepository studentRepository;
    private final UserAccountRepository userAccountRepository;
    private final PasswordEncoder passwordEncoder;
    private final EmailService emailService;

    public StudentService(StudentRepository studentRepository,
                          UserAccountRepository userAccountRepository,
                          PasswordEncoder passwordEncoder,
                          EmailService emailService) {
        this.studentRepository = studentRepository;
        this.userAccountRepository = userAccountRepository;
        this.passwordEncoder = passwordEncoder;
        this.emailService = emailService;
    }

    //  READ 

    public List<Student> findAll() {
        return studentRepository.findAll();
    }

    public Optional<Student> findById(Long id) {
        return studentRepository.findById(id);
    }

    public Optional<Student> findByEmail(String email) {
        return studentRepository.findByEmail(email);
    }

    public Optional<Student> findByRegistrationNumber(String registrationNumber) {
        return studentRepository.findByRegistrationNumber(registrationNumber);
    }

    public List<Student> findBySection(Section section) {
        return studentRepository.findBySection(section);
    }

    public long countBySection(Section section) {
        return studentRepository.countBySection(section);
    }

    public long countStudents() {
        return studentRepository.count();
    }

    public List<Student> findByClassName(String className) {
        return studentRepository.findByStudentClass(className);
    }

    public List<Student> searchByName(String name) {
        return studentRepository.searchByName(name);
    }

    //  CREATE 

    @Transactional
    public Student save(Student student) {
        logger.info(">>> ENTERED StudentService.save() for email={}", student.getEmail());

        // 1. Generate matricule if missing
        if (student.getRegistrationNumber() == null || student.getRegistrationNumber().isEmpty()) {
            student.setRegistrationNumber(generateRegistrationNumber(student.getAcademicYear()));
            logger.info(">>> Generated registrationNumber={}", student.getRegistrationNumber());
        }

        // 2. Validate required fields
        if (student.getRegistrationNumber() == null || student.getRegistrationNumber().isEmpty()) {
            throw new IllegalArgumentException("Registration number is required.");
        }
        if (student.getFullName() == null || student.getFullName().isEmpty()) {
            throw new IllegalArgumentException("Full name is required.");
        }
        if (student.getEmail() == null || student.getEmail().isEmpty()) {
            throw new IllegalArgumentException("Email is required.");
        }
        if (student.getSection() == null) {
            throw new IllegalArgumentException("Section is required. Please select a section.");
        }

        if (student.getEnrollmentStatus() == null || student.getEnrollmentStatus().isEmpty()) {
            student.setEnrollmentStatus("PENDING");
        }
        student.setActive(true);

        // 3. Ensure a UserAccount exists for this student
        String normalizedEmail = student.getEmail().trim().toLowerCase();
        logger.info(">>> Checking userAccountRepository for {}", normalizedEmail);
        Optional<UserAccount> existing = userAccountRepository.findByEmail(normalizedEmail);

        UserAccount account;
        boolean isNewAccount = false;
        String initialPassword = student.getRegistrationNumber();

        if (existing.isPresent()) {
            account = existing.get();
            logger.info(">>> REUSING existing UserAccount id={}", account.getId());
        } else {
            account = new UserAccount();
            account.setUsername(normalizedEmail);
            account.setEmail(normalizedEmail);
            account.setPassword(passwordEncoder.encode(initialPassword));
            account.setRole(Role.STUDENT);
            account.setEnabled(true);
            account = userAccountRepository.save(account);
            isNewAccount = true;
            logger.info(">>> CREATED new UserAccount id={} with role STUDENT for {}",
                    account.getId(), normalizedEmail);
        }
        student.setUserAccountId(account.getId());

        // 4. Save the student
        Student saved = studentRepository.save(student);
        logger.info(">>> Student saved with id={} and registrationNumber={}",
                saved.getId(), saved.getRegistrationNumber());

        // 5. Send the welcome email with the login password
        logger.info(">>> About to check isNewAccount={} for email={}", isNewAccount, normalizedEmail);
        if (isNewAccount) {
            logger.info(">>> CALLING emailService.sendRegistrationConfirmation for {} with password={}",
                    normalizedEmail, initialPassword);
            try {
                emailService.sendRegistrationConfirmation(
                        normalizedEmail,
                        saved.getFullName(),
                        saved.getRegistrationNumber(),
                        initialPassword
                );
                logger.info(">>> emailService.sendRegistrationConfirmation RETURNED OK for {}",
                        normalizedEmail);
            } catch (Exception e) {
                logger.error(">>> emailService.sendRegistrationConfirmation THREW for {}: {}",
                        normalizedEmail, e.getMessage(), e);
            }
        } else {
            logger.info(">>> SKIPPING email  account already existed for {}", normalizedEmail);
        }

        logger.info(">>> EXITING StudentService.save() for email={}", normalizedEmail);
        return saved;
    }

    //  UPDATE 

    @Transactional
    public Student update(Long id, Student update) {
        Student existing = studentRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with id: " + id));

        if (update.getRegistrationNumber() != null) existing.setRegistrationNumber(update.getRegistrationNumber());
        if (update.getFullName() != null)          existing.setFullName(update.getFullName());
        if (update.getPhone() != null)             existing.setPhone(update.getPhone());
        if (update.getPhoneNumber() != null)       existing.setPhoneNumber(update.getPhoneNumber());
        if (update.getAddress() != null)           existing.setAddress(update.getAddress());
        if (update.getStudentClass() != null)      existing.setStudentClass(update.getStudentClass());
        if (update.getEnrollmentStatus() != null)  existing.setEnrollmentStatus(update.getEnrollmentStatus());
        if (update.getGender() != null)            existing.setGender(update.getGender());
        if (update.getDateOfBirth() != null)       existing.setDateOfBirth(update.getDateOfBirth());
        if (update.getParentName() != null)        existing.setParentName(update.getParentName());
        if (update.getParentPhoneNumber() != null) existing.setParentPhoneNumber(update.getParentPhoneNumber());
        if (update.getParentEmail() != null)       existing.setParentEmail(update.getParentEmail());
        if (update.getSection() != null)           existing.setSection(update.getSection());
        if (update.getOption() != null)            existing.setOption(update.getOption());
        if (update.getAcademicYear() != null)      existing.setAcademicYear(update.getAcademicYear());
        // NEW: nationality and photo
        if (update.getNationality() != null)       existing.setNationality(update.getNationality());
        if (update.getPhoto() != null)              existing.setPhoto(update.getPhoto());
        existing.setActive(update.isActive());

        // If the email changed, keep the UserAccount in sync
        if (update.getEmail() != null && !update.getEmail().equalsIgnoreCase(existing.getEmail())) {
            String newEmail = update.getEmail().trim().toLowerCase();
            userAccountRepository.findByEmail(existing.getEmail()).ifPresent(acc -> {
                acc.setUsername(newEmail);
                acc.setEmail(newEmail);
                userAccountRepository.save(acc);
            });
            existing.setEmail(newEmail);
        }

        return studentRepository.save(existing);
    }

    //  DELETE 

    @Transactional
    public void deleteById(Long id) {
        Student student = studentRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with id: " + id));
        if (student.getUserAccountId() != null) {
            userAccountRepository.deleteById(student.getUserAccountId());
        }
        studentRepository.deleteById(id);
    }

    @Transactional
    public Student confirmRegistration(Long id) {
        Student student = studentRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with id: " + id));
        student.setEnrollmentStatus("CONFIRMED");
        return studentRepository.save(student);
    }

    //  MATRICULE 

    public String generateRegistrationNumber(String academicYear) {
        String yearDigits;
        if (academicYear != null && academicYear.length() >= 4) {
            String firstYear = academicYear.replaceAll("[^0-9].*", "");
            yearDigits = firstYear.length() >= 2
                    ? firstYear.substring(firstYear.length() - 2)
                    : firstYear;
        } else {
            yearDigits = String.valueOf(Year.now().getValue()).substring(2);
        }

        String prefix = "ELV-" + yearDigits;
        long countWithPrefix = studentRepository.findAll().stream()
                .filter(s -> s.getRegistrationNumber() != null && s.getRegistrationNumber().startsWith(prefix))
                .count();

        String candidate;
        long seq = countWithPrefix + 1;
        do {
            candidate = prefix + String.format("%02d", seq);
            seq++;
        } while (studentRepository.findByRegistrationNumber(candidate).isPresent());
        return candidate;
    }

    //  CSV EXPORT 

    private static final String CSV_HEADER =
            "Matricule,Nom complet,Date de naissance,Classe,Section,Option,Nationalite,Sexe,Tuteur,Telephone,Email,Statut";

    public String exportToCsv() {
        List<Student> students = studentRepository.findAll();
        StringBuilder sb = new StringBuilder();
        sb.append(CSV_HEADER).append("\n");
        for (Student s : students) {
            sb.append(csvField(s.getRegistrationNumber())).append(",")
              .append(csvField(s.getFullName())).append(",")
              .append(s.getDateOfBirth() != null ? s.getDateOfBirth().toString() : "").append(",")
              .append(csvField(s.getStudentClass())).append(",")
              .append(s.getSection() != null ? csvField(s.getSection().getDisplayName()) : "").append(",")
              .append(csvField(s.getOption())).append(",")
              .append(csvField(s.getNationality())).append(",")
              .append(csvField(s.getGender())).append(",")
              .append(csvField(s.getParentName())).append(",")
              .append(csvField(s.getPhoneNumber() != null ? s.getPhoneNumber() : s.getPhone())).append(",")
              .append(csvField(s.getEmail())).append(",")
              .append(s.isActive() ? "Actif" : "Suspendu").append("\n");
        }
        return sb.toString();
    }

    private String csvField(String value) {
        if (value == null) return "";
        if (value.contains(",") || value.contains("\"") || value.contains("\n")) {
            return "\"" + value.replace("\"", "\"\"") + "\"";
        }
        return value;
    }

    //  CSV IMPORT 
    // NOTE: the CSV format now has an extra "Nationalite" column between
    // Option (index 5) and Sexe (index 6). Update your CSV template/export
    // accordingly; this importer reads it from index 6, shifting the
    // remaining columns by one versus the previous version.

    @Transactional
    public ImportResult importFromCsv(MultipartFile file) throws IOException {
        List<String> errors = new ArrayList<>();
        int imported = 0;

        try (BufferedReader reader = new BufferedReader(
                new InputStreamReader(file.getInputStream(), StandardCharsets.UTF_8))) {
            String line;
            boolean first = true;
            int rowNum = 1;
            while ((line = reader.readLine()) != null) {
                rowNum++;
                if (first) { first = false; continue; }
                if (line.trim().isEmpty()) continue;

                String[] cols = parseCsvLine(line);
                try {
                    Student s = new Student();
                    s.setRegistrationNumber(col(cols, 0));
                    s.setFullName(col(cols, 1));
                    String dob = col(cols, 2);
                    if (dob != null && !dob.isEmpty()) s.setDateOfBirth(LocalDate.parse(dob));
                    s.setStudentClass(col(cols, 3));
                    String sectionValue = col(cols, 4);
                    if (sectionValue != null && !sectionValue.isEmpty()) {
                        s.setSection(resolveSection(sectionValue));
                    }
                    s.setOption(col(cols, 5));
                    s.setNationality(col(cols, 6));
                    s.setGender(col(cols, 7));
                    s.setParentName(col(cols, 8));
                    s.setPhoneNumber(col(cols, 9));
                    s.setEmail(col(cols, 10));
                    save(s);
                    imported++;
                } catch (Exception ex) {
                    errors.add("Ligne " + rowNum + ": " + ex.getMessage());
                }
            }
        }
        return new ImportResult(imported, errors);
    }

    private String col(String[] cols, int i) {
        return i < cols.length ? cols[i].trim() : null;
    }

    private Section resolveSection(String value) {
        for (Section sec : Section.values()) {
            if (sec.name().equalsIgnoreCase(value) || sec.getDisplayName().equalsIgnoreCase(value)) {
                return sec;
            }
        }
        throw new IllegalArgumentException("Section inconnue: " + value);
    }

    private String[] parseCsvLine(String line) {
        List<String> result = new ArrayList<>();
        StringBuilder cur = new StringBuilder();
        boolean inQuotes = false;
        for (int i = 0; i < line.length(); i++) {
            char c = line.charAt(i);
            if (c == '"') inQuotes = !inQuotes;
            else if (c == ',' && !inQuotes) { result.add(cur.toString()); cur.setLength(0); }
            else cur.append(c);
        }
        result.add(cur.toString());
        return result.toArray(new String[0]);
    }

    public static class ImportResult {
        public final int imported;
        public final List<String> errors;
        public ImportResult(int imported, List<String> errors) {
            this.imported = imported;
            this.errors = errors;
        }
    }

    @Transactional
    public void deactivate(Long id) {
        Student s = studentRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Student not found with id: " + id));
        s.setActive(false);
        studentRepository.save(s);
    }

    /**
     * Dashboard summary for the currently authenticated student.
     * Looks up the student by the login identifier (username or email)
     * and returns a small map with the fields the frontend needs.
     */
    public java.util.Map<String, Object> getDashboardForUsername(String usernameOrEmail) {
        java.util.Map<String, Object> result = new java.util.HashMap<>();
        if (usernameOrEmail == null) {
            result.put("student", null);
            return result;
        }

        String key = usernameOrEmail.trim().toLowerCase();

        java.util.Optional<Student> found = studentRepository.findByEmail(key);
        if (found.isEmpty()) {
            // fall back: match by full name or any other identifier you have
            found = studentRepository.findAll().stream()
                    .filter(s -> key.equalsIgnoreCase(s.getEmail())
                              || key.equalsIgnoreCase(s.getFullName()))
                    .findFirst();
        }

        if (found.isEmpty()) {
            result.put("student", null);
            return result;
        }

        Student s = found.get();
        java.util.Map<String, Object> student = new java.util.HashMap<>();
        student.put("id", s.getId());
        student.put("registrationNumber", s.getRegistrationNumber());
        student.put("fullName", s.getFullName());
        student.put("email", s.getEmail());
        student.put("studentClass", s.getStudentClass());
        student.put("section", s.getSection() != null ? s.getSection().name() : null);
        student.put("option", s.getOption());
        student.put("nationality", s.getNationality());
        student.put("photo", s.getPhoto());
        student.put("enrollmentStatus", s.getEnrollmentStatus());
        student.put("active", s.isActive());

        result.put("student", student);
        return result;
    }
}
