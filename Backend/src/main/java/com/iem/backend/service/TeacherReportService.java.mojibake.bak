package com.iem.backend.service;

import com.iem.backend.dto.TeacherReportRequest;
import com.iem.backend.dto.TeacherReportResponse;
import com.iem.backend.model.Teacher;
import com.iem.backend.model.TeacherReport;
import com.iem.backend.repository.TeacherReportRepository;
import com.iem.backend.repository.TeacherRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;
import java.util.List;
import java.util.Optional;

@Service
public class TeacherReportService {

    private static final Logger log = LoggerFactory.getLogger(TeacherReportService.class);

    private final TeacherReportRepository repo;
    private final TeacherRepository teacherRepo;
    private final EmailService emailService;

    @Value("${iem.notifications.report-recipients:iemvirunga96@gmail.com}")
    private String reportRecipients;

    @Value("${iem.notifications.reports-enabled:true}")
    private boolean reportsEnabled;

    public TeacherReportService(TeacherReportRepository repo,
                                TeacherRepository teacherRepo,
                                EmailService emailService) {
        this.repo = repo;
        this.teacherRepo = teacherRepo;
        this.emailService = emailService;
    }

    @Transactional
    public TeacherReportResponse upsert(Long teacherId, TeacherReportRequest req) {
        Teacher teacher = teacherRepo.findById(teacherId)
                .orElseThrow(() -> new RuntimeException("Teacher not found: " + teacherId));

        LocalDate date = (req.reportDate != null) ? req.reportDate : LocalDate.now();
        if (date.isAfter(LocalDate.now())) {
            throw new RuntimeException("Report date cannot be in the future");
        }

        boolean isNew = false;
        TeacherReport report = repo.findByTeacherIdAndReportDate(teacherId, date).orElse(null);
        if (report == null) {
            report = new TeacherReport();
            report.setTeacher(teacher);
            report.setReportDate(date);
            isNew = true;
        }

        report.setSummary(req.summary);
        report.setClassesTaught(req.classesTaught);
        report.setHoursWorked(req.hoursWorked);
        report.setIssues(req.issues);
        report.setAchievements(req.achievements);
        report.setStatus("SUBMITTED");

        TeacherReport saved = repo.save(report);

        // Notify admins only on FIRST submit of the day (not on same-day edit)
        if (isNew) {
            try {
                notifyAdmins(teacher, saved);
            } catch (Exception e) {
                log.warn("Report email notification failed: {}", e.getMessage(), e);
            }
        }

        return TeacherReportResponse.from(saved);
    }

    private void notifyAdmins(Teacher teacher, TeacherReport r) {
        if (!reportsEnabled) {
            log.info("Report email disabled by config");
            return;
        }
        if (reportRecipients == null || reportRecipients.isBlank()) return;

        String teacherName = ((teacher.getPrenom() == null ? "" : teacher.getPrenom())
                + " " + (teacher.getNom() == null ? "" : teacher.getNom())).trim();
        if (teacherName.isEmpty()) teacherName = "Enseignant #" + teacher.getId();

        String subject = "[IEM] Rapport journalier - " + teacherName + " - " + r.getReportDate();

        StringBuilder body = new StringBuilder();
        body.append("Nouveau rapport journalier soumis\n");
        body.append("=====================================\n\n");
        body.append("Enseignant : ").append(teacherName).append("\n");
        body.append("Email      : ").append(teacher.getEmail() == null ? "—" : teacher.getEmail()).append("\n");
        body.append("Date       : ").append(r.getReportDate()).append("\n");
        if (r.getHoursWorked() != null)
            body.append("Heures     : ").append(r.getHoursWorked()).append(" h\n");
        if (r.getClassesTaught() != null && !r.getClassesTaught().isBlank())
            body.append("Classes    : ").append(r.getClassesTaught()).append("\n");
        body.append("\n----- Résumé des activités -----\n");
        body.append(r.getSummary() == null ? "—" : r.getSummary()).append("\n");
        if (r.getIssues() != null && !r.getIssues().isBlank()) {
            body.append("\n----- Problèmes / blocages -----\n");
            body.append(r.getIssues()).append("\n");
        }
        if (r.getAchievements() != null && !r.getAchievements().isBlank()) {
            body.append("\n----- Réalisations -----\n");
            body.append(r.getAchievements()).append("\n");
        }
        body.append("\n-------------------------------------\n");
        body.append("IEM Virunga — système de gestion\n");
        body.append("Voir tous les rapports : http://localhost:5173/reports\n");

        // Support multiple recipients (comma-separated)
        for (String to : reportRecipients.split(",")) {
            String addr = to.trim();
            if (addr.isEmpty()) continue;
            try {
                emailService.sendSimpleMessage(addr, subject, body.toString());
                log.info("Report email sent to {} for report {}", addr, r.getId());
            } catch (Exception e) {
                log.warn("Failed to send report email to {}: {}", addr, e.getMessage());
            }
        }
    }

    @Transactional(readOnly = true)
    public List<TeacherReportResponse> listForTeacher(Long teacherId) {
        return repo.findByTeacherIdOrderByReportDateDesc(teacherId)
                .stream().map(TeacherReportResponse::from).toList();
    }

    @Transactional(readOnly = true)
    public Optional<TeacherReportResponse> todayForTeacher(Long teacherId) {
        return repo.findByTeacherIdAndReportDate(teacherId, LocalDate.now())
                .map(TeacherReportResponse::from);
    }

    @Transactional(readOnly = true)
    public List<TeacherReportResponse> listAll(Long teacherId, LocalDate from, LocalDate to) {
        List<TeacherReport> rows;
        if (teacherId != null && from != null && to != null) {
            rows = repo.findByTeacherIdAndReportDateBetweenOrderByReportDateDesc(teacherId, from, to);
        } else if (from != null && to != null) {
            rows = repo.findByReportDateBetweenOrderByReportDateDesc(from, to);
        } else {
            rows = repo.findAllByOrderByReportDateDesc();
        }
        return rows.stream().map(TeacherReportResponse::from).toList();
    }

    @Transactional(readOnly = true)
    public TeacherReportResponse getById(Long id) {
        return repo.findById(id).map(TeacherReportResponse::from)
                .orElseThrow(() -> new RuntimeException("Report not found: " + id));
    }

    @Transactional
    public void delete(Long id) { repo.deleteById(id); }

    @Transactional
    public TeacherReportResponse update(Long id, TeacherReportRequest req) {
        TeacherReport r = repo.findById(id)
                .orElseThrow(() -> new RuntimeException("Report not found: " + id));
        if (req.summary != null)       r.setSummary(req.summary);
        if (req.classesTaught != null) r.setClassesTaught(req.classesTaught);
        if (req.hoursWorked != null)   r.setHoursWorked(req.hoursWorked);
        if (req.issues != null)        r.setIssues(req.issues);
        if (req.achievements != null)  r.setAchievements(req.achievements);
        return TeacherReportResponse.from(repo.save(r));
    }
}