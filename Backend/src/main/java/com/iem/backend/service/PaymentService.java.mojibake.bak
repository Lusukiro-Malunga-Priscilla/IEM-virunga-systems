package com.iem.backend.service;

import com.iem.backend.dto.StudentPaymentSummaryDTO;
import com.iem.backend.model.Payment;
import com.iem.backend.model.Student;
import com.iem.backend.repository.PaymentRepository;
import com.iem.backend.repository.StudentRepository;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.time.LocalDate;
import java.util.ArrayList;
import java.util.Comparator;
import java.util.List;
import java.util.Optional;

@Service
public class PaymentService {

    private static final Logger logger = LoggerFactory.getLogger(PaymentService.class);

    private static final String STATUS_PENDING = "PENDING";
    private static final String STATUS_PARTIAL = "PARTIAL";
    private static final String STATUS_PAID = "PAID";

    private final PaymentRepository paymentRepository;
    private final StudentRepository studentRepository;
    private final EmailService emailService;

    public PaymentService(PaymentRepository paymentRepository,
                          StudentRepository studentRepository,
                          EmailService emailService) {
        this.paymentRepository = paymentRepository;
        this.studentRepository = studentRepository;
        this.emailService = emailService;
    }

    public List<Payment> findAll() {
        return paymentRepository.findAll();
    }

    public Optional<Payment> findById(Long id) {
        return paymentRepository.findById(id);
    }

    public List<Payment> findByStudentId(Long studentId) {
        return paymentRepository.findByStudentId(studentId)
                .stream()
                .sorted(Comparator.comparing(Payment::getPaymentDate).thenComparing(Payment::getId))
                .toList();
    }

    public List<Payment> findByStatus(String status) {
        return paymentRepository.findByStatus(status);
    }

    /**
     * The latest payment record for a student represents their current running
     * totals (totalAmount / paidAmount / remainingAmount as of that date).
     */
    private Payment latestPaymentFor(Long studentId) {
        return paymentRepository.findByStudentId(studentId).stream()
                .max(Comparator.comparing(Payment::getPaymentDate).thenComparing(Payment::getId))
                .orElse(null);
    }

    /**
     * One row per student: full annual amount, amount paid so far, amount remaining,
     * current status and the date of their last payment. Feeds the Paiements page table.
     */
    public List<StudentPaymentSummaryDTO> getPaymentSummary() {
        List<Student> students = studentRepository.findAll();
        List<StudentPaymentSummaryDTO> summary = new ArrayList<>();

        for (Student student : students) {
            Payment latest = latestPaymentFor(student.getId());

            StudentPaymentSummaryDTO dto = new StudentPaymentSummaryDTO();
            dto.setStudentId(student.getId());
            dto.setRegistrationNumber(student.getRegistrationNumber());
            dto.setFullName(student.getFullName());
            dto.setStudentClass(student.getStudentClass());
            dto.setSection(student.getSection());

            if (latest != null) {
                dto.setTotalAmount(latest.getTotalAmount());
                dto.setPaidAmount(latest.getPaidAmount());
                dto.setRemainingAmount(latest.getRemainingAmount());
                dto.setStatus(latest.getStatus());
                dto.setLastPaymentDate(latest.getPaymentDate() != null ? latest.getPaymentDate().toString() : null);
            } else {
                dto.setTotalAmount(0.0);
                dto.setPaidAmount(0.0);
                dto.setRemainingAmount(0.0);
                dto.setStatus(STATUS_PENDING);
                dto.setLastPaymentDate(null);
            }

            summary.add(dto);
        }

        return summary;
    }

    /**
     * Registers a new installment for a student. Amount is added on top of what
     * they've already paid (cumulative), remaining is recomputed, and a confirmation
     * email is fired automatically the moment the balance reaches zero.
     */
    @Transactional
    public Payment addPayment(Long studentId, Double amount, Double totalAmountOverride) {
        Student student = studentRepository.findById(studentId)
                .orElseThrow(() -> new RuntimeException("Élève introuvable."));

        Payment latest = latestPaymentFor(studentId);

        double previousTotal = latest != null && latest.getTotalAmount() != null ? latest.getTotalAmount() : 0.0;
        double previousPaid = latest != null && latest.getPaidAmount() != null ? latest.getPaidAmount() : 0.0;
        String previousStatus = latest != null && latest.getStatus() != null ? latest.getStatus() : STATUS_PENDING;

        double newTotal = totalAmountOverride != null ? totalAmountOverride : previousTotal;
        if (newTotal <= 0) {
            throw new RuntimeException(
                    "Le montant annuel total doit être renseigné avant d'enregistrer un premier paiement.");
        }

        double installment = amount != null ? amount : 0.0;
        double newPaid = previousPaid + installment;
        if (newPaid > newTotal) {
            newPaid = newTotal; // never let paid exceed the annual total
        }
        double newRemaining = newTotal - newPaid;
        if (newRemaining < 0) {
            newRemaining = 0.0;
        }

        String newStatus;
        if (newRemaining <= 0) {
            newStatus = STATUS_PAID;
        } else if (newPaid > 0) {
            newStatus = STATUS_PARTIAL;
        } else {
            newStatus = STATUS_PENDING;
        }

        Payment payment = new Payment();
        payment.setStudent(student);
        payment.setTotalAmount(newTotal);
        payment.setPaidAmount(newPaid);
        payment.setRemainingAmount(newRemaining);
        payment.setPaymentDate(LocalDate.now());
        payment.setStatus(newStatus);

        Payment saved = paymentRepository.save(payment);

        boolean justCompleted = STATUS_PAID.equals(newStatus) && !STATUS_PAID.equals(previousStatus);
        if (justCompleted && student.getEmail() != null && !student.getEmail().isBlank()) {
            try {
                emailService.sendPaymentConfirmation(
                        student.getEmail(),
                        student.getFullName(),
                        newPaid,
                        newRemaining,
                        newTotal
                );
            } catch (Exception e) {
                // A failed email must never roll back the payment that was already recorded.
                logger.error("Échec de l'envoi de l'email de confirmation de paiement pour {} ({}): {}",
                        student.getFullName(), student.getEmail(), e.getMessage(), e);
            }
        }

        return saved;
    }

    @Transactional
    public Payment save(Payment payment) {
        if (payment.getStudent() != null && payment.getStudent().getId() != null) {
            Student student = studentRepository.findById(payment.getStudent().getId())
                    .orElseThrow(() -> new RuntimeException("Student not found"));
            payment.setStudent(student);
        }

        if (payment.getTotalAmount() != null && payment.getPaidAmount() != null) {
            payment.setRemainingAmount(payment.getTotalAmount() - payment.getPaidAmount());

            if (payment.getRemainingAmount() <= 0) {
                payment.setStatus(STATUS_PAID);
            } else if (payment.getPaidAmount() > 0) {
                payment.setStatus(STATUS_PARTIAL);
            } else {
                payment.setStatus(STATUS_PENDING);
            }
        }

        if (payment.getPaymentDate() == null) {
            payment.setPaymentDate(LocalDate.now());
        }

        return paymentRepository.save(payment);
    }

    @Transactional
    public Payment update(Long id, Payment paymentDetails) {
        Payment existingPayment = paymentRepository.findById(id)
                .orElseThrow(() -> new RuntimeException("Payment not found"));

        if (paymentDetails.getPaidAmount() != null) {
            existingPayment.setPaidAmount(paymentDetails.getPaidAmount());
        }
        if (paymentDetails.getTotalAmount() != null) {
            existingPayment.setTotalAmount(paymentDetails.getTotalAmount());
        }
        if (paymentDetails.getPaymentDate() != null) {
            existingPayment.setPaymentDate(paymentDetails.getPaymentDate());
        }
        if (paymentDetails.getStatus() != null) {
            existingPayment.setStatus(paymentDetails.getStatus());
        }

        if (existingPayment.getTotalAmount() != null && existingPayment.getPaidAmount() != null) {
            existingPayment.setRemainingAmount(existingPayment.getTotalAmount() - existingPayment.getPaidAmount());
        }

        return paymentRepository.save(existingPayment);
    }

    @Transactional
    public void deleteById(Long id) {
        paymentRepository.deleteById(id);
    }
}