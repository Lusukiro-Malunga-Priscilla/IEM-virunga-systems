    }

    // ---------------------------------------------------------------
    // Teacher attendance: classes, roster, save
    // ---------------------------------------------------------------

    public Map<String, Object> listClasses() {
        List<Student> all = studentRepository.findAll();
        List<Map<String, String>> classes = new ArrayList<>();
        java.util.Set<String> seen = new java.util.HashSet<>();

        for (Student s : all) {
            if (s.getStudentClass() == null || s.getStudentClass().isBlank()) continue;
            String sectionName = s.getSection() != null ? s.getSection().name() : "";
            String key = s.getStudentClass() + "|" + sectionName;
            if (seen.contains(key)) continue;
            seen.add(key);

            Map<String, String> row = new HashMap<>();
            row.put("value", s.getStudentClass());
            row.put("section", sectionName);
            row.put("sectionLabel", s.getSection() != null ? s.getSection().getDisplayName() : sectionName);
            classes.add(row);
        }

        Map<String, Object> result = new HashMap<>();
        result.put("classes", classes);
        return result;
    }

    public Map<String, Object> getRoster(String studentClass, String section, LocalDate date) {
        List<Student> students = studentRepository.findByStudentClass(studentClass);

        // Filter by section if provided
        if (section != null && !section.isBlank()) {
            students = students.stream()
                    .filter(s -> s.getSection() != null
                            && s.getSection().name().equalsIgnoreCase(section))
                    .toList();
        }

        List<Map<String, Object>> rows = new ArrayList<>();
        Map<Long, String> existing = new HashMap<>();

        for (Student s : students) {
            Map<String, Object> row = new HashMap<>();
            row.put("id", s.getId());
            row.put("registrationNumber", s.getRegistrationNumber());
            row.put("fullName", s.getFullName());
            row.put("email", s.getEmail());
            row.put("phoneNumber", s.getPhoneNumber() != null ? s.getPhoneNumber() : s.getPhone());
            rows.add(row);

            // Look up existing attendance for this date (match by userAccountId if set)
            if (s.getUserAccountId() != null) {
                List<Attendance> existingRows =
                        attendanceRepository.findByUserAccountIdAndDate(s.getUserAccountId(), date);
                if (!existingRows.isEmpty()) {
                    Attendance a = existingRows.get(0);
                    String status = !a.isPresent() ? "ABSENT" : a.isLate() ? "LATE" : "PRESENT";
                    existing.put(s.getId(), status);
                }
            }
        }

        Map<String, Object> result = new HashMap<>();
        result.put("students", rows);
        result.put("existingAttendance", existing);
        return result;
    }

    public Map<String, Object> saveStudentAttendance(StudentAttendanceSaveRequest request) {
        LocalDate date = request.getDate() != null ? request.getDate() : LocalDate.now();
        String course = request.getStudentClass()
                + (request.getSection() != null ? " - " + request.getSection() : "");
        List<Attendance> saved = new ArrayList<>();

        if (request.getRecords() == null) {
            return Map.of("saved", 0);
        }

        for (StudentAttendanceSaveRequest.Record rec : request.getRecords()) {
            Student student = studentRepository.findById(rec.getStudentId()).orElse(null);
            if (student == null || student.getUserAccountId() == null) continue;

            UserAccount account = userAccountRepository.findById(student.getUserAccountId()).orElse(null);
            if (account == null) continue;

            boolean present = !"ABSENT".equalsIgnoreCase(rec.getStatus());
            boolean late = "LATE".equalsIgnoreCase(rec.getStatus());

            // Delete existing record for that day (idempotent save)
            List<Attendance> existing =
                    attendanceRepository.findByUserAccountIdAndDate(account.getId(), date);
            existing.forEach(attendanceRepository::delete);

            Attendance a = new Attendance();
            a.setDate(date);
            a.setPresent(present);
            a.setLate(late);
            a.setJustification(rec.getJustification());
            a.setAttendeeType(TYPE_STUDENT);
            a.setCourse(course);
            a.setUserAccount(account);
            if (present) {
                a.setCheckInTime(date.atTime(LocalTime.now().getHour(), LocalTime.now().getMinute()));
            }

            saved.add(attendanceRepository.save(a));
            if (present) {
                notifyStudent(account, a);
            }
        }

        Map<String, Object> result = new HashMap<>();
        result.put("saved", saved.size());
        return result;
    }

    public Map<String, Object> getBoardByClass(LocalDate date, String attendeeType) {
        List<Attendance> all = attendanceRepository.findByDate(date, Sort.by("checkInTime"));

        // Filter by attendee type if provided
        if (attendeeType != null && !attendeeType.isBlank()) {
            all = all.stream()
                    .filter(a -> attendeeType.equalsIgnoreCase(a.getAttendeeType()))
                    .toList();
        }

        // Group by class (from the linked student's studentClass + section)
        Map<String, Map<String, Object>> groups = new java.util.LinkedHashMap<>();

        for (Attendance a : all) {
            UserAccount u = a.getUserAccount();
            if (u == null) continue;

            Student student = null;
            try {
                student = studentRepository.findByUserAccountId(u.getId()).orElse(null);
            } catch (Exception ignored) {}

            String studentClass = student != null && student.getStudentClass() != null
                    ? student.getStudentClass() : "Sans classe";
            String sectionName = student != null && student.getSection() != null
                    ? student.getSection().name() : "";
            String sectionLabel = student != null && student.getSection() != null
                    ? student.getSection().getDisplayName() : sectionName;
            String key = studentClass + "|" + sectionName;

            Map<String, Object> group = groups.computeIfAbsent(key, k -> {
                Map<String, Object> g = new java.util.LinkedHashMap<>();
                g.put("studentClass", studentClass);
                g.put("section", sectionName);
                g.put("sectionLabel", sectionLabel);
                g.put("total", 0);
                g.put("present", 0);
                g.put("late", 0);
                g.put("absent", 0);
                g.put("students", new ArrayList<Map<String, Object>>());
                return g;
            });

            String status = !a.isPresent() ? "ABSENT" : a.isLate() ? "LATE" : "PRESENT";

            Map<String, Object> row = new java.util.LinkedHashMap<>();
            row.put("userAccountId", u.getId());
            row.put("fullName", fullName(u));
            row.put("status", status);
            row.put("checkInTime", a.getCheckInTime() != null
                    ? a.getCheckInTime().toLocalTime().toString() : null);
            row.put("justification", a.getJustification());

            @SuppressWarnings("unchecked")
            List<Map<String, Object>> students = (List<Map<String, Object>>) group.get("students");
            students.add(row);

            group.put("total", ((Integer) group.get("total")) + 1);
            if ("PRESENT".equals(status)) group.put("present", ((Integer) group.get("present")) + 1);
            else if ("LATE".equals(status)) group.put("late", ((Integer) group.get("late")) + 1);
            else group.put("absent", ((Integer) group.get("absent")) + 1);
        }

        Map<String, Object> result = new HashMap<>();
        result.put("date", date.toString());
        result.put("classes", new ArrayList<>(groups.values()));
        return result;
    }

    public Map<String, Object> getHistory(java.time.LocalDate from, java.time.LocalDate to,
                                          String studentClass, String section) {
        List<Attendance> all = attendanceRepository.findByDateBetween(from, to, Sort.by("date", "checkInTime"));

        Map<String, Map<String, Object>> groups = new java.util.LinkedHashMap<>();
        for (Attendance a : all) {
            UserAccount u = a.getUserAccount();
            if (u == null) continue;

            Student s = null;
            try { s = studentRepository.findByUserAccountId(u.getId()).orElse(null); } catch (Exception ignored) {}

            String sc = s != null && s.getStudentClass() != null ? s.getStudentClass() : "Sans classe";
            String sn = s != null && s.getSection() != null ? s.getSection().name() : "";
            String sl = s != null && s.getSection() != null ? s.getSection().getDisplayName() : sn;

            if (studentClass != null && !studentClass.isBlank() && !sc.equalsIgnoreCase(studentClass)) continue;
            if (section != null && !section.isBlank() && !sn.equalsIgnoreCase(section)) continue;

            String key = a.getDate().toString() + "|" + sc + "|" + sn;
            final String fSc = sc, fSn = sn, fSl = sl;
            Map<String, Object> g = groups.computeIfAbsent(key, k -> {
                Map<String, Object> m = new java.util.LinkedHashMap<>();
                m.put("date", a.getDate().toString());
                m.put("studentClass", fSc);
                m.put("section", fSn);
                m.put("sectionLabel", fSl);
                m.put("total", 0); m.put("present", 0); m.put("late", 0); m.put("absent", 0);
                m.put("students", new ArrayList<Map<String, Object>>());
                return m;
            });

            String status = !a.isPresent() ? "ABSENT" : a.isLate() ? "LATE" : "PRESENT";
            Map<String, Object> row = new java.util.LinkedHashMap<>();
            row.put("userAccountId", u.getId());
            row.put("fullName", fullName(u));
            row.put("status", status);
            row.put("checkInTime", a.getCheckInTime() != null ? a.getCheckInTime().toString() : null);
            row.put("justification", a.getJustification());

            @SuppressWarnings("unchecked")
            List<Map<String, Object>> studs = (List<Map<String, Object>>) g.get("students");
            studs.add(row);

            g.put("total", ((Integer) g.get("total")) + 1);
            if ("PRESENT".equals(status)) g.put("present", ((Integer) g.get("present")) + 1);
            else if ("LATE".equals(status)) g.put("late", ((Integer) g.get("late")) + 1);
            else g.put("absent", ((Integer) g.get("absent")) + 1);
        }

        Map<String, Object> out = new HashMap<>();
        out.put("classes", new ArrayList<>(groups.values()));
        return out;
    }
}