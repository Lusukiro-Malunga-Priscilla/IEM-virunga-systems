@Service
public class AttendanceService {

    /** School starts at 07:30 ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â anything checked in after this is LATE. */
    public static final LocalTime SCHOOL_START_TIME = LocalTime.of(7, 30);

    public static final String TYPE_STUDENT = "STUDENT";
    public static final String TYPE_TEACHER = "TEACHER";

    private final AttendanceRepository attendanceRepository;
    private final UserAccountRepository userAccountRepository;
    private final StudentRepository studentRepository;
    private final EmailService emailService;
    private final SmsService smsService;

    public AttendanceService(AttendanceRepository attendanceRepository,
                              UserAccountRepository userAccountRepository,
                              StudentRepository studentRepository,
                              EmailService emailService,
                              SmsService smsService) {
        this.attendanceRepository = attendanceRepository;
        this.userAccountRepository = userAccountRepository;
        this.studentRepository = studentRepository;
        this.emailService = emailService;
        this.smsService = smsService;
    }

    // ---------------------------------------------------------------
    // Existing basic operations (kept, lightly hardened)
    // ---------------------------------------------------------------

    public List<Attendance> findAll() {
        return attendanceRepository.findAll(Sort.by(Sort.Direction.DESC, "date", "checkInTime"));
    }

    public List<Attendance> findByUserId(Long userAccountId) {
        return attendanceRepository.findByUserAccountId(userAccountId, Sort.by(Sort.Direction.DESC, "date", "checkInTime"));
    }

    /**
     * Single check-in (kept for backward compatibility / API-driven check-in,
     * e.g. a badge reader). Lateness is now ALWAYS recomputed from the actual
     * check-in time against 07:30, on top of whatever flag was passed in.
     */
    public Attendance checkIn(String username, String attendeeType, String course, boolean lateHint, String justification) {
        UserAccount account = userAccountRepository.findByUsername(username).orElseThrow();
        LocalDateTime now = LocalDateTime.now();

        Attendance attendance = new Attendance();
        attendance.setDate(now.toLocalDate());
        attendance.setCheckInTime(now);
        attendance.setPresent(true);
        attendance.setLate(lateHint || isAfterSchoolStart(now));
        attendance.setJustification(justification);
        attendance.setAttendeeType(attendeeType);
        attendance.setCourse(course);
        attendance.setUserAccount(account);

        Attendance saved = attendanceRepository.save(attendance);

        if (TYPE_STUDENT.equalsIgnoreCase(attendeeType)) {
            notifyStudent(account, saved);
        }

        return saved;
    }

    public Attendance checkOut(Long id) {
        Attendance attendance = attendanceRepository.findById(id).orElseThrow();
        attendance.setCheckOutTime(LocalDateTime.now());
        return attendanceRepository.save(attendance);
    }

    // ---------------------------------------------------------------
    // Teacher pointing his own class (morning roll call)
    // ---------------------------------------------------------------

    /**
     * Called once when the teacher finishes clicking through the class list
     * and hits "Enregistrer". Saves one Attendance row per student, marks
     * lateness automatically, and notifies each present student by
     * email + SMS. Students not included in the request (or included with
     * present=false) are simply not saved as present ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â they'll show up as
     * ABSENT / NOT_MARKED on the admin board (see getDailyBoard below).
     */
    public List<Attendance> classCheckIn(ClassAttendanceCheckInRequest request) {
        LocalDate date = request.getDate() != null ? request.getDate() : LocalDate.now();
        LocalDateTime now = LocalDateTime.now();
        List<Attendance> saved = new ArrayList<>();

        for (ClassAttendanceEntryDto entry : request.getEntries()) {
            if (!entry.isPresent()) {
                // Explicitly marked absent: still record it so the admin board
                // and the student's own history show ABSENT rather than nothing.
                UserAccount student = userAccountRepository.findById(entry.getStudentUserAccountId()).orElseThrow();
                Attendance absentRow = new Attendance();
                absentRow.setDate(date);
                absentRow.setPresent(false);
                absentRow.setLate(false);
                absentRow.setJustification(entry.getJustification());
                absentRow.setAttendeeType(TYPE_STUDENT);
                absentRow.setCourse(request.getCourse());
                absentRow.setUserAccount(student);
                saved.add(attendanceRepository.save(absentRow));
                continue;
            }

            UserAccount student = userAccountRepository.findById(entry.getStudentUserAccountId()).orElseThrow();
            LocalDateTime checkInTime = date.isEqual(LocalDate.now()) ? now : date.atTime(SCHOOL_START_TIME);
            boolean late = entry.isLate() || isAfterSchoolStart(checkInTime);

            Attendance attendance = new Attendance();
            attendance.setDate(date);
            attendance.setCheckInTime(checkInTime);
            attendance.setPresent(true);
            attendance.setLate(late);
            attendance.setJustification(entry.getJustification());
            attendance.setAttendeeType(TYPE_STUDENT);
            attendance.setCourse(request.getCourse());
            attendance.setUserAccount(student);

            Attendance savedRow = attendanceRepository.save(attendance);
            saved.add(savedRow);

            notifyStudent(student, savedRow);
        }

        return saved;
    }

    // ---------------------------------------------------------------
    // Teacher's own presence
    // ---------------------------------------------------------------

    public Attendance teacherSelfCheckIn(String teacherUsername) {
        UserAccount teacher = userAccountRepository.findByUsername(teacherUsername).orElseThrow();
        LocalDate today = LocalDate.now();

        // Avoid double check-in for the same day.
        List<Attendance> existing = attendanceRepository.findByUserAccountIdAndDate(teacher.getId(), today);
        if (!existing.isEmpty()) {
            return existing.get(0);
        }

        LocalDateTime now = LocalDateTime.now();
        Attendance attendance = new Attendance();
        attendance.setDate(today);
        attendance.setCheckInTime(now);
        attendance.setPresent(true);
        attendance.setLate(isAfterSchoolStart(now));
        attendance.setAttendeeType(TYPE_TEACHER);
        attendance.setUserAccount(teacher);

        return attendanceRepository.save(attendance);
    }

    // ---------------------------------------------------------------
    // Admin daily board (the green/orange/red boxes)
    // ---------------------------------------------------------------

    /**
     * Builds the box list for a given day, from whatever has actually been
     * saved (present + absent rows). This alone is enough to show every
     * teacher's daily board (green = present, orange = late, red = absent).
     *
     * NOTE: if you want students who were never clicked at all (no row saved)
     * to also show up as a grey "NOT_MARKED" box, pass the class roster to
     * the overload below ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â this project's UserAccount/course model wasn't
     * shown to me, so wire that roster lookup to your own StudentRepository
     * (e.g. findByRoleAndCourse(...)).
     */
    public List<DailyAttendanceBoxDto> getDailyBoard(LocalDate date, String course, String attendeeType) {
        List<Attendance> rows = (course != null && !course.isBlank())
                ? attendanceRepository.findByCourseIgnoreCaseAndDate(course, date, Sort.by("checkInTime"))
                : attendanceRepository.findByDate(date, Sort.by("checkInTime"));

        return rows.stream()
                .filter(a -> attendeeType == null || attendeeType.equalsIgnoreCase(a.getAttendeeType()))
                .map(this::toBoxDto)
                .collect(Collectors.toList());
    }

    /** Overload that also fills in grey NOT_MARKED boxes for roster members with no row yet. */
    public List<DailyAttendanceBoxDto> getDailyBoard(LocalDate date, String course, String attendeeType,
                                                       List<UserAccount> roster) {
        List<DailyAttendanceBoxDto> marked = getDailyBoard(date, course, attendeeType);
        Map<Long, DailyAttendanceBoxDto> byUser = marked.stream()
                .collect(Collectors.toMap(DailyAttendanceBoxDto::getUserAccountId, dto -> dto, (a, b) -> a));

        List<DailyAttendanceBoxDto> result = new ArrayList<>(marked);
        for (UserAccount user : roster) {
            if (!byUser.containsKey(user.getId())) {
                result.add(new DailyAttendanceBoxDto(user.getId(), fullName(user), "NOT_MARKED",
                        null, null, null, course));
            }
        }
        return result;
    }

    // ---------------------------------------------------------------
    // Helpers
    // ---------------------------------------------------------------

    private boolean isAfterSchoolStart(LocalDateTime dateTime) {
        return dateTime.toLocalTime().isAfter(SCHOOL_START_TIME);
    }

    private DailyAttendanceBoxDto toBoxDto(Attendance a) {
        String status;
        if (!a.isPresent()) {
            status = "ABSENT";
        } else if (a.isLate()) {
            status = "LATE";
        } else {
            status = "PRESENT";
        }
        UserAccount u = a.getUserAccount();
        return new DailyAttendanceBoxDto(
                u != null ? u.getId() : null,
                u != null ? fullName(u) : "?",
                status,
                a.getCheckInTime(),
                a.getCheckOutTime(),
                a.getJustification(),
                a.getCourse());
    }

    /**
     * ADAPT ME: uses getFirstName()/getLastName() ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â rename to match your
     * actual UserAccount entity's getters if they differ.
     */
    private String fullName(UserAccount u) {
        if (u == null) return "Eleve";
        try {
            java.util.Optional<Student> s = studentRepository.findByUserAccountId(u.getId());
            if (s.isPresent() && s.get().getFullName() != null && !s.get().getFullName().isBlank()) {
                return s.get().getFullName();
            }
        } catch (Exception ignored) {}
        try {
            String fn = u.getFirstName();
            String ln = u.getLastName();
            String combined = ((fn != null ? fn : "") + " " + (ln != null ? ln : "")).trim();
            if (!combined.isBlank()) return combined;
        } catch (Exception ignored) {}
        return u.getUsername() != null ? u.getUsername() : "Eleve";
    }

    /**
     * Sends the "your child checked in" notification by email + SMS.
     * ADAPT ME: uses getEmail()/getPhoneNumber() ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã¢â‚¬Â¦Ãƒâ€šÃ‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â rename to match your
     * actual UserAccount entity's getters if they differ.
     */
    private void notifyStudent(UserAccount student, Attendance attendance) {
        String status = attendance.isLate() ? "EN RETARD" : "PRÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€šÃ‚Â¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â¬ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â°SENT";
        String time = attendance.getCheckInTime() != null
                ? attendance.getCheckInTime().toLocalTime().toString()
                : "";

        String subject = "PrÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©sence enregistrÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©e - " + fullName(student);
        StringBuilder body = new StringBuilder();
        body.append("Bonjour,\n\n")
                .append(fullName(student)).append(" a ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©tÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â© marquÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â©(e) ").append(status)
                .append(" aujourd'hui ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã¢â‚¬Â ÃƒÂ¢Ã¢â€šÂ¬Ã¢â€žÂ¢ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã‚Â ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬ÃƒÂ¢Ã¢â‚¬Å¾Ã‚Â¢ÃƒÆ’Ã†â€™Ãƒâ€ Ã¢â‚¬â„¢ÃƒÆ’Ã‚Â¢ÃƒÂ¢Ã¢â‚¬Å¡Ã‚Â¬Ãƒâ€¦Ã‚Â¡ÃƒÆ’Ã†â€™ÃƒÂ¢Ã¢â€šÂ¬Ã…Â¡ÃƒÆ’Ã¢â‚¬Å¡Ãƒâ€šÃ‚Â  ").append(time).append(".\n");
        if (attendance.isLate()) {
