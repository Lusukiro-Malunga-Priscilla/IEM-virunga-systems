package com.iem.backend.controller;

import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

import java.util.List;
import java.util.Map;

/**
 * GET /api/sections
 *
 * Ajoutez ce contrôleur UNIQUEMENT si vous n'avez pas déjà d'endpoint
 * /api/sections ailleurs dans votre backend. S'il existe déjà, ignorez ce
 * fichier (ou faites-en une source de vérité unique en base si vous
 * préférez gérer les sections dynamiquement plus tard).
 */
@RestController
@RequestMapping("/api/sections")
public class SectionController {

    @GetMapping
    public List<Map<String, String>> listSections() {
        return List.of(
                Map.of("id", "infirmiere", "nom", "Section Infirmière de la RÉFORME"),
                Map.of("id", "accoucheuse", "nom", "Section Accoucheuse de la RÉFORME"),
                Map.of("id", "pharmacie", "nom", "Section Assistant en pharmacie de la RÉFORME"),
                Map.of("id", "sante-mentale", "nom", "Section Santé Mentale de la RÉFORME"),
                Map.of("id", "labo", "nom", "Section Technique de Laboratoire de la RÉFORME")
        );
    }
}