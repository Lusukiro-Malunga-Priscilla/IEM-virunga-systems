package com.iem.backend.controller;

import com.iem.backend.dto.AttendanceCheckInRequest;
import com.iem.backend.dto.ClassAttendanceCheckInRequest;
import com.iem.backend.dto.DailyAttendanceBoxDto;
import com.iem.backend.dto.StudentAttendanceSaveRequest;
import com.iem.backend.model.Attendance;
import com.iem.backend.service.AttendanceService;
import org.springframework.format.annotation.DateTimeFormat;
import org.springframework.http.ResponseEntity;
import org.springframework.web.bind.annotation.*;

import java.time.LocalDate;
import java.util.List;
import java.util.Map;

@RestController
@RequestMapping("/api/attendance")
public class AttendanceController {

    private final AttendanceService attendanceService;

    public AttendanceController(AttendanceService attendanceService) {
        this.attendanceService = attendanceService;
    }

    // ---- Generic listing (admin) -----------------------------------

    @GetMapping
    public List<Attendance> getAll() {
        return attendanceService.findAll();
    }

    @GetMapping("/user/{userAccountId}")
    public List<Attendance> getByUser(@PathVariable Long userAccountId) {
        return attendanceService.findByUserId(userAccountId);
    }

    // ---- Single check-in (kept, e.g. for a badge reader) ------------

    @PostMapping("/check-in")
    public ResponseEntity<Attendance> checkIn(
            @RequestBody(required = false) AttendanceCheckInRequest request,
            @RequestParam(name = "username", required = false) String username,
            @RequestParam(name = "attendeeType", required = false) String attendeeType,
            @RequestParam(name = "course", required = false) String course,
            @RequestParam(name = "late", defaultValue = "false") boolean late,
            @RequestParam(name = "justification", required = false) String justification) {
        try {
            String actualUsername = request != null && request.getUsername() != null ? request.getUsername() : username;
            String actualAttendeeType = request != null && request.getAttendeeType() != null ? request.getAttendeeType() : attendeeType;
            String actualCourse = request != null && request.getCourse() != null ? request.getCourse() : course;
            boolean actualLate = request != null ? request.isLate() : late;
            String actualJustification = request != null && request.getJustification() != null ? request.getJustification() : justification;

            if (actualUsername == null || actualAttendeeType == null) {
                return ResponseEntity.badRequest().build();
            }

            return ResponseEntity.ok(attendanceService.checkIn(actualUsername, actualAttendeeType, actualCourse, actualLate, actualJustification));
        } catch (Exception ex) {
            return ResponseEntity.badRequest().build();
        }
    }

    @PutMapping("/{id}/check-out")
    public ResponseEntity<Attendance> checkOut(@PathVariable Long id) {
        try {
            return ResponseEntity.ok(attendanceService.checkOut(id));
        } catch (Exception ex) {
            return ResponseEntity.notFound().build();
        }
    }

    // ---- Teacher: morning roll call for the whole class --------------

    @PostMapping("/class-check-in")
    public ResponseEntity<List<Attendance>> classCheckIn(@RequestBody ClassAttendanceCheckInRequest request) {
        try {
            if (request.getEntries() == null || request.getEntries().isEmpty()) {
                return ResponseEntity.badRequest().build();
            }
            return ResponseEntity.ok(attendanceService.classCheckIn(request));
        } catch (Exception ex) {
            return ResponseEntity.badRequest().build();
        }
    }

    // ---- Teacher: his own presence -----------------------------------

    @PostMapping("/teacher-check-in")
    public ResponseEntity<Attendance> teacherCheckIn(@RequestParam(name = "username") String username) {
        try {
            return ResponseEntity.ok(attendanceService.teacherSelfCheckIn(username));
        } catch (Exception ex) {
            return ResponseEntity.badRequest().build();
        }
    }

    // ---- Admin: daily board (the green / orange / red boxes) ---------

    @GetMapping("/daily-board")
    public List<DailyAttendanceBoxDto> getDailyBoard(
            @RequestParam(name = "date", required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate date,
            @RequestParam(name = "course", required = false) String course,
            @RequestParam(name = "attendeeType", required = false) String attendeeType) {
        LocalDate targetDate = date != null ? date : LocalDate.now();
        return attendanceService.getDailyBoard(targetDate, course, attendeeType);
    }

    // ---- Teacher: list of classes to pick from --------------------------

    @GetMapping("/classes")
    public Map<String, Object> getClasses() {
        return attendanceService.listClasses();
    }

    // ---- Teacher: roster of students in a class on a date --------------

    @GetMapping("/roster")
    public Map<String, Object> getRoster(
            @RequestParam(name = "studentClass") String studentClass,
            @RequestParam(name = "section", required = false) String section,
            @RequestParam(name = "date", required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate date) {
        return attendanceService.getRoster(studentClass, section, date != null ? date : LocalDate.now());
    }

    // ---- Teacher: save attendance for a whole class --------------------

    @PostMapping("/students")
    public Map<String, Object> saveStudentAttendance(@RequestBody StudentAttendanceSaveRequest request) {
        return attendanceService.saveStudentAttendance(request);
    }

    @GetMapping("/board-by-class")
    public Map<String, Object> getBoardByClass(
            @RequestParam(name = "date", required = false) @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate date,
            @RequestParam(name = "attendeeType", required = false) String attendeeType) {
        LocalDate targetDate = date != null ? date : LocalDate.now();
        return attendanceService.getBoardByClass(targetDate, attendeeType);
    }

    @GetMapping("/history")
    public Map<String, Object> getHistory(
            @RequestParam(name = "from") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate from,
            @RequestParam(name = "to") @DateTimeFormat(iso = DateTimeFormat.ISO.DATE) LocalDate to,
            @RequestParam(name = "studentClass", required = false) String studentClass,
            @RequestParam(name = "section", required = false) String section) {
        return attendanceService.getHistory(from, to, studentClass, section);
    }
}