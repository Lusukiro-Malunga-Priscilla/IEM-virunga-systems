package com.iem.backend.model;

import jakarta.persistence.*;
import java.math.BigDecimal;
import java.time.LocalDate;
import java.time.LocalDateTime;

@Entity
@Table(name = "teacher_reports")
public class TeacherReport {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    @Column(name = "report_date", nullable = false)
    private LocalDate reportDate;

    @Column(length = 2000)
    private String summary;

    @Column(name = "classes_taught", length = 1000)
    private String classesTaught;

    @Column(name = "hours_worked", precision = 4, scale = 1)
    private BigDecimal hoursWorked;

    @Column(length = 2000)
    private String issues;

    @Column(length = 2000)
    private String achievements;

    @Column(length = 30)
    private String status;

    @ManyToOne
    @JoinColumn(name = "teacher_id")
    private Employee teacher;

    @Column(name = "created_at")
    private LocalDateTime createdAt;

    @Column(name = "updated_at")
    private LocalDateTime updatedAt;

    public TeacherReport() {
        this.reportDate = LocalDate.now();
        this.status = "SUBMITTED";
        this.createdAt = LocalDateTime.now();
        this.updatedAt = LocalDateTime.now();
    }

    @PreUpdate
    public void preUpdate() { this.updatedAt = LocalDateTime.now(); }

    // ---- getters / setters ----

    public Long getId() { return id; }

    public LocalDate getReportDate() { return reportDate; }
    public void setReportDate(LocalDate reportDate) { this.reportDate = reportDate; }

    public String getSummary() { return summary; }
    public void setSummary(String summary) { this.summary = summary; }

    public String getClassesTaught() { return classesTaught; }
    public void setClassesTaught(String classesTaught) { this.classesTaught = classesTaught; }

    public BigDecimal getHoursWorked() { return hoursWorked; }
    public void setHoursWorked(BigDecimal hoursWorked) { this.hoursWorked = hoursWorked; }

    public String getIssues() { return issues; }
    public void setIssues(String issues) { this.issues = issues; }

    public String getAchievements() { return achievements; }
    public void setAchievements(String achievements) { this.achievements = achievements; }

    public String getStatus() { return status; }
    public void setStatus(String status) { this.status = status; }

    public Employee getTeacher() { return teacher; }
    public void setTeacher(Employee teacher) { this.teacher = teacher; }

    public LocalDateTime getCreatedAt() { return createdAt; }
    public void setCreatedAt(LocalDateTime createdAt) { this.createdAt = createdAt; }

    public LocalDateTime getUpdatedAt() { return updatedAt; }
    public void setUpdatedAt(LocalDateTime updatedAt) { this.updatedAt = updatedAt; }
}