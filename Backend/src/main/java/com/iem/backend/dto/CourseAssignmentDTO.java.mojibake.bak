package com.iem.backend.dto;

/**
 * Représentation "plate" d'une attribution, telle qu'attendue par
 * Cours.jsx côté frontend (champs en camelCase, sérialisés tels quels
 * en JSON par Jackson).
 *
 * Utilisée en sortie (GET /api/courses) ET en entrée (POST /api/courses,
 * où courseId / id / enseignant sont ignorés et recalculés côté serveur).
 */
public class CourseAssignmentDTO {

    private Long id;
    private Long courseId;
    private String code;
    private String name;
    private String description;

    private String section;
    private String classe;

    private Long teacherId;
    private String enseignant; // nom affiché "Prénom Nom", calculé côté serveur

    private String jour;
    private String heureDebut; // format "HH:mm"
    private String heureFin;   // format "HH:mm"

    private Integer volumeHoraire;
    private Integer coefficient;

    public CourseAssignmentDTO() {
    }

    public Long getId() {
        return id;
    }

    public void setId(Long id) {
        this.id = id;
    }

    public Long getCourseId() {
        return courseId;
    }

    public void setCourseId(Long courseId) {
        this.courseId = courseId;
    }

    public String getCode() {
        return code;
    }

    public void setCode(String code) {
        this.code = code;
    }

    public String getName() {
        return name;
    }

    public void setName(String name) {
        this.name = name;
    }

    public String getDescription() {
        return description;
    }

    public void setDescription(String description) {
        this.description = description;
    }

    public String getSection() {
        return section;
    }

    public void setSection(String section) {
        this.section = section;
    }

    public String getClasse() {
        return classe;
    }

    public void setClasse(String classe) {
        this.classe = classe;
    }

    public Long getTeacherId() {
        return teacherId;
    }

    public void setTeacherId(Long teacherId) {
        this.teacherId = teacherId;
    }

    public String getEnseignant() {
        return enseignant;
    }

    public void setEnseignant(String enseignant) {
        this.enseignant = enseignant;
    }

    public String getJour() {
        return jour;
    }

    public void setJour(String jour) {
        this.jour = jour;
    }

    public String getHeureDebut() {
        return heureDebut;
    }

    public void setHeureDebut(String heureDebut) {
        this.heureDebut = heureDebut;
    }

    public String getHeureFin() {
        return heureFin;
    }

    public void setHeureFin(String heureFin) {
        this.heureFin = heureFin;
    }

    public Integer getVolumeHoraire() {
        return volumeHoraire;
    }

    public void setVolumeHoraire(Integer volumeHoraire) {
        this.volumeHoraire = volumeHoraire;
    }

    public Integer getCoefficient() {
        return coefficient;
    }

    public void setCoefficient(Integer coefficient) {
        this.coefficient = coefficient;
    }
}