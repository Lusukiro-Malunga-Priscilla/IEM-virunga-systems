import React, { useState, useEffect } from "react";
import { useNavigate } from "react-router";

const slides = [
  {
    src: "/assets/profile.jpeg",
    headline: "Link people with places ",
    sub: "Manage your team smarter with RITCO HRM",
  },
  {
    src: "/assets/salary_image.webp",
    headline: "your early payment our priority",
    sub: "Process salaries with accuracy and speed",
  },
  {
    src: "/assets/hr1.jpeg",
    headline: "Employees First, Foremost",
    sub: "Build a culture that drives performance",
  },
  {
    src: "/assets/hr2.jpeg",
    headline: "People First, Always",
    sub: "Build a culture that drives performance",
  },
  {
    src: "/assets/hr3.jpeg",
    headline: "People First, Always",
    sub: "Build a culture that drives performance",
  },
  {
    src: "/assets/hr4.jpeg",
    headline: "Building Better Teams",
    sub: "Build a culture that drives performance",
  },
];

const HomePage: React.FC = () => {
  const [current, setCurrent] = useState(0);
  const [animating, setAnimating] = useState(false);
  const navigate = useNavigate();

  useEffect(() => {
    const timer = setInterval(() => {
      setAnimating(true);
      setTimeout(() => {
        setCurrent((prev) => (prev + 1) % slides.length);
        setAnimating(false);
      }, 500);
    }, 4000);
    return () => clearInterval(timer);
  }, []);

  const goTo = (idx: number) => {
    if (idx === current) return;
    setAnimating(true);
    setTimeout(() => {
      setCurrent(idx);
      setAnimating(false);
    }, 400);
  };

  return (
    <div className="home-root">
      {/* ── HERO SLIDESHOW ── */}
      <section className="hero">
        {slides.map((slide, i) => (
          <div
            key={i}
            className={`hero__slide ${i === current ? "hero__slide--active" : ""}`}
            style={{ backgroundImage: `url(${slide.src})` }}
          />
        ))}
        <div className="hero__overlay" />

        <div className={`hero__content ${animating ? "hero__content--out" : "hero__content--in"}`}>
          <span className="hero__tag">RITCO Ltd · HRM System</span>
          <h1 className="hero__headline">{slides[current].headline}</h1>
          <p className="hero__sub">{slides[current].sub}</p>

          <button className="hero__cta" onClick={() => navigate("/login")}>
            Get Started →
          </button>
        </div>

        <div className="hero__dots">
          {slides.map((_, i) => (
            <button
              key={i}
              className={`hero__dot ${i === current ? "hero__dot--active" : ""}`}
              onClick={() => goTo(i)}
            />
          ))}
        </div>

        <div className="hero__progress">
          <div className="hero__progress-bar" key={current} />
        </div>
      </section>

      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Poppins:wght@400;500;600;700&display=swap');

        *, *::before, *::after { 
          box-sizing: border-box; 
          margin: 0; 
          padding: 0; 
        }

        .home-root {
          min-height: 100vh;
          font-family: 'Poppins', sans-serif;
          background: #f4f6fb;
        }

        /* ── HERO ── */
        .hero {
          position: relative;
          height: 100vh;
          min-height: 520px;
          overflow: hidden;
          display: flex;
          align-items: center;
        }

        .hero__slide {
          position: absolute;
          inset: 0;
          background-size: cover;  /* Changed to cover - fills entire screen */
          background-position: center;
          background-repeat: no-repeat;
          opacity: 0;
          transition: opacity 1s ease;
        }

        .hero__slide--active {
          opacity: 1;
        }

        .hero__overlay {
          position: absolute;
          inset: 0;
          background: linear-gradient(
            to right,
            rgba(10, 25, 41, 0.80) 0%,
            rgba(10, 25, 41, 0.40) 60%,
            rgba(10, 25, 41, 0.10) 100%
          );
          z-index: 2;
        }

        .hero__content {
          position: relative;
          z-index: 3;
          padding: 0 80px;
          max-width: 700px;
          transition: opacity 0.4s ease, transform 0.4s ease;
        }

        .hero__content--in {
          opacity: 1;
          transform: translateY(0);
        }

        .hero__content--out {
          opacity: 0;
          transform: translateY(16px);
        }

        .hero__tag {
          display: inline-block;
          background: rgba(25, 118, 210, 0.85);
          color: #fff;
          font-size: 11px;
          font-weight: 700;
          letter-spacing: 2px;
          text-transform: uppercase;
          padding: 5px 14px;
          border-radius: 20px;
          margin-bottom: 20px;
        }

        .hero__headline {
          font-family: 'Nunito', sans-serif;
          font-size: clamp(36px, 5vw, 62px);
          font-weight: 900;
          color: #fff;
          line-height: 1.15;
          margin-bottom: 16px;
          text-shadow: 0 2px 12px rgba(0,0,0,0.3);
        }

        .hero__sub {
          font-size: 17px;
          color: rgba(255,255,255,0.9);
          margin-bottom: 36px;
          line-height: 1.6;
        }

        /* ── CTA BUTTON ── */
        .hero__cta {
          display: inline-flex;
          align-items: center;
          gap: 8px;
          background: #1565c0;
          color: #fff;
          border: none;
          border-radius: 12px;
          padding: 14px 32px;
          font-size: 16px;
          font-weight: 700;
          font-family: 'Nunito', sans-serif;
          cursor: pointer;
          transition: background 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
          box-shadow: 0 4px 20px rgba(21, 101, 192, 0.5);
          letter-spacing: 0.3px;
        }

        .hero__cta:hover {
          background: #0d47a1;
          transform: translateY(-2px);
          box-shadow: 0 8px 28px rgba(21, 101, 192, 0.6);
        }

        /* Dots */
        .hero__dots {
          position: absolute;
          bottom: 32px;
          right: 64px;
          z-index: 4;
          display: flex;
          gap: 8px;
        }

        .hero__dot {
          width: 10px;
          height: 10px;
          border-radius: 50%;
          border: 2px solid rgba(255,255,255,0.5);
          background: transparent;
          cursor: pointer;
          transition: all 0.3s ease;
          padding: 0;
        }

        .hero__dot--active {
          background: #fff;
          border-color: #fff;
          transform: scale(1.3);
        }

        /* Progress bar */
        .hero__progress {
          position: absolute;
          bottom: 0;
          left: 0;
          right: 0;
          height: 3px;
          background: rgba(255,255,255,0.15);
          z-index: 4;
        }

        .hero__progress-bar {
          height: 100%;
          background: #1976d2;
          animation: progress 4s linear forwards;
        }

        @keyframes progress {
          from { width: 0%; }
          to { width: 100%; }
        }

        @media (max-width: 768px) {
          .hero__content { 
            padding: 0 24px; 
          }
          .hero__dots { 
            right: 24px; 
          }
        }
      `}</style>
    </div>
  );
};

export default HomePage;
