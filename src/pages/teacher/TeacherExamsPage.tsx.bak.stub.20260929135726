import React, { useEffect, useState } from "react";
import { api } from "./api";

interface Props { filter?: string; }
interface Exam {
  id: number; title: string; subject: string; class_name: string | null;
  original_name: string; status: string; submitted_at: string;
  exam_date: string | null; start_time: string | null; end_time: string | null; room: string | null;
}

const input: React.CSSProperties = { padding: 8, border: "1px solid #cbd5e1", borderRadius: 6 };

export default function TeacherExamsPage({ filter }: Props) {
  const [exams, setExams] = useState<Exam[]>([]);
  const [title, setTitle] = useState("");
  const [subject, setSubject] = useState("");
  const [className, setClassName] = useState("");
  const [file, setFile] = useState<File | null>(null);
  const [msg, setMsg] = useState<{ ok: boolean; text: string } | null>(null);
  const [busy, setBusy] = useState(false);

  const load = () => api.teacherList().then(setExams).catch((e) => setMsg({ ok: false, text: e.message }));
  useEffect(() => { load(); }, []);

  async function publish(e: React.FormEvent) {
    e.preventDefault();
    if (!file) return setMsg({ ok: false, text: "Choisissez un fichier Word" });
    const form = new FormData();
    form.append("title", title);
    form.append("subject", subject);
    form.append("className", className);
    form.append("file", file);
    setBusy(true);
    try {
      await api.teacherUpload(form);
      setMsg({ ok: true, text: "Examen publié : l'administration l'a reçu." });
      setTitle(""); setSubject(""); setClassName(""); setFile(null);
      (document.getElementById("exam-file") as HTMLInputElement).value = "";
      load();
    } catch (err: any) {
      setMsg({ ok: false, text: err.message });
    } finally { setBusy(false); }
  }

  const shown = filter ? exams.filter((x) => x.status === filter) : exams;

  return (
    <div style={{ padding: 24 }}>
      <h1 style={{ fontSize: 22, fontWeight: 700, color: "#0B1B3A", marginBottom: 6 }}>
        {filter ? `Examens (${filter})` : "Mes examens"}
      </h1>
      <p style={{ color: "#64748b", marginBottom: 16 }}>
        Rédigez l'examen dans Word, importez le fichier, puis publiez-le.
      </p>

      <form onSubmit={publish} style={{ display: "flex", gap: 10, flexWrap: "wrap", marginBottom: 12 }}>
        <input style={input} placeholder="Titre" value={title} onChange={(e) => setTitle(e.target.value)} required />
        <input style={input} placeholder="Matière" value={subject} onChange={(e) => setSubject(e.target.value)} required />
        <input style={input} placeholder="Classe" value={className} onChange={(e) => setClassName(e.target.value)} />
        <input id="exam-file" type="file" accept=".doc,.docx" onChange={(e) => setFile(e.target.files?.[0] || null)} />
        <button disabled={busy} style={{ ...input, background: "#0B1B3A", color: "#fff", cursor: "pointer" }}>
          {busy ? "Envoi..." : "Publier"}
        </button>
      </form>
      {msg && <p style={{ color: msg.ok ? "#15803d" : "#b91c1c", marginBottom: 12 }}>{msg.text}</p>}

      <div style={{ overflowX: "auto" }}>
        <table style={{ width: "100%", borderCollapse: "collapse" }}>
          <thead style={{ background: "#f1f5f9", textAlign: "left" }}>
            <tr>{["Titre", "Matière", "Classe", "Envoyé le", "Statut", "Date d'examen"].map((h) => (
              <th key={h} style={{ padding: 12 }}>{h}</th>))}</tr>
          </thead>
          <tbody>
            {shown.map((x) => (
              <tr key={x.id} style={{ borderBottom: "1px solid #eef2f7" }}>
                <td style={{ padding: 12 }}>{x.title}</td>
                <td style={{ padding: 12 }}>{x.subject}</td>
                <td style={{ padding: 12 }}>{x.class_name || "-"}</td>
                <td style={{ padding: 12 }}>{x.submitted_at}</td>
                <td style={{ padding: 12 }}>{x.status === "scheduled" ? "Planifié" : "Envoyé"}</td>
                <td style={{ padding: 12 }}>
                  {x.exam_date ? `${x.exam_date} ${x.start_time}-${x.end_time}${x.room ? ` (${x.room})` : ""}` : "-"}
                </td>
              </tr>
            ))}
            {!shown.length && <tr><td colSpan={6} style={{ padding: 12, color: "#64748b" }}>Aucun examen.</td></tr>}
          </tbody>
        </table>
      </div>
    </div>
  );
}