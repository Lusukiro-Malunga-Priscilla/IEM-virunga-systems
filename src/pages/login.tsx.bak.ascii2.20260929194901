          color: #B8AF9E;
        }

        .iemv-input:focus-visible {
          border-color: var(--color-accent);
          box-shadow: 0 0 0 3px rgba(200, 147, 62, 0.22);
        }

        .iemv-input[data-haspad="true"] {
          padding-right: 40px;
        }

        .iemv-otp-input {
          letter-spacing: 0.5em;
          font-size: 20px;
          text-align: center;
          font-family: 'IBM Plex Sans', sans-serif;
          font-weight: 500;
        }

        .iemv-toggle-visibility {
          position: absolute;
          right: 10px;
          background: none;
          border: none;
          cursor: pointer;
          color: var(--color-text-muted);
          display: flex;
          align-items: center;
          padding: 4px;
        }

        .iemv-toggle-visibility:hover {
          color: var(--color-text);
        }

        .iemv-row {
          display: flex;
          justify-content: space-between;
          align-items: center;
          font-size: 13px;
        }

        .iemv-remember {
          display: flex;
          align-items: center;
          gap: 7px;
          color: var(--color-text-muted);
          cursor: pointer;
        }

        .iemv-remember input {
          accent-color: var(--color-panel);
          width: 14px;
          height: 14px;
        }

        .iemv-link {
          color: var(--color-panel);
          font-weight: 600;
          text-decoration: none;
        }

        .iemv-link:hover {
          text-decoration: underline;
        }

        .iemv-btn-primary {
          width: 100%;
          box-sizing: border-box;
          padding: 12px 16px;
          background: var(--color-panel);
          color: var(--color-parchment-text);
          border: none;
          border-radius: 3px;
          font-size: 14.5px;
          font-weight: 600;
          font-family: inherit;
          cursor: pointer;
          transition: background 0.15s ease;
        }

        .iemv-btn-primary:hover:not(:disabled) {
          background: var(--color-panel-alt);
        }

        .iemv-btn-primary:focus-visible {
          outline: 2px solid var(--color-accent);
          outline-offset: 2px;
        }

        .iemv-btn-primary:disabled {
          opacity: 0.6;
          cursor: not-allowed;
        }

        .iemv-btn-ghost {
          width: 100%;
          box-sizing: border-box;
          padding: 11px 16px;
          background: transparent;
          color: var(--color-text);
          border: 1px solid var(--color-border);
          border-radius: 3px;
          font-size: 14px;
          font-weight: 500;
          font-family: inherit;
          cursor: pointer;
          transition: border-color 0.15s ease, background 0.15s ease;
        }

        .iemv-btn-ghost:hover:not(:disabled) {
          border-color: var(--color-panel);
          background: rgba(21, 48, 42, 0.04);
        }

        .iemv-btn-ghost:focus-visible {
          outline: 2px solid var(--color-accent);
          outline-offset: 2px;
        }

        .iemv-btn-ghost:disabled {
          opacity: 0.55;
          cursor: not-allowed;
        }

        .iemv-btn-back {
          display: inline-flex;
          align-items: center;
          gap: 6px;
          background: none;
          border: none;
          color: var(--color-text-muted);
          font-size: 13px;
          font-family: inherit;
          cursor: pointer;
          padding: 4px 0;
        }

        .iemv-btn-back:hover:not(:disabled) {
          color: var(--color-text);
        }

        .iemv-footline {
          text-align: center;
          font-size: 13px;
          color: var(--color-text-muted);
          margin: 4px 0 0;
        }

        @media (max-width: 860px) {
          .iemv-shell {
            grid-template-columns: 1fr;
          }
          .iemv-brand {
            padding: 30px 26px;
            flex-direction: row;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
          }
          .iemv-brand-body { display: none; }
          .iemv-brand-foot { display: none; }
          .iemv-formside { padding: 34px 22px 44px; }
        }
      `}</style>

      {/* Identity panel */}
      <div className="iemv-brand">
        <svg className="iemv-ridges" viewBox="0 0 500 700" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M0 480 L90 410 L150 450 L230 360 L300 430 L380 370 L500 460 L500 700 L0 700 Z" fill="#1D3F35" opacity="0.7" />
          <path d="M0 560 L70 520 L160 570 L240 500 L330 560 L420 500 L500 550 L500 700 L0 700 Z" fill="#234A3E" opacity="0.6" />
          <path d="M0 630 L100 600 L200 640 L320 590 L420 630 L500 610 L500 700 L0 700 Z" fill="#2A5647" opacity="0.55" />
        </svg>

        <div className="iemv-mark">
          <div className="iemv-mark-glyph">IEMV</div>
          <div className="iemv-mark-name">
            Institut d'Enseignement<br />MÃƒÆ’Ã‚Â©dical Virunga
          </div>
        </div>

        <div className="iemv-brand-body">
          <h1>Former les soignants qui veillent sur nos communautÃƒÆ’Ã‚Â©s.</h1>
          <p>
            AccÃƒÆ’Ã‚Â©dez ÃƒÆ’Ã‚Â  votre espace ÃƒÆ’Ã‚Â©tudiant ou administratif pour suivre vos cours,
            vos rÃƒÆ’Ã‚Â©sultats et vos dÃƒÆ’Ã‚Â©marches ÃƒÆ’Ã‚Â  l'institut.
          </p>
        </div>

        <div className="iemv-brand-foot">
          Institut d'Enseignement MÃƒÆ’Ã‚Â©dical Virunga ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â espace rÃƒÆ’Ã‚Â©servÃƒÆ’Ã‚Â© au personnel et aux ÃƒÆ’Ã‚Â©tudiants
        </div>
      </div>

      {/* Form panel */}
      <div className="iemv-formside">
        <div className="iemv-formcard">
          {step === "login" ? (
            <>
              <h2>Connexion</h2>
              <p className="iemv-subtitle">Utilisez l'e-mail et le mot de passe fournis par l'institut</p>

              <form onSubmit={handleLoginSubmit} className="iemv-form" noValidate>
                <div className="iemv-field">
                  <label htmlFor="email">Adresse e-mail</label>
                  <div className="iemv-input-wrap">
                    <input
                      id="email"
                      type="email"
                      className="iemv-input"
                      placeholder="vous@iemv.edu.cd"
                      value={email}
                      onChange={(e) => setEmail(e.target.value)}
                      required
                      disabled={loading}
                      autoComplete="email"
                    />
                  </div>
                </div>

                <div className="iemv-field">
                  <label htmlFor="password">Mot de passe</label>
                  <div className="iemv-input-wrap">
                    <input
                      id="password"
                      type={showPassword ? "text" : "password"}
                      className="iemv-input"
                      data-haspad="true"
                      placeholder="Saisissez votre mot de passe"
                      value={password}
                      onChange={(e) => setPassword(e.target.value)}
                      required
                      disabled={loading}
                      autoComplete="current-password"
                    />
                    <button
                      type="button"
                      className="iemv-toggle-visibility"
                      onClick={() => setShowPassword(!showPassword)}
                      tabIndex={-1}
                      aria-label={showPassword ? "Masquer le mot de passe" : "Afficher le mot de passe"}
                    >
                      {showPassword ? <EyeOff size={16} /> : <Eye size={16} />}
                    </button>
                  </div>
                </div>

                <div className="iemv-row">
                  <label className="iemv-remember">
                    <input type="checkbox" />
                    Se souvenir de moi
                  </label>
                  <Link to="/forgot-password" className="iemv-link">
                    Mot de passe oubliÃƒÆ’Ã‚Â© ?
                  </Link>
                </div>

                <button type="submit" className="iemv-btn-primary" disabled={loading}>
                  {loading ? "ConnexionÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦" : "Se connecter"}
                </button>

                <p className="iemv-footline">
                  Un compte vous a ÃƒÆ’Ã‚Â©tÃƒÆ’Ã‚Â© crÃƒÆ’Ã‚Â©ÃƒÆ’Ã‚Â© par l'administration. Besoin d'aide ?{" "}
                  <Link to="/forgot-password" className="iemv-link">
                    RÃƒÆ’Ã‚Â©cupÃƒÆ’Ã‚Â©rer mon mot de passe
                  </Link>
                </p>
              </form>
            </>
          ) : (
            <>
              <h2>VÃƒÆ’Ã‚Â©rification</h2>
              <p className="iemv-subtitle">Un code ÃƒÆ’Ã‚Â  6 chiffres a ÃƒÆ’Ã‚Â©tÃƒÆ’Ã‚Â© envoyÃƒÆ’Ã‚Â© ÃƒÆ’Ã‚Â  {email}</p>

              <form onSubmit={handleOtpSubmit} className="iemv-form" noValidate>
                <div className="iemv-field">
                  <label htmlFor="otp">Code ÃƒÆ’Ã‚Â  usage unique</label>
                  <input
                    id="otp"
                    type="text"
                    inputMode="numeric"
                    className="iemv-input iemv-otp-input"
                    placeholder="Ãƒâ€šÃ‚Â·Ãƒâ€šÃ‚Â·Ãƒâ€šÃ‚Â·Ãƒâ€šÃ‚Â·Ãƒâ€šÃ‚Â·Ãƒâ€šÃ‚Â·"
                    value={otp}
                    onChange={(e) => setOtp(e.target.value.replace(/\D/g, "").slice(0, 6))}
                    maxLength={6}
                    required
                    disabled={loading}
                    autoFocus
                  />
                </div>

                <button type="submit" className="iemv-btn-primary" disabled={loading}>
                  {loading ? "VÃƒÆ’Ã‚Â©rificationÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦" : "VÃƒÆ’Ã‚Â©rifier et continuer"}
                </button>

                <button
                  type="button"
                  className="iemv-btn-ghost"
                  onClick={handleResendOtp}
                  disabled={loading || resendLoading}
                >
                  {resendLoading ? "Envoi en coursÃƒÂ¢Ã¢â€šÂ¬Ã‚Â¦" : "Renvoyer le code"}
                </button>

                <button
                  type="button"
                  className="iemv-btn-back"
                  onClick={() => {
                    setStep("login");
                    setOtp("");
                  }}
                  disabled={loading}
                >
                  <ArrowLeft size={14} />
                  Retour ÃƒÆ’Ã‚Â  la connexion
                </button>
              </form>

        {/* Student portal entry */}
        <div style={{ marginTop: 20, paddingTop: 18, borderTop: "1px solid #E4E8EF", textAlign: "center" }}>
          <p style={{ fontSize: 12.5, color: "#94A3B8", margin: "0 0 10px" }}>
            Vous etes un eleve ?
          </p>
          <Link
            to="/student/login"
            style={{ display: "inline-flex", alignItems: "center", justifyContent: "center", gap: 8, width: "100%", padding: "10px 16px", borderRadius: 6, border: "1px solid #0B1B3A", background: "#fff", color: "#0B1B3A", fontWeight: 600, fontSize: 13.5, textDecoration: "none" }}
          >
            Je suis un eleve
          </Link>
        </div>
            </>
          )}
        </div>
      </div>
    </div>
  );
};

export default Login;
