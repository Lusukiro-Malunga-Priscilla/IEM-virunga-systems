import React, { useState } from "react";
import { Link, useNavigate } from "react-router";
import { Eye, EyeOff, ArrowLeft } from "lucide-react";
import { useAuth } from "@/context/AuthContext";
import { useToast } from "@/hooks/use-toast";

/* ------------------------------------------------------------------ */
/*  Institut d'Enseignement MÃƒÆ’Ã‚Â©dical Virunga ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â page de connexion        */
/*  Accounts are provisioned by the admin; there is no self-service    */
/*  registration. Users log in with the credentials they were given    */
/*  and can reset their password via "Mot de passe oubliÃƒÆ’Ã‚Â©".            */
/* ------------------------------------------------------------------ */

const Login = () => {
  const [email, setEmail] = useState("");
  const [password, setPassword] = useState("");
  const [otp, setOtp] = useState("");
  const [step, setStep] = useState<"login" | "otp">("login");
  const [showPassword, setShowPassword] = useState(false);
  const [loading, setLoading] = useState(false);
  const [resendLoading, setResendLoading] = useState(false);

  const { login, verifyOtp } = useAuth();
  const navigate = useNavigate();
  const { toast } = useToast();

  const handleLoginSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (!email || !password) {
      toast({
        title: "Champs manquants",
        description: "Renseignez votre e-mail et votre mot de passe.",
        variant: "destructive",
      });
      return;
    }
    setLoading(true);
    try {
      const result = await login(email, password);
      if (result.needsOtp) {
        setStep("otp");
        setOtp("");
        toast({
          title: "Code envoyÃƒÆ’Ã‚Â©",
          description: result.message || "VÃƒÆ’Ã‚Â©rifiez votre boÃƒÆ’Ã‚Â®te e-mail.",
        });
      } else if (!result.success) {
        toast({
          title: "ÃƒÆ’Ã¢â‚¬Â°chec de la connexion",
          description: result.message || "Identifiants invalides.",
          variant: "destructive",
        });
      }
    } catch (error: unknown) {
      toast({
        title: "ÃƒÆ’Ã¢â‚¬Â°chec de la connexion",
        description: error instanceof Error ? error.message : "Identifiants invalides.",
        variant: "destructive",
      });
    } finally {
      setLoading(false);
    }
  };

  const handleOtpSubmit = async (e: React.FormEvent) => {
    e.preventDefault();
    if (otp.length !== 6) {
      toast({
        title: "Code invalide",
        description: "Saisissez le code ÃƒÆ’Ã‚Â  6 chiffres.",
        variant: "destructive",
      });
      return;
    }
    setLoading(true);
    try {
      const result = await verifyOtp(email, otp);

      if (!result.success) {
        throw new Error(result.message || "Verification failed");
      }

      // Role comes from the FRESH backend response, or falls back to
      // what AuthContext stored in localStorage.
      const returnedRole = result?.user?.role;
      const storedRaw =
        typeof window !== "undefined"
          ? localStorage.getItem("scolagest-auth-user")
          : null;
      const storedRole = storedRaw ? JSON.parse(storedRaw)?.role : undefined;
      const role = returnedRole || storedRole || "eleve";

      // Route by role ÃƒÂ¢Ã¢â€šÂ¬Ã¢â‚¬Â each role lands on its own space.
      const target =
        role === "admin" ? "/dashboard" :
        role === "enseignant" ? "/teacher" :
        role === "eleve" ? "/eleve" :
        "/";

      toast({
        title: "Content de vous revoir !",
        description: "Connexion rÃƒÆ’Ã‚Â©ussie.",
      });

      navigate(target, { replace: true });
    } catch (error: unknown) {
      toast({
        title: "ÃƒÆ’Ã¢â‚¬Â°chec de la vÃƒÆ’Ã‚Â©rification",
        description: error instanceof Error ? error.message : "Code invalide.",
        variant: "destructive",
      });
      setOtp("");
    } finally {
      setLoading(false);
    }
  };

  const handleResendOtp = async () => {
    setResendLoading(true);
    try {
      const result = await login(email, password);
      if (result.needsOtp) {
        toast({
          title: "Code renvoyÃƒÆ’Ã‚Â©",
          description: "Un nouveau code a ÃƒÆ’Ã‚Â©tÃƒÆ’Ã‚Â© envoyÃƒÆ’Ã‚Â© ÃƒÆ’Ã‚Â  votre e-mail.",
        });
        setOtp("");
      }
    } catch {
      toast({ title: "ÃƒÆ’Ã¢â‚¬Â°chec de l'envoi", variant: "destructive" });
    } finally {
      setResendLoading(false);
    }
  };

  return (
    <div className="iemv-shell">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

        .iemv-shell {
          --color-panel: #0B2545;
          --color-panel-alt: #0E3366;
          --color-bg: #F6F2E8;
          --color-text: #221F1B;
          --color-text-muted: #6B6357;
          --color-parchment-text: #F3EFE3;
          --color-parchment-muted: #A9BDB1;
          --color-accent: #C8933E;
          --color-accent-deep: #A6742A;
          --color-border: #E1D8C3;
          --color-error: #B3432B;

          min-height: 100vh;
          display: grid;
          grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
          font-family: 'IBM Plex Sans', system-ui, sans-serif;
          color: var(--color-text);
          background: var(--color-bg);
        }

        .iemv-brand {
          position: relative;
          background: var(--color-panel);
          color: var(--color-parchment-text);
          overflow: hidden;
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          padding: 48px 44px;
        }

        .iemv-ridges {
          position: absolute;
          inset: 0;
          pointer-events: none;
          opacity: 0.55;
        }

        .iemv-mark {
          display: flex;
          align-items: center;
          gap: 12px;
          position: relative;
          z-index: 1;
        }

        .iemv-mark-glyph {
          width: 38px;
          height: 38px;
          border: 1.5px solid var(--color-accent);
          display: flex;
          align-items: center;
          justify-content: center;
          font-family: 'Fraunces', serif;
          font-size: 16px;
          font-weight: 500;
          flex-shrink: 0;
        }

        .iemv-mark-name {
          font-family: 'IBM Plex Sans', sans-serif;
          font-size: 13px;
          font-weight: 500;
          letter-spacing: 0.02em;
          line-height: 1.3;
          color: var(--color-parchment-muted);
        }

        .iemv-brand-body {
          position: relative;
          z-index: 1;
          max-width: 420px;
        }

        .iemv-brand-body h1 {
          font-family: 'Fraunces', serif;
          font-weight: 500;
          font-size: clamp(28px, 3.4vw, 38px);
          line-height: 1.18;
          margin: 0 0 18px;
        }

        .iemv-brand-body p {
          font-size: 15px;
          line-height: 1.6;
          color: var(--color-parchment-muted);
          margin: 0;
        }

        .iemv-brand-foot {
          position: relative;
          z-index: 1;
          font-size: 12.5px;
          color: var(--color-parchment-muted);
          border-top: 1px solid rgba(243, 239, 227, 0.16);
          padding-top: 18px;
        }

        .iemv-formside {
          display: flex;
          align-items: center;
          justify-content: center;
          padding: 40px 24px;
        }

        .iemv-formcard {
          width: 100%;
