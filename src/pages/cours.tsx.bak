import React, { useEffect, useMemo, useState } from "react";
import {
  BookOpen,
  Search,
  Clock,
  User,
  AlertCircle,
  Loader2,
  Plus,
  CalendarClock,
  X,
  CheckCircle2,
} from "lucide-react";
import { courseApi } from "../lib/Courseapi";
import { teacherApi } from "../services/teacherApi";

/**
 * IEM Virunga — Cours
 * Même palette / même langage visuel que la page Enseignants
 * (blanc / bleu marine / noir).
 *
 * Backend attendu (voir CourseController / CourseAssignmentDTO côté backend) :
 *   GET  /api/sections
 *   GET  /api/courses                         -> toutes les attributions (cours + enseignant + section + classe + horaire)
 *   GET  /api/courses?section=X                -> attributions d'une section
 *   GET  /api/courses?classe=Y                 -> attributions d'une classe
 *   GET  /api/courses?section=X&classe=Y       -> attributions d'une section + classe
 *   POST /api/courses                          -> crée (ou réutilise) un cours + une attribution
 *
 * Chaque ligne renvoyée par le backend représente une attribution :
 * un cours donné, enseigné par un enseignant donné, dans une section et
 * une classe données, à un jour/horaire donné (voir CourseAssignment /
 * course_assignments côté base de données).
 */

const FALLBACK_SECTIONS = [
  { id: "infirmiere", nom: "Section Infirmière de la RÉFORME" },
  { id: "accoucheuse", nom: "Section Accoucheuse de la RÉFORME" },
  { id: "pharmacie", nom: "Section Assistant en pharmacie de la RÉFORME" },
  { id: "sante-mentale", nom: "Section Santé Mentale de la RÉFORME" },
  { id: "labo", nom: "Section Technique de Laboratoire de la RÉFORME" },
];

const JOURS = ["Lundi", "Mardi", "Mercredi", "Jeudi", "Vendredi"];

const EMPTY_FORM = {
  code: "",
  name: "",
  description: "",
  section: "",
  classe: "",
  teacherId: "",
  enseignant: "",
  jour: "Lundi",
  heureDebut: "",
  heureFin: "",
  volumeHoraire: "",
  coefficient: "",
};

const safe = (v) => (v == null ? "" : String(v).toLowerCase());

export default function Cours() {
  const [sections, setSections] = useState(FALLBACK_SECTIONS);
  const [sectionFilter, setSectionFilter] = useState("");
  const [classeFilter, setClasseFilter] = useState("");
  const [courses, setCourses] = useState([]);
  const [teachers, setTeachers] = useState([]);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState(null);
  const [query, setQuery] = useState("");
  const [showTimetable, setShowTimetable] = useState(false);

  const [view, setView] = useState("list"); // 'list' | 'register'
  const [form, setForm] = useState(EMPTY_FORM);
  const [submitting, setSubmitting] = useState(false);
  const [submitError, setSubmitError] = useState(null);
  const [errors, setErrors] = useState({});
  const [confirmation, setConfirmation] = useState(null);

  useEffect(() => {
    loadSections();
    loadTeachers();
  }, []);

  useEffect(() => {
    loadCourses(sectionFilter, classeFilter);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [sectionFilter, classeFilter]);

  async function loadSections() {
    try {
      const data = await courseApi.listSections();
      if (Array.isArray(data) && data.length > 0) setSections(data);
    } catch {
      // Backend pas encore branché : on garde les 5 sections connues
    }
  }

  async function loadTeachers() {
    try {
      const data = await teacherApi.list();
      setTeachers(Array.isArray(data) ? data : []);
    } catch {
      setTeachers([]);
    }
  }

  async function loadCourses(section, classe) {
    setLoading(true);
    setError(null);
    try {
      const data = await courseApi.list({ section, classe });
      setCourses(Array.isArray(data) ? data : []);
    } catch (err) {
      setError(
        err?.message || "Impossible de charger le catalogue des cours."
      );
      setCourses([]);
    } finally {
      setLoading(false);
    }
  }

  const filtered = useMemo(() => {
    const q = query.trim().toLowerCase();
    if (!q) return courses;
    return courses.filter(
      (c) =>
        safe(c?.code).includes(q) ||
        safe(c?.name).includes(q) ||
        safe(c?.description).includes(q) ||
        safe(c?.enseignant).includes(q) ||
        safe(c?.classe).includes(q)
    );
  }, [courses, query]);

  // Classes disponibles dans la section actuellement sélectionnée
  const classesDisponibles = useMemo(() => {
    const set = new Set();
    courses.forEach((c) => {
      if (c?.classe) set.add(c.classe);
    });
    return Array.from(set).sort();
  }, [courses]);

  // Emploi du temps pour la classe sélectionnée, regroupé par jour
  const timetable = useMemo(() => {
    if (!classeFilter) return {};
    const byDay = {};
    JOURS.forEach((j) => (byDay[j] = []));
    filtered
      .filter((c) => c.classe === classeFilter && c.jour)
      .forEach((c) => {
        if (!byDay[c.jour]) byDay[c.jour] = [];
        byDay[c.jour].push(c);
      });
    Object.values(byDay).forEach((list) =>
      list.sort((a, b) => (a.heureDebut || "").localeCompare(b.heureDebut || ""))
    );
    return byDay;
  }, [filtered, classeFilter]);

  function updateField(key, value) {
    setForm((f) => ({ ...f, [key]: value }));
    if (errors[key]) setErrors((e) => ({ ...e, [key]: null }));
  }

  function validate() {
    const next = {};
    if (!form.code.trim()) next.code = "Le code du cours est requis.";
    if (!form.name.trim()) next.name = "L'intitulé du cours est requis.";
    if (!form.section) next.section = "La section est requise.";
    if (!form.classe.trim()) next.classe = "La classe est requise.";
    setErrors(next);
    return Object.keys(next).length === 0;
  }

  async function handleSubmit(e) {
    e.preventDefault();
    if (!validate()) return;
    setSubmitting(true);
    setSubmitError(null);
    try {
      const payload = {
        ...form,
        volumeHoraire: form.volumeHoraire ? Number(form.volumeHoraire) : null,
        coefficient: form.coefficient ? Number(form.coefficient) : null,
        teacherId: form.teacherId ? Number(form.teacherId) : null,
      };
      const saved = await courseApi.create(payload);
      setConfirmation(saved);
      setForm(EMPTY_FORM);
      await loadCourses(sectionFilter, classeFilter);
    } catch (err) {
      setSubmitError(
        err?.message || "Impossible d'enregistrer ce cours."
      );
    } finally {
      setSubmitting(false);
    }
  }

  return (
    <div className="iem-app">
      <style>{`
        @import url('https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap');

        .iem-app {
          --white: #ffffff;
          --mist: #f4f6fa;
          --line: #e0e5ed;
          --navy: #0e2a4a;
          --navy-deep: #081a30;
          --navy-soft: #e7edf6;
          --black: #0a0a0a;
          --muted: #5b6472;
          font-family: 'IBM Plex Sans', sans-serif;
          color: var(--black);
          background: var(--white);
          min-height: 100vh;
          box-sizing: border-box;
        }
        .iem-app *, .iem-app *::before, .iem-app *::after { box-sizing: inherit; }

        .iem-topbar {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 16px;
          padding: 16px 32px;
          background: var(--navy-deep);
          color: var(--white);
          border-bottom: 1px solid var(--line);
        }
        .iem-mark {
          font-family: 'Fraunces', serif;
          font-size: 20px;
          font-weight: 600;
          line-height: 1.15;
        }
        .iem-mark span {
          display: block;
          font-size: 12px;
          font-weight: 400;
          color: #9fb2cc;
          margin-top: 2px;
        }

        .iem-main {
          flex: 1;
          padding: 40px 48px;
          max-width: 1100px;
          margin: 0 auto;
        }
        .iem-header {
          margin-bottom: 24px;
          display: flex;
          align-items: flex-end;
          justify-content: space-between;
          gap: 24px;
          flex-wrap: wrap;
        }
        .iem-title {
          font-family: 'Fraunces', serif;
          font-size: 28px;
          font-weight: 600;
          margin: 0 0 6px;
        }
        .iem-subtitle {
          color: var(--muted);
          font-size: 14px;
          margin: 0;
          max-width: 58ch;
        }
        .iem-header-actions { display: flex; gap: 10px; }

        .iem-btn-primary {
          background: var(--navy);
          color: var(--white);
          border: none;
          font-family: inherit;
          font-size: 14px;
          font-weight: 500;
          padding: 10px 18px;
          border-radius: 6px;
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          gap: 8px;
          transition: background 0.15s ease;
        }
        .iem-btn-primary:hover { background: var(--navy-deep); }
        .iem-btn-primary:disabled { opacity: 0.55; cursor: not-allowed; }

        .iem-btn-ghost {
          background: transparent;
          border: 1px solid var(--line);
          color: var(--black);
          font-family: inherit;
          font-size: 14px;
          font-weight: 500;
          padding: 10px 18px;
          border-radius: 6px;
          cursor: pointer;
          display: inline-flex;
          align-items: center;
          gap: 8px;
        }
        .iem-btn-ghost:hover { border-color: var(--navy); color: var(--navy); }
        .iem-btn-ghost.active { border-color: var(--navy); color: var(--navy); background: var(--navy-soft); }
        .iem-btn-ghost:disabled { opacity: 0.5; cursor: not-allowed; }

        /* ---------- Filters row (combo boxes) ---------- */
        .iem-filters {
          display: flex;
          flex-wrap: wrap;
          gap: 10px;
          margin-bottom: 18px;
        }
        .iem-select {
          font-family: inherit;
          font-size: 13px;
          font-weight: 500;
          color: var(--navy);
          background: var(--mist);
          border: 1px solid var(--line);
          border-radius: 999px;
          padding: 9px 14px;
          cursor: pointer;
          outline: none;
          min-width: 220px;
        }
        .iem-select:focus { border-color: var(--navy); }

        /* ---------- Search ---------- */
        .iem-search {
          display: flex;
          align-items: center;
          gap: 8px;
          border: 1px solid var(--line);
          border-radius: 6px;
          padding: 8px 12px;
          margin-bottom: 18px;
          max-width: 340px;
          background: var(--mist);
        }
        .iem-search input {
          border: none;
          background: transparent;
          outline: none;
          font-family: inherit;
          font-size: 14px;
          width: 100%;
          color: var(--black);
        }
        .iem-search svg { color: var(--muted); flex-shrink: 0; }

        /* ---------- Course table ---------- */
        .iem-table { width: 100%; border-collapse: collapse; margin-bottom: 32px; }
        .iem-table thead tr { border-bottom: 2px solid var(--navy); }
        .iem-table th {
          text-align: left;
          font-size: 12px;
          font-weight: 600;
          color: var(--navy);
          padding: 10px 14px;
          letter-spacing: 0.2px;
        }
        .iem-table td {
          padding: 14px;
          font-size: 14px;
          border-bottom: 1px solid var(--line);
          vertical-align: middle;
        }
        .iem-table tbody tr:hover { background: var(--mist); }
        .iem-code {
          display: inline-block;
          font-size: 11px;
          font-weight: 600;
          letter-spacing: 0.3px;
          color: var(--navy);
          background: var(--navy-soft);
          padding: 3px 8px;
          border-radius: 4px;
        }
        .iem-course-name { font-weight: 600; }
        .iem-course-desc { font-size: 12px; color: var(--muted); margin-top: 2px; }
        .iem-teacher { display: flex; align-items: center; gap: 6px; }
        .iem-unassigned { color: var(--muted); font-style: italic; font-size: 13px; }

        /* ---------- Timetable ---------- */
        .iem-timetable-title {
          font-family: 'Fraunces', serif;
          font-size: 19px;
          font-weight: 600;
          margin: 0 0 4px;
        }
        .iem-timetable-sub { color: var(--muted); font-size: 13px; margin: 0 0 16px; }
        .iem-timetable-grid {
          display: grid;
          grid-template-columns: repeat(${JOURS.length}, 1fr);
          gap: 10px;
          margin-bottom: 32px;
        }
        .iem-day-col {
          border: 1px solid var(--line);
          border-radius: 8px;
          overflow: hidden;
        }
        .iem-day-head {
          background: var(--navy);
          color: var(--white);
          font-size: 12px;
          font-weight: 600;
          text-align: center;
          padding: 8px;
          letter-spacing: 0.3px;
        }
        .iem-day-body { padding: 8px; display: flex; flex-direction: column; gap: 6px; min-height: 60px; }
        .iem-slot {
          background: var(--mist);
          border-radius: 6px;
          padding: 8px 10px;
          font-size: 12px;
        }
        .iem-slot-time { color: var(--muted); font-weight: 500; }
        .iem-slot-name { font-weight: 600; margin: 2px 0; }
        .iem-slot-teacher { color: var(--muted); }
        .iem-day-empty { color: var(--muted); font-size: 12px; text-align: center; padding: 10px 0; }

        .iem-empty {
          text-align: center;
          padding: 48px 0;
          color: var(--muted);
          font-size: 14px;
          display: flex;
          align-items: center;
          justify-content: center;
          gap: 8px;
        }

        .iem-confirm {
          display: flex;
          align-items: flex-start;
          gap: 10px;
          background: var(--navy-soft);
          border: 1px solid var(--navy);
          border-radius: 6px;
          padding: 14px 16px;
          margin-bottom: 22px;
          font-size: 13px;
          color: var(--navy-deep);
        }
        .iem-confirm svg { flex-shrink: 0; margin-top: 1px; color: var(--navy); }
        .iem-confirm-close { margin-left: auto; background: none; border: none; cursor: pointer; color: var(--navy); font-family: inherit; font-size: 13px; }
        .iem-confirm-warn { background: var(--mist); border-color: var(--black); color: var(--black); }
        .iem-confirm-warn svg { color: var(--black); }

        .iem-form { max-width: 620px; }
        .iem-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 20px; margin-bottom: 22px; }
        .iem-field { display: flex; flex-direction: column; gap: 6px; }
        .iem-field.full { grid-column: 1 / -1; }
        .iem-field label { font-size: 13px; font-weight: 500; color: var(--navy); }
        .iem-field input, .iem-field select, .iem-field textarea {
          font-family: inherit;
          font-size: 14px;
          padding: 10px 12px;
          border: 1px solid var(--line);
          border-radius: 6px;
          outline: none;
          background: var(--white);
          color: var(--black);
        }
        .iem-field input:focus, .iem-field select:focus, .iem-field textarea:focus { border-color: var(--navy); }
        .iem-error { font-size: 12px; color: var(--black); background: var(--mist); border-left: 2px solid var(--navy); padding: 4px 8px; }
        .iem-form-actions { display: flex; gap: 10px; }

        .iem-spin { animation: iem-spin 0.8s linear infinite; }
        @keyframes iem-spin { to { transform: rotate(360deg); } }

        @media (max-width: 900px) {
          .iem-timetable-grid { grid-template-columns: repeat(2, 1fr); }
        }
        @media (max-width: 640px) {
          .iem-main { padding: 24px 16px; }
          .iem-header { flex-direction: column; align-items: flex-start; }
          .iem-grid { grid-template-columns: 1fr; }
          .iem-timetable-grid { grid-template-columns: 1fr; }
        }
      `}</style>

      <header className="iem-topbar">
        <div className="iem-mark">
          IEM Virunga
          <span>Espace administration</span>
        </div>
      </header>

      <main className="iem-main">
        {view === "list" && (
          <>
            <div className="iem-header">
              <div>
                <h1 className="iem-title">Cours</h1>
                <p className="iem-subtitle">
                  Catalogue des cours par section et par classe, avec
                  l'enseignant assigné et son horaire. Les attributions sont
                  reliées à la page Enseignants.
                </p>
              </div>
              <div className="iem-header-actions">
                <button
                  className="iem-btn-primary"
                  onClick={() => {
                    setView("register");
                    setConfirmation(null);
                    setForm((f) => ({
                      ...f,
                      section: sectionFilter || f.section,
                      classe: classeFilter || f.classe,
                    }));
                  }}
                >
                  <Plus size={16} /> Ajouter un cours
                </button>
                <button
                  className={`iem-btn-ghost ${showTimetable ? "active" : ""}`}
                  onClick={() => setShowTimetable((v) => !v)}
                  disabled={!classeFilter}
                  title={
                    !classeFilter
                      ? "Choisissez une classe pour voir son horaire"
                      : ""
                  }
                >
                  <CalendarClock size={16} />
                  {showTimetable ? "Masquer l'horaire" : "Voir l'emploi du temps"}
                </button>
              </div>
            </div>

            <div className="iem-filters">
              <select
                className="iem-select"
                value={sectionFilter}
                onChange={(e) => {
                  setSectionFilter(e.target.value);
                  setClasseFilter("");
                  setShowTimetable(false);
                }}
              >
                <option value="">Toutes les sections</option>
                {sections.map((s) => (
                  <option key={s.id} value={s.id}>
                    {s.nom.replace("Section ", "")}
                  </option>
                ))}
              </select>

              <select
                className="iem-select"
                value={classeFilter}
                onChange={(e) => setClasseFilter(e.target.value)}
              >
                <option value="">Toutes les classes</option>
                {classesDisponibles.map((cl) => (
                  <option key={cl} value={cl}>
                    {cl}
                  </option>
                ))}
              </select>
            </div>

            <div className="iem-search">
              <Search size={16} />
              <input
                placeholder="Rechercher par code, cours, description ou enseignant"
                value={query}
                onChange={(e) => setQuery(e.target.value)}
              />
            </div>

            {error && (
              <div className="iem-confirm iem-confirm-warn">
                <AlertCircle size={18} />
                <div>{error}</div>
              </div>
            )}

            {loading ? (
              <div className="iem-empty">
                <Loader2 size={16} className="iem-spin" /> Chargement des cours...
              </div>
            ) : filtered.length === 0 ? (
              <div className="iem-empty">
                <BookOpen size={16} /> Aucun cours pour cette sélection.
              </div>
            ) : (
              <table className="iem-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Intitulé</th>
                    <th>Enseignant</th>
                    <th>Classe</th>
                    <th>Volume</th>
                    <th>Coef.</th>
                  </tr>
                </thead>
                <tbody>
                  {filtered.map((c) => (
                    <tr key={c.id || `${c.code}-${c.classe}-${c.jour}`}>
                      <td>
                        <span className="iem-code">{c.code}</span>
                      </td>
                      <td>
                        <div className="iem-course-name">{c.name}</div>
                        {c.description && (
                          <div className="iem-course-desc">{c.description}</div>
                        )}
                      </td>
                      <td>
                        {c.enseignant ? (
                          <span className="iem-teacher">
                            <User size={13} /> {c.enseignant}
                          </span>
                        ) : (
                          <span className="iem-unassigned">Non assigné</span>
                        )}
                      </td>
                      <td>{c.classe || "—"}</td>
                      <td>
                        {c.volumeHoraire ? `${c.volumeHoraire}h / semaine` : "—"}
                      </td>
                      <td>{c.coefficient ?? "—"}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            )}

            {showTimetable && classeFilter && (
              <div>
                <h2 className="iem-timetable-title">
                  Emploi du temps — {classeFilter}
                </h2>
                <p className="iem-timetable-sub">Semaine type</p>
                <div className="iem-timetable-grid">
                  {JOURS.map((jour) => (
                    <div className="iem-day-col" key={jour}>
                      <div className="iem-day-head">{jour}</div>
                      <div className="iem-day-body">
                        {(timetable[jour] || []).length === 0 ? (
                          <div className="iem-day-empty">—</div>
                        ) : (
                          timetable[jour].map((c) => (
                            <div className="iem-slot" key={`${c.id}-${jour}`}>
                              <div className="iem-slot-time">
                                <Clock size={11} style={{ verticalAlign: "-2px", marginRight: 4 }} />
                                {c.heureDebut}
                                {c.heureFin ? ` – ${c.heureFin}` : ""}
                              </div>
                              <div className="iem-slot-name">{c.name}</div>
                              {c.enseignant && (
                                <div className="iem-slot-teacher">{c.enseignant}</div>
                              )}
                            </div>
                          ))
                        )}
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </>
        )}

        {view === "register" && (
          <>
            <div className="iem-header">
              <div>
                <h1 className="iem-title">Ajouter un cours</h1>
                <p className="iem-subtitle">
                  Créez un cours et attribuez-le à une section, une classe et
                  (optionnellement) un enseignant déjà enregistré.
                </p>
              </div>
            </div>

            {confirmation && (
              <div className="iem-confirm">
                <CheckCircle2 size={18} />
                <div>
                  Cours <strong>{confirmation.name}</strong> ajouté pour la
                  classe <strong>{confirmation.classe}</strong>.
                </div>
                <button
                  className="iem-confirm-close"
                  onClick={() => setConfirmation(null)}
                >
                  <X size={16} />
                </button>
              </div>
            )}

            {submitError && (
              <div className="iem-confirm iem-confirm-warn">
                <AlertCircle size={18} />
                <div>{submitError}</div>
                <button
                  className="iem-confirm-close"
                  onClick={() => setSubmitError(null)}
                >
                  <X size={16} />
                </button>
              </div>
            )}

            <form className="iem-form" onSubmit={handleSubmit}>
              <div className="iem-grid">
                <div className="iem-field">
                  <label>Code du cours</label>
                  <input
                    value={form.code}
                    onChange={(e) => updateField("code", e.target.value)}
                    placeholder="MATH-601"
                  />
                  {errors.code && <span className="iem-error">{errors.code}</span>}
                </div>
                <div className="iem-field">
                  <label>Intitulé</label>
                  <input
                    value={form.name}
                    onChange={(e) => updateField("name", e.target.value)}
                    placeholder="Mathématiques"
                  />
                  {errors.name && <span className="iem-error">{errors.name}</span>}
                </div>

                <div className="iem-field full">
                  <label>Description</label>
                  <textarea
                    value={form.description}
                    onChange={(e) => updateField("description", e.target.value)}
                  />
                </div>

                <div className="iem-field">
                  <label>Section</label>
                  <select
                    value={form.section}
                    onChange={(e) => updateField("section", e.target.value)}
                  >
                    <option value="">Choisir une section</option>
                    {sections.map((s) => (
                      <option key={s.id} value={s.id}>
                        {s.nom.replace("Section ", "")}
                      </option>
                    ))}
                  </select>
                  {errors.section && <span className="iem-error">{errors.section}</span>}
                </div>
                <div className="iem-field">
                  <label>Classe</label>
                  <input
                    value={form.classe}
                    onChange={(e) => updateField("classe", e.target.value)}
                    placeholder="6ème A"
                  />
                  {errors.classe && <span className="iem-error">{errors.classe}</span>}
                </div>

                <div className="iem-field">
                  <label>Enseignant</label>
                  <select
                    value={form.teacherId}
                    onChange={(e) => {
                      const id = e.target.value;
                      const t = teachers.find((tt) => String(tt.id) === id);
                      updateField("teacherId", id);
                      updateField(
                        "enseignant",
                        t ? `${t.prenom} ${t.nom}` : ""
                      );
                    }}
                  >
                    <option value="">Aucun enseignant assigné</option>
                    {teachers.map((t) => (
                      <option key={t.id} value={t.id}>
                        {t.prenom} {t.nom}
                      </option>
                    ))}
                  </select>
                </div>
                <div className="iem-field">
                  <label>Jour</label>
                  <select
                    value={form.jour}
                    onChange={(e) => updateField("jour", e.target.value)}
                  >
                    {JOURS.map((j) => (
                      <option key={j} value={j}>
                        {j}
                      </option>
                    ))}
                  </select>
                </div>

                <div className="iem-field">
                  <label>Heure de début</label>
                  <input
                    type="time"
                    value={form.heureDebut}
                    onChange={(e) => updateField("heureDebut", e.target.value)}
                  />
                </div>
                <div className="iem-field">
                  <label>Heure de fin</label>
                  <input
                    type="time"
                    value={form.heureFin}
                    onChange={(e) => updateField("heureFin", e.target.value)}
                  />
                </div>

                <div className="iem-field">
                  <label>Volume horaire (h / semaine)</label>
                  <input
                    type="number"
                    min="0"
                    value={form.volumeHoraire}
                    onChange={(e) => updateField("volumeHoraire", e.target.value)}
                  />
                </div>
                <div className="iem-field">
                  <label>Coefficient</label>
                  <input
                    type="number"
                    min="0"
                    value={form.coefficient}
                    onChange={(e) => updateField("coefficient", e.target.value)}
                  />
                </div>
              </div>

              <div className="iem-form-actions">
                <button type="submit" className="iem-btn-primary" disabled={submitting}>
                  {submitting ? "Enregistrement..." : "Enregistrer le cours"}
                </button>
                <button
                  type="button"
                  className="iem-btn-ghost"
                  onClick={() => setView("list")}
                >
                  Annuler
                </button>
              </div>
            </form>
          </>
        )}
      </main>
    </div>
  );
}