  { label: 'Enseignants',      value: '46',         hint: '8 vacataires',           icon: GraduationCap },
  { label: 'Frais encaissés',  value: '128 400 $',  hint: '72 % du prévisionnel',   icon: CreditCard    },
  { label: 'Moyenne générale', value: '13,2 / 20',  hint: '+0,6 vs trimestre passé', icon: TrendingUp   },
];

const timeline = [
  { month: 'Sep', moyenne: 12.1, presence: 96 },
  { month: 'Oct', moyenne: 12.4, presence: 95 },
