  card:      '#FFFFFF',
  border:    '#E8EAF0',
  text:      '#0F172A',
  muted:     '#64748B',
  faint:     '#94A3B8',
  green:     '#10B981',
  amber:     '#F59E0B',
  shadow:    '0 1px 3px rgba(15,23,42,0.04), 0 8px 24px rgba(15,23,42,0.04)',
};

