export default function Dashboard() {
  const { user } = useAuth();

  const initials = useMemo(() => {
    const n = user?.name?.trim();
    if (!n) return 'DG';
    const p = n.split(/\s+/);
    return ((p[0]?.[0] || '') + (p[1]?.[0] || '')).toUpperCase() || 'DG';
  }, [user?.name]);

  const displayName = user?.name || 'Direction générale';

  const cardBase: React.CSSProperties = {
    background: T.card,
    border: `1px solid ${T.border}`,
    borderRadius: 18,
    boxShadow: T.shadow,
  };

  const chipStyle: React.CSSProperties = {
    width: 42, height: 42, borderRadius: 12,
    background: '#EFF3FB',
    display: 'flex', alignItems: 'center', justifyContent: 'center',
    flexShrink: 0,
  };

  return (
    <>
      <style>{CSS}</style>

      <div
        className="iemv-dash"
        style={{ flex: 1, minWidth: 0, background: T.page, minHeight: '100vh' }}
      >
        {/* ── Top bar ─────────────────────────────────────── */}
        <div
          className="iemv-topbar"
          style={{
            display: 'flex', alignItems: 'center', gap: 16,
            padding: '18px 32px',
            background: T.card,
            borderBottom: `1px solid ${T.border}`,
          }}
        >
          <div style={{ position: 'relative', flex: 1, maxWidth: 680 }}>
            <Search
              size={18}
              style={{
                position: 'absolute', left: 16, top: '50%',
                transform: 'translateY(-50%)', color: T.faint,
              }}
            />
            <input
              className="iemv-search"
              placeholder="Rechercher un élève, un cours, un paiement…"
              style={{
                width: '100%', height: 48,
                padding: '0 16px 0 46px',
                borderRadius: 12,
                border: `1px solid ${T.border}`,
                background: '#FBFCFE',
                fontSize: 14, color: T.text,
                fontFamily: 'inherit',
                transition: 'border-color .15s ease, box-shadow .15s ease',
              }}
            />
          </div>

          <button className="iemv-iconbtn" title="Notifications">
            <Bell size={19} />
            <span
              style={{
                position: 'absolute', top: 10, right: 11,
                width: 8, height: 8, borderRadius: '50%',
                background: '#EF4444',
                border: `2px solid ${T.card}`,
              }}
            />
          </button>

          <div
            style={{
              display: 'flex', alignItems: 'center', gap: 12,
              padding: '8px 18px 8px 8px',
              background: T.card,
              border: `1px solid ${T.border}`,
              borderRadius: 14,
              flexShrink: 0,
            }}
          >
            <div
              style={{
                width: 40, height: 40, borderRadius: 10,
                background: T.navy, color: '#fff',
                display: 'flex', alignItems: 'center', justifyContent: 'center',
                fontSize: 14, fontWeight: 700,
              }}
            >
              {initials}
            </div>
            <div style={{ lineHeight: 1.3 }}>
              <div style={{ fontSize: 14, fontWeight: 700, color: T.text }}>
                {displayName}
              </div>
              <div style={{ fontSize: 12.5, color: T.muted }}>
                Année scolaire 2026 — 2027
              </div>
            </div>
          </div>
        </div>

        {/* ── Content ─────────────────────────────────────── */}
        <div style={{ padding: 32, maxWidth: 1400 }}>
          {/* Title row */}
          <div
            style={{
              display: 'flex', alignItems: 'flex-start',
              justifyContent: 'space-between', gap: 20,
              flexWrap: 'wrap', marginBottom: 28,
            }}
          >
            <div>
              <h1
                style={{
                  margin: 0, fontSize: 34, fontWeight: 800,
                  color: T.text, letterSpacing: '-0.02em',
                }}
              >
                Tableau de bord
              </h1>
              <p style={{ margin: '8px 0 0', fontSize: 15, color: T.muted }}>
                Synthèse de l'établissement pour l'année scolaire 2026 — 2027.
              </p>
            </div>

            <button className="iemv-btn">
              <FileBarChart size={17} strokeWidth={2} />
              Générer un rapport
            </button>
          </div>

          {/* KPI grid */}
          <div className="iemv-grid-kpi" style={{ marginBottom: 20 }}>
            {/* Hero card */}
            <div
              className="iemv-card"
              style={{
                background: T.navyGrad,
                borderRadius: 18,
                padding: 28,
                color: '#fff',
                minHeight: 218,
                display: 'flex',
                flexDirection: 'column',
                justifyContent: 'space-between',
              }}
            >
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                <span
                  style={{
                    fontSize: 12.5, fontWeight: 700,
                    letterSpacing: '0.09em', textTransform: 'uppercase',
                    color: 'rgba(255,255,255,0.72)',
                  }}
                >
                  Élèves inscrits
                </span>
                <div
                  style={{
                    width: 42, height: 42, borderRadius: 12,
                    background: 'rgba(255,255,255,0.10)',
                    display: 'flex', alignItems: 'center', justifyContent: 'center',
                  }}
                >
                  <Users size={20} strokeWidth={2} />
                </div>
              </div>

              <div>
                <div style={{ fontSize: 52, fontWeight: 800, letterSpacing: '-0.03em', lineHeight: 1 }}>
                  842
                </div>
                <div style={{ fontSize: 14, color: 'rgba(255,255,255,0.65)', marginTop: 12 }}>
                  +38 cette rentrée
                </div>
              </div>
            </div>

            {/* Three white KPI cards */}
            {kpis.map(kpi => (
              <div
                key={kpi.label}
                className="iemv-card"
                style={{
                  ...cardBase,
                  padding: 28,
                  minHeight: 218,
                  display: 'flex',
                  flexDirection: 'column',
                  justifyContent: 'space-between',
                }}
              >
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start' }}>
                  <span
                    style={{
                      fontSize: 12.5, fontWeight: 700,
                      letterSpacing: '0.09em', textTransform: 'uppercase',
                      color: T.muted,
                    }}
                  >
                    {kpi.label}
                  </span>
                  <div style={chipStyle}>
                    <kpi.icon size={20} strokeWidth={2} style={{ color: T.navy }} />
                  </div>
                </div>

                <div>
                  <div
                    style={{
                      fontSize: 44, fontWeight: 800,
                      letterSpacing: '-0.03em', lineHeight: 1, color: T.text,
                    }}
                  >
                    {kpi.value}
                  </div>
                  <div style={{ fontSize: 14, color: T.muted, marginTop: 12 }}>
                    {kpi.hint}
                  </div>
                </div>
              </div>
            ))}
          </div>

          {/* Charts */}
          <div className="iemv-grid-charts">
            {/* Évolution des moyennes */}
            <div className="iemv-card" style={{ ...cardBase, padding: 26 }}>
              <h3 style={{ margin: 0, fontSize: 19, fontWeight: 700, color: T.text, letterSpacing: '-0.01em' }}>
                Évolution des moyennes
              </h3>
              <p style={{ margin: '6px 0 0', fontSize: 14, color: T.muted }}>
                Moyenne générale et taux de présence
              </p>

              <div style={{ marginTop: 24 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 6 }}>
                  <span style={{ fontSize: 13, fontWeight: 600, color: T.muted }}>Moyenne générale</span>
                  <span style={{ fontSize: 15, fontWeight: 700, color: T.text }}>13,2 / 20</span>
                </div>
                <Sparkline values={timeline.map(t => t.moyenne)} min={11} max={14} color={T.brand} />
              </div>

              <div style={{ marginTop: 22 }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'baseline', marginBottom: 6 }}>
                  <span style={{ fontSize: 13, fontWeight: 600, color: T.muted }}>Taux de présence</span>
                  <span style={{ fontSize: 15, fontWeight: 700, color: T.text }}>94,1 %</span>
                </div>
                <Sparkline values={timeline.map(t => t.presence)} min={88} max={98} color={T.green} />
              </div>

              <div
                style={{
                  display: 'flex', justifyContent: 'space-between',
                  marginTop: 14, paddingTop: 14,
                  borderTop: `1px solid ${T.border}`,
                }}
              >
                {timeline.map(t => (
                  <span key={t.month} style={{ fontSize: 12, color: T.faint }}>{t.month}</span>
                ))}
              </div>
            </div>

            {/* Réussite par classe */}
            <div className="iemv-card" style={{ ...cardBase, padding: 26 }}>
              <h3 style={{ margin: 0, fontSize: 19, fontWeight: 700, color: T.text, letterSpacing: '-0.01em' }}>
                Réussite par classe
              </h3>
              <p style={{ margin: '6px 0 0', fontSize: 14, color: T.muted }}>
                Pourcentage d'élèves au-dessus de la moyenne
              </p>

              <div style={{ marginTop: 24, display: 'flex', flexDirection: 'column', gap: 16 }}>
                {parClasse.map(c => (
                  <div key={c.classe}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: 7 }}>
                      <span style={{ fontSize: 13, fontWeight: 600, color: T.text }}>{c.classe}</span>
                      <span style={{ fontSize: 13, fontWeight: 700, color: T.text }}>{c.taux} %</span>
                    </div>
                    <div style={{ height: 8, borderRadius: 99, background: '#EEF1F6', overflow: 'hidden' }}>
                      <div
                        style={{
                          height: '100%', width: `${c.taux}%`, borderRadius: 99,
                          background: c.taux >= 80 ? T.green : c.taux >= 70 ? T.brand : T.amber,
                          transition: 'width .5s ease',
                        }}
                      />
                    </div>
                  </div>
                ))}
              </div>

              <div
                style={{
                  display: 'flex', gap: 18,
                  marginTop: 22, paddingTop: 14,
                  borderTop: `1px solid ${T.border}`,
                }}
              >
                {[
                  { c: T.green, l: '≥ 80 %' },
                  { c: T.brand, l: '70 – 79 %' },
                  { c: T.amber, l: '< 70 %' },
                ].map(x => (
                  <span key={x.l} style={{ display: 'flex', alignItems: 'center', gap: 7, fontSize: 12, color: T.muted }}>
                    <span style={{ width: 8, height: 8, borderRadius: '50%', background: x.c }} />
                    {x.l}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </>
  );
}