import React, { useMemo, useState } from 'react';
import { attendanceApi } from '../lib/attendanceApi';
import { ClassAttendanceEntry, SCHOOL_START_TIME, StudentRosterItem } from '../types/attendance';

interface Props {
  teacherUsername: string;
  course: string;
  /** ADAPT ME: fetch this from your own students/roster endpoint for this course
   *  and pass it in â€” this component doesn't assume a particular student API. */
  roster: StudentRosterItem[];
}

type LocalMark = { present: boolean; late: boolean; justification: string };

function isNowAfterSchoolStart(): boolean {
  const now = new Date();
  const [h, m] = SCHOOL_START_TIME.split(':').map(Number);
  return now.getHours() > h || (now.getHours() === h && now.getMinutes() > m);
}

export default function TeacherStudentAttendance({ teacherUsername, course, roster }: Props) {
  const [marks, setMarks] = useState<Record<number, LocalMark>>({});
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState<string | null>(null);
  const [savedOk, setSavedOk] = useState(false);
  const lateByDefault = useMemo(() => isNowAfterSchoolStart(), []);

  function toggle(studentId: number) {
    setSavedOk(false);
    setMarks((prev) => {
      const current = prev[studentId];
      if (!current || !current.present) {
        // click -> mark present (box turns green), auto-flag late if past 07:30
        return { ...prev, [studentId]: { present: true, late: lateByDefault, justification: current?.justification || '' } };
      }
      // click again -> unmark (back to grey / not present)
      return { ...prev, [studentId]: { present: false, late: false, justification: current.justification || '' } };
    });
  }

  function setJustification(studentId: number, text: string) {
    setMarks((prev) => ({
      ...prev,
      [studentId]: { present: prev[studentId]?.present ?? true, late: prev[studentId]?.late ?? false, justification: text },
    }));
  }

  async function save() {
    setSaving(true);
    setError(null);
    setSavedOk(false);
    try {
      const entries: ClassAttendanceEntry[] = roster.map((s) => {
        const m = marks[s.id];
        return {
          studentUserAccountId: s.id,
          present: !!m?.present,
          late: !!m?.late,
          justification: m?.justification || '',
        };
      });

      await attendanceApi.classCheckIn({
        teacherUsername,
        course,
        entries,
      });
      setSavedOk(true);
    } catch (e: any) {
      setError(e.message || "Ã‰chec de l'enregistrement");
    } finally {
      setSaving(false);
    }
  }

  return (
    <div>
      <h2 style={{ fontSize: 18, marginBottom: 4 }}>PrÃ©sence des Ã©lÃ¨ves â€” {course}</h2>
      <p style={{ color: '#64748b', marginBottom: 12 }}>
        Cliquez sur un Ã©lÃ¨ve pour le marquer prÃ©sent (la case devient verte). DÃ©but des cours : 07h30 â€”
        un Ã©lÃ¨ve pointÃ© aprÃ¨s cette heure est automatiquement marquÃ© "en retard" et doit fournir une justification.
      </p>

      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(180px, 1fr))', gap: 10, marginBottom: 16 }}>
        {roster.map((student) => {
          const mark = marks[student.id];
          const present = !!mark?.present;
          const late = !!mark?.late;
          const bg = !present ? '#e2e8f0' : late ? '#f59e0b' : '#22c55e';
          const color = !present ? '#334155' : '#fff';

          return (
            <div key={student.id} style={{ border: '1px solid #e2e8f0', borderRadius: 8, padding: 10 }}>
              <button
                onClick={() => toggle(student.id)}
                style={{
                  width: '100%', background: bg, color, border: 'none', borderRadius: 6,
                  padding: '12px 8px', cursor: 'pointer', fontWeight: 600, textAlign: 'left',
                }}
              >
                {student.fullName}
                <div style={{ fontSize: 11, fontWeight: 400, marginTop: 4 }}>
                  {!present ? 'Non pointÃ©' : late ? 'PrÃ©sent â€” en retard' : 'PrÃ©sent'}
                </div>
              </button>

              {present && late && (
                <textarea
                  placeholder="Justification du retard (obligatoire)"
                  value={mark?.justification || ''}
                  onChange={(e) => setJustification(student.id, e.target.value)}
                  style={{ width: '100%', marginTop: 8, padding: 6, fontSize: 12, border: '1px solid #e2e8f0', borderRadius: 6 }}
                  rows={2}
                />
              )}
            </div>
          );
        })}
      </div>

      {error && <p style={{ color: '#ef4444' }}>{error}</p>}
      {savedOk && <p style={{ color: '#16a34a' }}>PrÃ©sence enregistrÃ©e. Les Ã©lÃ¨ves ont Ã©tÃ© notifiÃ©s par email et SMS.</p>}

      <button
        onClick={save}
        disabled={saving || roster.length === 0}
        style={{
          background: '#2563eb', color: '#fff', border: 'none', borderRadius: 6,
          padding: '10px 18px', cursor: 'pointer', fontWeight: 600,
        }}
      >
        {saving ? 'Enregistrementâ€¦' : 'Enregistrer la prÃ©sence de la classe'}
      </button>
    </div>
  );
}