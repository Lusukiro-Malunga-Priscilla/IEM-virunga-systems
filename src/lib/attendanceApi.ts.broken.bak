// src/lib/attendanceApi.ts
import {
  Attendance,
  ClassAttendanceCheckInRequest,
  DailyAttendanceBox,
  AttendeeType,
} from '../types/attendance';

const API_BASE = '/api/attendance';
const TOKEN_KEYS = ['scolagest-auth-token', 'token', 'access_token', 'accessToken', 'jwt'] as const;

function getToken(): string | null {
  try {
    for (const k of TOKEN_KEYS) {
      const v = localStorage.getItem(k) ?? sessionStorage.getItem(k);
      if (v) return v;
    }
  } catch {}
  return null;
}

function authHeaders(extra: Record<string, string> = {}): Record<string, string> {
  const token = getToken();
  return {
    Accept: 'application/json',
    ...(token ? { Authorization: `Bearer ${token}` } : {}),
    ...extra,
  };
}

async function handle<T>(res: Response): Promise<T> {
  if (res.status === 401 || res.status === 403) {
    try {
      localStorage.removeItem('scolagest-auth-token');
      localStorage.removeItem('scolagest-auth-user');
    } catch {}
    if (!window.location.pathname.startsWith('/login')) {
      window.location.href = '/login';
    }
    throw new Error('Session expiree. Veuillez vous reconnecter.');
  }
  if (!res.ok) {
    const text = await res.text().catch(() => '');
    throw new Error(`API error ${res.status}: ${text || res.statusText}`);
  }
  if (res.status === 204) return null as unknown as T;
  return res.json() as Promise<T>;
}

async function request<T>(path: string, init: RequestInit = {}): Promise<T> {
  const res = await fetch(`${API_BASE}${path}`, {
    credentials: 'include',
    ...init,
    headers: {
      ...authHeaders(),
      ...((init.headers as Record<string, string>) || {}),
    },
  });

  if (res.status === 404) {
    console.info(`[attendanceApi] ${path} not implemented yet, returning empty`);
    return (Array.isArray([]) ? [] : null) as T;
  }

  return handle<T>(res);
}

export const attendanceApi = {
  getAll(): Promise<Attendance[]> {
    return request<Attendance[]>('');
  },

  getByUser(userAccountId: number): Promise<Attendance[]> {
    return request<Attendance[]>(`/user/${userAccountId}`);
  },

  classCheckIn(payload: ClassAttendanceCheckInRequest): Promise<Attendance[]> {
    return request<Attendance[]>('/class-check-in', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
  },

  teacherCheckIn(username: string): Promise<Attendance> {
    return request<Attendance>(`/teacher-check-in?username=${encodeURIComponent(username)}`, {
      method: 'POST',
    });
  },

  getDailyBoard(date: string, course?: string, attendeeType?: AttendeeType): Promise<DailyAttendanceBox[]> {
    const params = new URLSearchParams({ date });
    if (course) params.set('course', course);
    if (attendeeType) params.set('attendeeType', attendeeType);
    return request<DailyAttendanceBox[]>(`/daily-board?${params.toString()}`);
  },

  getBoardByClass(date: string, attendeeType?: AttendeeType): Promise<any> {
    const params = new URLSearchParams({ date });
    if (attendeeType) params.set('attendeeType', attendeeType);
    return request<any>(`/board-by-class?${params.toString()}`);
  },

  checkOut(id: number): Promise<Attendance> {
    return request<Attendance>(`/${id}/check-out`, { method: 'PUT' });
  },
};