// src/types/announcement.ts

export type Audience = 'ALL' | 'STAFF' | 'TEACHERS' | 'STUDENTS';

/** Labels shown in dropdowns / cards. Keys match the AUDIENCE_COLOR map
 *  already used in Adminannouncementspage.tsx. */
export const AUDIENCE_LABEL: Record<Audience, string> = {
  ALL:      'Tout le monde',
  STAFF:    'Administration',
  TEACHERS: 'Enseignants',
  STUDENTS: 'Élèves',
};

/** Short helper text shown under the audience picker in AnnouncementComposer. */
export const AUDIENCE_HINT: Record<Audience, string> = {
  ALL:      'Visible par tous les utilisateurs de la plateforme.',
  STAFF:    'Visible uniquement par le personnel administratif.',
  TEACHERS: 'Visible uniquement par les enseignants.',
  STUDENTS: 'Visible uniquement par les élèves.',
};

/** Shape returned by the backend. */
export interface Announcement {
  id: number;
  title: string;
  body: string;
  audience: Audience;
  authorName?: string;
  createdAt: string;   // ISO string from backend
  updatedAt?: string;
}

/** Payload used when creating or editing. No id, no timestamps. */
export interface AnnouncementDraft {
  title: string;
  body: string;
  audience: Audience;
}