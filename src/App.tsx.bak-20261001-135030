// src/App.tsx
import React, { Suspense } from "react";
import { BrowserRouter as Router, Routes, Route, Navigate, Outlet } from "react-router";
import { AuthProvider } from "@/context/AuthContext";
import ProtectedRoute from "@/components/ProtectedRoute";
import RequireRole from "@/components/RequireRole";
import Sidebar from "@/components/Sidebar";
import SidebarLayout from "@/components/SidebarLayout";

import Homepage from "@/pages/Homepage";
import Dashboard from "@/pages/Dashboard";
import Login from "@/pages/login";
import ForgotPassword from "@/pages/forgot-password";
import ResetPassword from "@/pages/reset-password";
import VerifyOtp from "@/pages/verify-otp";

import TeacherDashboard from "@/pages/teacher/TeacherDashboard";
import TeacherProfilePage from "@/pages/teacher/TeacherProfilePage";
import StudentDashboard from "@/pages/student/StudentDashboard";

const Eleves      = React.lazy(() => import("@/pages/eleves"));
const Enseignants = React.lazy(() => import("@/pages/enseignants"));
import StudentCourses from "@/pages/student/StudentCourses";
import StudentAttendance from "@/pages/student/StudentAttendance";
import StudentGrades from "@/pages/student/StudentGrades";
import StudentExams from "@/pages/student/StudentExams";
import StudentTimetable from "@/pages/student/StudentTimetable";
import StudentPayments from "@/pages/student/StudentPayments";
import StudentReports from "@/pages/student/StudentReports";
const Cours       = React.lazy(() => import("@/pages/cours"));
const Presences   = React.lazy(() => import("@/pages/presences"));
const Notes       = React.lazy(() => import("@/pages/notes"));
const Examens     = React.lazy(() => import("@/pages/examens"));
const Paiements   = React.lazy(() => import("@/pages/paiements"));
const Sections    = React.lazy(() => import("@/pages/sections"));

const AdminAnnouncements   = React.lazy(() => import("@/pages/Adminannouncementspage"));
const TeacherAttendance    = React.lazy(() => import("@/pages/teacher/Teacherattendance"));
const TeacherScores     = React.lazy(() => import("@/pages/teacher/Teacherscores"));
const TeacherExamsPage  = React.lazy(() => import("@/pages/teacher/TeacherExamsPage"));
const TeacherReports    = React.lazy(() => import("@/pages/teacher/TeacherReports"));
const ReportsAdmin      = React.lazy(() => import("@/pages/Reports"));
const TeacherExamCreate = React.lazy(() => import("@/pages/teacher/TeacherExamCreate"));
const TeacherExamMarks  = React.lazy(() => import("@/pages/teacher/TeacherExamMarks"));
const AdminExamsPage    = React.lazy(() => import("@/pages/AdminExamsPage"));
const AdminResultsPage  = React.lazy(() => import("@/pages/AdminResultsPage"));
const PerformancesPage = React.lazy(() => import("@/pages/Performances"));
const StudentRegister = React.lazy(() => import("@/pages/student/StudentRegister"));
const StudentLogin    = React.lazy(() => import("@/pages/student/StudentLogin"));
const StudentReset    = React.lazy(() => import("@/pages/student/StudentReset"));
const LibraryPage      = React.lazy(() => import("@/pages/Library"));
const StudentAnnouncements = React.lazy(() => import("@/pages/student/Studentannouncementspage"));
const TeacherAnnouncements = React.lazy(() => import("@/pages/teacher/Teacherannouncementspage"));

const Placeholder = ({ title }: { title: string }) => (
  <div style={{ padding: 40 }}>
    <h1 style={{ fontSize: 24, fontWeight: 700, color: "#0B1B3A", marginBottom: 8 }}>
      {title}
    </h1>
    <p style={{ color: "#6B6357" }}>Cette page n'est pas encore implementee.</p>
  </div>
);

const Loading = () => (
  <div style={{ padding: 40, textAlign: "center", color: "#6B6357" }}>
    Chargement...
  </div>
);

const lazy = (el: React.ReactNode) => (
  <Suspense fallback={<Loading />}>{el}</Suspense>
);

export default function App() {
  return (
    <AuthProvider>
      <Router>
        <Routes>
          {/* Public */}
          <Route path="/" element={<Homepage />} />
          <Route path="/login" element={<Login />} />
          <Route path="/forgot-password" element={<ForgotPassword />} />
          <Route path="/reset-password" element={<ResetPassword />} />
          <Route path="/verify-otp" element={<VerifyOtp />} />

          {/* Teacher */}
          <Route
            path="/teacher"
            element={
              <RequireRole role="enseignant">
                <SidebarLayout />
              </RequireRole>
            }
          >
            <Route index element={<TeacherDashboard />} />
            <Route path="profile"    element={<TeacherProfilePage />} />
            <Route path="classes"    element={<Placeholder title="Mes classes" />} />
            <Route path="students"   element={<Placeholder title="Eleves" />} />
            <Route path="attendance" element={lazy(<TeacherAttendance />)} />
            <Route path="courses"    element={<Placeholder title="Cours" />} />
            <Route path="grades"     element={lazy(<TeacherScores />)} />
            <Route path="exams"            element={lazy(<TeacherExamsPage />)} />
            <Route path="exams/create"     element={lazy(<TeacherExamCreate />)} />
            <Route path="exams/submitted"  element={lazy(<TeacherExamsPage filter="SUBMITTED" />)} />
            <Route path="exams/published"  element={lazy(<TeacherExamsPage filter="PUBLISHED" />)} />
            <Route path="exams/marks"      element={lazy(<TeacherExamMarks />)} />
            <Route path="reports"          element={lazy(<TeacherReports />)} />
          </Route>

          {/* Student */}
          <Route
            path="/eleve"
            element={
              <RequireRole role="eleve">
                <Outlet />
              </RequireRole>
            }
          >
            <Route index element={<StudentDashboard />} />
            <Route path="courses"       element={<StudentCourses />} />
            <Route path="timetable"     element={<StudentTimetable />} />
            <Route path="grades"       element={<StudentGrades />} />
            <Route path="attendance"   element={<StudentAttendance />} />
            <Route path="exams"        element={<StudentExams />} />
            <Route path="announcements" element={lazy(<StudentAnnouncements />)} />
            <Route path="library"        element={lazy(<LibraryPage />)} />
            <Route path="reports"      element={<StudentReports />} />
            <Route path="profile"      element={<StudentProfile />} />
            <Route path="payments"      element={<StudentPayments />} />
          </Route>

          {/* Admin */}
          <Route element={<ProtectedRoute />}>
            <Route element={<SidebarLayout />}>
              <Route path="/dashboard"     element={<Dashboard />} />
              <Route path="/performances"  element={lazy(<PerformancesPage />)} />
              <Route path="/reports"       element={lazy(<ReportsAdmin />)} />

              <Route path="/eleves"      element={lazy(<Eleves />)} />
              <Route path="/enseignants" element={lazy(<Enseignants />)} />
              <Route path="/cours"       element={lazy(<Cours />)} />
              <Route path="/presences"   element={lazy(<Presences />)} />
              <Route path="/notes"       element={lazy(<Notes />)} />
              <Route path="/examens"     element={lazy(<Examens />)} />
              <Route path="/certificates"  element={<Placeholder title="Certificats" />} />
              <Route path="/paiements"     element={lazy(<Paiements />)} />
              <Route path="/announcements" element={lazy(<AdminAnnouncements />)} />
              <Route path="/library"        element={lazy(<LibraryPage />)} />
              <Route path="/settings"      element={<Placeholder title="Parametres" />} />
              <Route path="/sections"      element={lazy(<Sections />)} />

              <Route path="/attendance" element={<Navigate to="/presences" replace />} />
            </Route>
          </Route>

          <Route path="*" element={<Homepage />} />
                      {/* Student self-service auth */}
              <Route path="/student/register" element={lazy(<StudentRegister />)} />
              <Route path="/student/login"    element={lazy(<StudentLogin />)} />
              <Route path="/student/reset"    element={lazy(<StudentReset />)} />
            </Routes>
      </Router>
    </AuthProvider>
  );
}
